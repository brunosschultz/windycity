---
import { Picture } from 'astro:assets';
import noturna from '../assets/images/fachada-04-noturna.png';
import { waHref } from '../config';
---

<!--
  Abertura em duas partes que compartilham o mesmo palco fixo:
  1. tela dividida — texto à esquerda, fachada noturna à direita
  2. ao rolar, a imagem abre até a largura total e entra o título da Localização
  O progresso do scroll vira a custom property --p (0→1), lida só por
  clip-path / opacity / transform — nada que dispare layout.
-->
<section class="stage" id="hero" data-stage>
  <div class="pin" data-pin>
    <!-- Camada de imagem: sempre 100vw, revelada por clip-path -->
    <div class="stage-media">
      <!-- Wrapper só para o deslocamento horizontal: mantém o transform da
           imagem (animação de entrada) separado do transform de posição. -->
      <div class="stage-shift">
        <Picture
          src={noturna}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[760, 1100, 1500, 1920]}
          sizes="100vw"
          alt="Fachada do WindyCity à noite, com os apartamentos iluminados e a rua em primeiro plano"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
      <span class="stage-veil" aria-hidden="true"></span>

      <!-- Título da Localização: entra sobre a imagem no fim da abertura -->
      <h2 class="stage-next h2-xl" id="loc-t">
        Viva a cidade com mais <em class="ac">autonomia</em>
      </h2>
    </div>

    <!-- Coluna de texto (metade esquerda) -->
    <div class="stage-copy">
      <div class="wrap stage-copy-in">
        <p class="eyebrow">Um empreendimento Girassol</p>

        <h1 class="hero-h1">
          <span class="line"><span>O diferencial que nenhum outro Studio de Curitiba entrega:</span></span>
          <span class="line"><span><em class="ac">luz</em> natural em cada cômodo.</span></span>
        </h1>

        <p class="lede hero-lede">
          Enquanto o mercado aperta a planta para caber mais unidades, o WindyCity foi desenhado para
          valorizar cada metro — e cada aluguel. Um projeto difícil de copiar, em uma das regiões
          mais procuradas por quem investe em Studios na cidade.
        </p>

        <div class="hero-cta">
          <a class="btn" href={waHref()}>
            <span>Falar no WhatsApp</span>
            <svg class="arw" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M2 8h11m0 0L9 4m4 4l-4 4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Fio de rodapé -->
    <div class="stage-meta" aria-hidden="true">
      <div class="wrap stage-meta-in">
        <span class="label">Curitiba · PR</span>
        <span class="label stage-meta-mid">Studios &amp; Gardens</span>
        <span class="label">Girassol Incorporações</span>
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    /* altura extra = distância de scroll da animação */
    height: 235vh;
    position: relative;
    background: var(--preto);
    color: var(--bege);
    --split: 50%;
    --p: 0;
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---- imagem ---- */
  .stage-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* abre da metade direita até a largura total conforme --p */
    clip-path: inset(0 0 0 calc(var(--split) * (1 - var(--p))));
  }
  /*
    A imagem tem 100vw, com o prédio no centro dos 1920. Quando o clip mostra
    só a metade direita, esse centro cai justamente na borda esquerda da
    janela visível. Empurrando a imagem para a direita por metade da faixa
    escondida, o centro dela volta a coincidir com o centro do que se vê.

      deslocamento = (faixa escondida) / 2 = --split * (1 - --p) / 2

    Em --p = 0 → 25vw (prédio centrado na metade direita)
    Em --p = 1 → 0    (imagem inteira, posição natural)
  */
  .stage-shift {
    position: absolute;
    inset: 0;
    transform: translate3d(calc(var(--split) * (1 - var(--p)) * 0.5), 0, 0);
  }
  .stage-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
    animation: mediaIn 1.5s var(--ease-out) both;
  }
  @keyframes mediaIn {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* véu que escurece a imagem só quando ela toma a tela toda */
  .stage-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(1, 8, 17, 0.82) 0%,
      rgba(1, 8, 17, 0.42) 46%,
      rgba(1, 8, 17, 0.22) 100%
    );
    opacity: calc(var(--p) * 1.15);
  }

  /* ---- título que entra sobre a imagem ---- */
  .stage-next {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: clamp(84px, 15vh, 170px);
    padding-inline: var(--gutter);
    max-width: calc(var(--maxw) + var(--gutter) * 2);
    margin-inline: auto;
    color: var(--bege);
    opacity: calc((var(--p) - 0.55) * 3.4);
    transform: translate3d(0, calc((1 - var(--p)) * 34px), 0);
    pointer-events: none;
  }

  /* ---- coluna de texto ---- */
  .stage-copy {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    /* sai de cena antes de a imagem terminar de abrir */
    opacity: calc(1 - var(--p) * 2.1);
    transform: translate3d(calc(var(--p) * -46px), 0, 0);
    pointer-events: none;
  }
  .stage-copy-in {
    pointer-events: auto;
    width: 100%;
  }
  .stage-copy-in > * {
    max-width: calc(var(--split) - 3vw);
  }
  /* o palco não tem classe de tema: o verde institucional não atinge
     contraste sobre a fachada noturna, então o rótulo vai em bege */
  .stage-copy-in .eyebrow {
    color: var(--bege);
  }
  .stage-copy-in .eyebrow::before {
    background: var(--verde);
  }

  .hero-h1 {
    font-size: clamp(1.95rem, 3.5vw, 3.35rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-bottom: clamp(20px, 2.4vw, 30px);
  }
  .hero-lede {
    color: var(--bege-80);
    font-size: clamp(0.95rem, 1.15vw, 1.0625rem);
  }
  .hero-cta {
    margin-top: clamp(26px, 3vw, 38px);
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Entrada do texto no load, em CSS puro.
     Acima da dobra não faz sentido depender de IntersectionObserver:
     o conteúdo apareceria só depois do JS executar. */
  .stage-copy-in .eyebrow,
  .stage-copy-in .hero-lede,
  .stage-copy-in .hero-cta {
    animation: sobe 0.8s var(--ease-out) both;
  }
  .hero-h1 .line > span {
    animation: linha 1s var(--ease-out) both;
  }
  .stage-copy-in .eyebrow {
    animation-delay: 0.1s;
  }
  .hero-h1 .line:nth-child(1) > span {
    animation-delay: 0.2s;
  }
  .hero-h1 .line:nth-child(2) > span {
    animation-delay: 0.33s;
  }
  .stage-copy-in .hero-lede {
    animation-delay: 0.48s;
  }
  .stage-copy-in .hero-cta {
    animation-delay: 0.6s;
  }
  @keyframes sobe {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes linha {
    from {
      transform: translate3d(0, 105%, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* ---- rodapé do palco ---- */
  .stage-meta {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid var(--bege-14);
    padding-block: 16px;
  }
  .stage-meta-in {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .stage-meta .label {
    color: var(--bege-60);
  }

  /* ---- mobile: sem divisão; a imagem já nasce inteira ---- */
  @media (max-width: 860px) {
    .stage {
      --split: 0%;
      height: 190vh;
    }
    .stage-veil {
      /* precisa de contraste desde o início, pois o texto fica sobre a imagem */
      background: linear-gradient(
        to top,
        rgba(1, 8, 17, 0.95) 0%,
        rgba(1, 8, 17, 0.9) 46%,
        rgba(1, 8, 17, 0.72) 68%,
        rgba(1, 8, 17, 0.45) 100%
      );
      opacity: 1;
    }
    .stage-copy {
      align-items: flex-end;
      padding-bottom: clamp(74px, 12vh, 110px);
    }
    .stage-copy-in > * {
      max-width: none;
    }
    .stage-meta-mid {
      display: none;
    }
    .stage-next {
      bottom: clamp(74px, 12vh, 120px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage {
      height: auto;
    }
    .pin {
      position: static;
      height: auto;
      min-height: 100svh;
    }
    .stage-media :global(img) {
      animation: none;
    }
    .stage-media {
      clip-path: none;
    }
    .stage-copy-in .eyebrow,
    .stage-copy-in .hero-lede,
    .stage-copy-in .hero-cta,
    .hero-h1 .line > span {
      animation: none;
    }
    .stage-copy {
      opacity: 1;
      transform: none;
      position: relative;
      min-height: 100svh;
    }
    .stage-next {
      display: none;
    }
  }
</style>
