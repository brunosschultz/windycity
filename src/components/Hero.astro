---
import Logo from './Logo.astro';
import LogoGirassol from './LogoGirassol.astro';
import { waHref } from '../config';
---

<!--
  Abertura fiel aos frames do Figma (arquivo kNKexrhZ1Fy5yk4MdDkzZP):
    · 26:38  — estado inicial
    · 40:313 — estado final do scroll

  Nos dois frames, logo / lede / botão / Girassol estão nas MESMAS
  coordenadas e o vídeo é sempre de tela cheia, centralizado. O que muda
  com o scroll é apenas:
    sai   → degradê da esquerda + rótulo + H1 + linha verde
    entra → "luz natural" em destaque
    avança→ o tempo do vídeo (scrubbing pelo scroll)

  Medidas convertidas do canvas 1920x1080:
    horizontal → vw  (x / 1920 * 100)
    vertical   → svh (y / 1080 * 100)
-->
<section class="stage" id="hero" data-stage>
  <div class="pin" data-pin>
    <!-- Vídeo (26:42): 1920x1080, sempre cobrindo 100% da altura -->
    <div class="stage-media">
      <video
        class="stage-video"
        data-stage-video
        poster="/hero-poster.webp"
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/video/hero-900.mp4" media="(max-width: 860px)" type="video/mp4" />
        <source src="/video/hero-1920.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- Camada preta 20% (33:138) — constante -->
    <span class="stage-dim" aria-hidden="true"></span>

    <!-- Degradê da esquerda (26:44): 1216x934, opacidade 85% — sai no scroll -->
    <span class="stage-fade" aria-hidden="true"></span>

    <!-- "luz natural" (40:376) — entra no scroll -->
    <p class="stage-payoff" aria-hidden="true"><em class="ac">luz natural</em></p>

    <!-- ---- fixos: nunca mudam de posição ---- -->

    <!-- Logo (26:47): x 172 · y 118 · 509x121 -->
    <div class="hero-logo"><Logo /></div>

    <!-- Lede (26:59): x 1356 · y 135 · 505px · opacidade 80% -->
    <div class="hero-lede">
      <p>Enquanto o mercado aperta a planta para caber mais unidades, o WindyCity valoriza cada metro.</p>
      <p>
        Um projeto difícil de copiar, em uma das regiões mais procuradas por quem investe em Studios
        na cidade.
      </p>
    </div>

    <!-- Botão (26:60): x 172 · y 738 · altura 78 -->
    <a class="hero-cta" href={waHref()}>
      <span>Falar no WhatsApp</span>
      <span class="hero-cta-ic" aria-hidden="true">
        <svg viewBox="0 0 38 38" fill="none">
          <path
            d="M14 24 24 14m0 0h-7.5m7.5 0v7.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>

    <!-- Girassol (40:139): x 1599 · y 729 · 157x96 -->
    <div class="hero-girassol"><LogoGirassol /></div>

    <!-- ---- bloco que sai no scroll ----
         Agrupado e centralizado na altura da tela: assim o conjunto fica
         sempre no meio, em vez de ancorado por um topo fixo que sobe ou
         desce conforme a altura da janela. -->
    <div class="hero-bloco">
      <!-- Rótulo (40:381): traço 30px + texto 11px -->
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-ln" aria-hidden="true"></span>
        <span>Um empreendimento Girassol</span>
      </p>

      <!-- H1 (33:130): Sora Bold 47.846px. Quebra manual (.hbrk) só conta no
           mobile — no desktop ela some e o texto volta a quebrar sozinho
           pela largura da caixa (27.188vw), como no Figma. -->
      <h1 class="hero-h1">O diferencial que<br class="hbrk" />
        nenhum outro Studio<br class="hbrk" />
        de Curitiba entrega:</h1>

      <!-- Destaque (29:97): Times Italic 74px · #45b37c -->
      <p class="hero-accent"><em class="ac">Luz natural<br class="hbrk" />
        em cada cômodo</em></p>
    </div>
  </div>
</section>

<style>
  .stage {
    height: 260vh;
    position: relative;
    background: var(--preto);
    color: var(--bege);
    --p: 0;
    --po: 0; /* saída do degradê + rótulo + H1 + destaque */
    --pi: 0; /* entrada de "luz natural" */
  }

  .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- vídeo: tela cheia, centralizado, +40px para baixo ---------- */
  .stage-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .stage-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Centralizado puro: um deslocamento em svh aqui só é seguro quando
       sobra folga vertical no cover (janelas bem mais largas que o vídeo).
       Em telas mais altas (mobile, ou desktop com muita altura) essa folga
       zera e o deslocamento expõe uma faixa preta no topo — por isso fica
       sempre centralizado, garantindo 100% de altura coberta. */
    object-position: center;
    background: var(--preto);
    animation: mediaIn 1.5s var(--ease-out) both;
  }
  @keyframes mediaIn {
    from {
      opacity: 0;
      scale: 1.04;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  /* ---------- camada preta 20% (33:138) ---------- */
  .stage-dim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.2);
  }

  /* ---------- degradê da esquerda (26:44) ----------
     Caixa de 1216x934 ancorada no topo-esquerda, opacidade 85%.
     O node é `to left` com stops 34.13% / 51.10% / 66.17% — convertidos
     para `to right` (100% menos cada stop, ordem invertida). */
  .stage-fade {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    width: 63.333vw; /* 1216 / 1920 */
    /* altura cheia, acompanhando o vídeo (no Figma a caixa tem 934px, mas
       parar antes da base deixaria uma faixa clara no rodapé) */
    height: 100%;
    opacity: calc(0.85 * (1 - var(--po)));
    background: linear-gradient(
      to right,
      #040b12 0%,
      #040b12 33.835%,
      rgba(4, 11, 18, 0.5) 48.898%,
      rgba(4, 11, 19, 0) 65.87%
    );
  }

  /* ---------- "luz natural" (40:376) ----------
     font 489.226px = 25.48vw · leading 406.629/489.226 = 0.831
     tracking -14.6768/489.226 = -0.03em · caixa 2034px = 105.94vw
     centro vertical: top(50% - 246px) + metade da altura(286px) = 50% + 40px */
  .stage-payoff {
    position: absolute;
    z-index: 3;
    left: 50%;
    /* centro do vídeo (50% + 40px) menos 25px de ajuste óptico */
    top: calc(50% + 3.7svh - 25px);
    width: 105.94vw;
    text-align: center;
    translate: -50% -50%;
    scale: calc(0.96 + var(--pi) * 0.04);
    opacity: var(--pi);
    pointer-events: none;
  }
  .stage-payoff .ac {
    font-size: 25.48vw;
    line-height: 0.831;
    letter-spacing: -0.03em;
    color: #fff;
    white-space: nowrap;
  }

  /* ---------- fixos ---------- */
  .hero-logo {
    position: absolute;
    z-index: 5;
    left: 8.958vw; /* 172 / 1920 */
    top: 10.926svh; /* 118 / 1080 */
    width: 26.51vw; /* 509 / 1920 */
  }
  .hero-logo :global(svg) {
    width: 100%;
    height: auto;
    color: #fff;
  }

  .hero-lede {
    position: absolute;
    z-index: 5;
    left: 70.625vw; /* 1356 / 1920 */
    top: 12.5svh; /* 135 / 1080 */
    width: 26.302vw; /* 505 / 1920 */
    display: grid;
    gap: 1.6875em; /* uma linha em branco entre os parágrafos */
    font-size: clamp(0.8125rem, 0.833vw, 1rem);
    line-height: 1.6875; /* 27 / 16 */
    letter-spacing: -0.01em;
    color: #fff;
    opacity: 0.8;
  }

  /* Botão e Girassol ancorados pela BASE (não pelo topo): em telas mais
     baixas eles acompanham o rodapé em vez de subir junto com o conteúdo. */
  .hero-cta {
    position: absolute;
    z-index: 6;
    left: 8.958vw;
    bottom: 120px;
    display: inline-flex;
    align-items: center;
    gap: 1.042vw; /* 20 */
    min-height: 7.222svh; /* 78 */
    padding-inline: 1.563vw 1.042vw; /* 30 · 20 */
    background: var(--verde);
    color: #fff;
    font-size: clamp(0.75rem, 0.9375vw, 1.125rem);
    font-weight: 500;
    letter-spacing: 0.09em; /* 1.62 / 18 */
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.35s var(--ease);
  }
  .hero-cta:hover {
    background: #3d8a62;
  }
  .hero-cta-ic {
    width: 1.979vw; /* 38 */
    min-width: 28px;
    aspect-ratio: 1;
    flex: none;
    display: grid;
    place-items: center;
  }
  .hero-cta-ic svg {
    width: 100%;
    height: 100%;
  }

  .hero-girassol {
    position: absolute;
    z-index: 5;
    left: 83.281vw; /* 1599 / 1920 */
    bottom: 120px;
    width: 8.194vw; /* 157.34 / 1920 */
  }
  .hero-girassol :global(svg) {
    width: 100%;
    height: auto;
  }

  /* ---------- bloco que sai no scroll ----------
     Centralizado na altura da tela. A saída (opacidade + deslize) fica no
     container; as animações de entrada ficam nos filhos, para não brigarem
     com o `translate` que faz a centralização. */
  .hero-bloco {
    position: absolute;
    z-index: 4;
    left: 8.958vw;
    top: 50%;
    translate: calc(var(--po) * -2vw) -50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: calc(1 - var(--po));
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.677vw; /* 13 */
    font-size: clamp(0.625rem, 0.573vw, 0.6875rem);
    font-weight: 500;
    letter-spacing: 0.21em; /* 2.31 / 11 */
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }
  .hero-eyebrow-ln {
    width: 1.563vw; /* 30 */
    min-width: 22px;
    height: 2px;
    background: var(--verde);
    flex: none;
  }

  /* O Figma corta as caixas na altura de maiúscula (text-box-trim); sem
     isso o entrelinhamento do tipo empurraria os blocos para baixo. */
  .hero-h1,
  .hero-accent .ac {
    text-box: trim-both cap alphabetic;
  }
  .hero-h1 {
    margin-top: 3.889svh; /* 42px — respiro do rótulo até o H1 */
    width: 27.188vw; /* 522 / 1920 */
    font-size: clamp(1.25rem, 2.492vw, 2.99rem); /* 47.846 */
    font-weight: 700;
    line-height: 1.0833; /* 51.833 / 47.846 */
    letter-spacing: -0.01em;
    color: #fff;
  }
  .hero-accent {
    /* 14px do Figma + 20px de respiro pedido em relação ao H1 */
    margin-top: calc(1.296svh + 20px);
    width: 21.563vw; /* 414 / 1920 */
  }
  .hero-accent .ac {
    font-size: clamp(1.9rem, 3.854vw, 4.625rem); /* 74 */
    line-height: 0.77; /* 57 / 74 */
    letter-spacing: -0.05em;
    color: #45b37c;
  }

  /* Quebra manual: por padrão some (desktop quebra sozinho pela largura) */
  .hero-h1 .hbrk,
  .hero-accent .hbrk {
    display: none;
  }

  /* ---------- entrada no load (CSS puro: acima da dobra não espera JS) ---------- */
  /*
    `backwards` (e não `both`): com `both` o estado final da animação fica
    congelado no elemento e passa a ter precedência sobre as declarações
    normais — o `opacity: calc(1 - var(--po))` dos blocos que saem no scroll
    nunca surtia efeito e o H1 ficava preso na tela. Com `backwards` a
    animação só pinta o estado inicial durante o atraso e devolve o controle
    ao CSS quando termina.
  */
  .hero-logo,
  .hero-eyebrow,
  .hero-h1,
  .hero-accent,
  .hero-lede,
  .hero-cta,
  .hero-girassol {
    animation: sobe 0.85s var(--ease-out) backwards;
  }
  .hero-logo {
    animation-delay: 0.1s;
  }
  .hero-eyebrow {
    animation-delay: 0.2s;
  }
  .hero-h1 {
    animation-delay: 0.28s;
  }
  .hero-accent {
    animation-delay: 0.36s;
  }
  .hero-lede {
    animation-delay: 0.46s;
    --o-fim: 0.8;
  }
  .hero-cta {
    animation-delay: 0.56s;
  }
  .hero-girassol {
    animation-delay: 0.64s;
  }
  @keyframes sobe {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: var(--o-fim, 1);
      translate: 0 0;
    }
  }

  /* ---------- mobile ---------- */
  @media (max-width: 860px) {
    .stage {
      height: 220vh;
    }
    .stage-fade {
      /* no mobile o texto fica sobre o vídeo: véu vertical dá o contraste */
      width: 100%;
      height: 100%;
      background: linear-gradient(
        to top,
        rgba(4, 11, 18, 0.94) 0%,
        rgba(4, 11, 18, 0.86) 46%,
        rgba(4, 11, 18, 0.6) 74%,
        rgba(4, 11, 18, 0.4) 100%
      );
      opacity: calc(1 - var(--po) * 0.55);
    }
    .hero-logo {
      left: var(--gutter);
      top: 8svh;
      width: 46vw;
    }
    /* No mobile o bloco NÃO centraliza: a tela é estreita e alta, e o
       conjunto centralizado encavalaria o texto de apoio logo abaixo.
       Aqui ele fica ancorado abaixo do logo. */
    .hero-bloco {
      left: var(--gutter);
      top: 21svh;
      translate: calc(var(--po) * -2vw) 0;
      width: calc(100vw - var(--gutter) * 2);
    }
    .hero-eyebrow {
      font-size: 0.625rem;
    }
    .hero-h1 {
      margin-top: 3svh;
      width: 100%;
      font-size: clamp(1.35rem, 5.6vw, 2rem);
    }
    .hero-accent {
      margin-top: calc(1.2svh + 16px);
      width: 100%;
    }
    .hero-accent .ac {
      font-size: clamp(2.2rem, 10vw, 3.4rem);
    }
    /* título branco em 3 linhas, destaque verde em 2 */
    .hero-h1 .hbrk,
    .hero-accent .hbrk {
      display: block;
    }
    .hero-lede {
      left: var(--gutter);
      /* ancorado pela base junto com o botão: com o bloco de texto agora
         centralizado, um topo fixo em svh acabava encavalando nele */
      top: auto;
      bottom: 186px;
      width: calc(100vw - var(--gutter) * 2);
      font-size: 0.875rem;
    }
    .hero-cta {
      left: var(--gutter);
      /* mais folga que no desktop: precisa passar por cima da barra fixa
         de WhatsApp, que ocupa ~68px a partir da base */
      bottom: 108px;
      min-height: 56px;
      padding-inline: 18px 14px;
      gap: 12px;
      font-size: 0.8125rem;
    }
    .hero-cta-ic {
      width: 22px;
      min-width: 22px;
    }
    .hero-girassol {
      left: auto;
      right: var(--gutter);
      bottom: 108px;
      width: 22vw;
    }
    .stage-payoff .ac {
      font-size: 30vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage {
      height: auto;
    }
    .pin {
      position: static;
      height: auto;
      min-height: 100svh;
    }
    .stage-video,
    .hero-logo,
    .hero-eyebrow,
    .hero-h1,
    .hero-accent,
    .hero-lede,
    .hero-cta,
    .hero-girassol {
      animation: none;
    }
    .stage-payoff {
      display: none;
    }
  }
</style>
