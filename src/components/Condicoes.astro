---
import { EMPREENDIMENTO } from '../config';

const etapas = [
  { pct: EMPREENDIMENTO.entrada, label: 'de entrada — menor desembolso inicial' },
  {
    pct: EMPREENDIMENTO.obra,
    label: 'durante a obra — pagamento distribuído ao longo da construção',
  },
  {
    pct: EMPREENDIMENTO.chaves,
    label: 'na entrega das chaves — maior parcela concentrada na conclusão',
    destaque: true,
  },
];
---

<section class="section theme-bege cd" id="condicoes" aria-labelledby="cd-t">
  <div class="wrap">
    <div class="cd-head">
      <p class="eyebrow" data-rv>Condições comerciais</p>
      <h2 class="h2-xl" id="cd-t" data-rv style="--d:80ms">
        Mais <em class="ac">facilidade</em> no início. Mais planejamento até a entrega.
      </h2>
    </div>

    <ol class="fluxo">
      {
        etapas.map((e, i) => (
          <li
            class={`etapa ${e.destaque ? 'is-dest' : ''}`}
            data-rv
            style={`--d:${i * 120}ms; --step:${i}; --w:${e.pct / 100}`}
          >
            <span class="etapa-n">
              <span class="etapa-v" data-count={e.pct}>
                0
              </span>
              <span class="etapa-pc">%</span>
            </span>
            <span class="etapa-l">{e.label}</span>
          </li>
        ))
      }
    </ol>

    <div class="preco" data-rv>
      <span class="preco-k label">Faixa de valores</span>
      <p class="preco-v">
        a partir de <strong>[R$ valor mínimo]</strong> até <strong>[R$ valor máximo]</strong> — varia
        por andar e orientação da unidade.
      </p>
      <a class="btn btn--ghost preco-cta" href="#contato">
        <span>Ver condições completas</span>
        <svg class="arw" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M2 8h11m0 0L9 4m4 4l-4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Costura com a dobra de contato: a medida sai do conteúdo e vai até a
       borda da tela, desenhada pelo próprio scroll. Decorativa. -->
  <div class="cd-fecho bleed" data-prog aria-hidden="true"><span></span></div>
</section>

<style>
  .cd {
    padding-bottom: clamp(64px, 8vw, 120px);
    /* espessura única das barras de medida (etapas + faixa de valores) */
    --bar: clamp(2px, 0.22vw, 3px);
  }
  .cd-head {
    /* largura livre — quem limita é o h2 abaixo, com ch no tamanho certo */
    margin-bottom: clamp(50px, 7vw, 100px);
  }
  .cd-head .h2-xl {
    /* "ch" precisa ir no próprio h2: em .cd-head (16px) o "ch" saía ~4x
       mais estreito do que no h2 (78px), quebrando o título cedo demais. */
    max-width: 20ch;
  }

  /* Escada tipográfica: cada etapa recua mais e o número cresce junto —
     a progressão 10 → 20 → 70 fica legível antes mesmo de ler o rótulo. */
  .fluxo {
    display: grid;
    /* o vão entre etapas é bem maior que o respiro interno: assim cada barra
       lê como topo do SEU número, não como fecho do número anterior */
    gap: clamp(34px, 4.6vw, 76px);
    margin-bottom: clamp(56px, 7vw, 100px);
  }
  .etapa {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 4vw, 64px);
    padding-block: clamp(12px, 1.4vw, 20px) 0;
    /* recuo derivado do índice, em vez de nth-child solto */
    padding-left: calc(var(--step, 0) * clamp(0px, 4.4vw, 96px));
    border-top: 1px solid var(--rule);
    /* rampa de escala do número (desktop) */
    --esc: calc(0.62 + var(--step, 0) * 0.19);
  }

  /* A MEDIDA: o próprio fio da linha vira barra proporcional ao percentual.
     O bloco posicionado é o padding-box da etapa — idêntico nas três, mesmo
     com recuos diferentes —, então 10% / 20% / 70% partem do mesmo x e são
     realmente comparáveis entre si. Só transform anima. */
  .etapa::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: var(--bar);
    width: calc(var(--w, 0) * 100%);
    background: var(--verde);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.9s var(--ease-out);
    transition-delay: calc(var(--d, 0ms) + 260ms);
  }
  .etapa.is-in::after {
    transform: scaleX(1);
  }

  .etapa-n {
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: calc(var(--esc, 1) * clamp(4rem, 14vw, 13rem));
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--marrom);
    font-variant-numeric: lining-nums tabular-nums;
    display: inline-flex;
    align-items: baseline;
  }
  /* Reserva a largura dos dois dígitos finais: o contador sobe de 0 até 70
     sem empurrar o "%" nem mexer na linha — zero layout shift. */
  .etapa-v {
    min-width: 2ch;
    text-align: right;
  }
  .etapa-pc {
    font-size: 0.44em;
  }
  .etapa-l {
    font-size: clamp(0.875rem, 1.35vw, 1.0625rem);
    line-height: 1.5;
    color: var(--fg-soft);
    max-width: 28ch;
  }
  .etapa.is-dest .etapa-n {
    color: var(--verde);
  }
  .etapa.is-dest .etapa-l {
    color: var(--fg);
    font-weight: 500;
  }

  /* Faixa de valores: fio + tipografia, sem moldura tracejada */
  .preco {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) auto;
    gap: clamp(16px, 3vw, 44px);
    align-items: center;
    padding-top: clamp(30px, 3.4vw, 46px);
    border-top: 1px solid var(--rule);
  }
  /* Fecho da progressão: depois de 10 → 20 → 70 a barra completa a medida. */
  .preco::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: var(--bar);
    background: var(--verde);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.1s var(--ease-out);
    transition-delay: 200ms;
  }
  .preco.is-in::before {
    transform: scaleX(1);
  }
  .preco-k {
    color: var(--verde);
  }
  .preco-v {
    font-size: clamp(0.9375rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    color: var(--fg-soft);
    max-width: 44ch;
  }
  /* Valor ainda pendente do cliente: marcado como campo a preencher,
     não como número definitivo. */
  .preco-v strong {
    color: var(--fg);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: underline dashed;
    text-decoration-color: var(--marrom-50);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .preco-cta {
    justify-self: end;
  }

  /* Fio de costura com a próxima dobra: mesma leitura das barras acima —
     trilho fixo + preenchimento verde —, só que agora de borda a borda da
     tela. O preenchimento é desenhado pelo próprio scroll (--prog, driver
     global): a medida sai do conteúdo e entrega o usuário no formulário. */
  .cd-fecho {
    margin-top: clamp(48px, 6vw, 88px);
    height: 1px;
    background: var(--rule);
  }
  .cd-fecho span {
    display: block;
    height: 100%;
    background: var(--verde);
    /* fallback 0 (não 1): igual aos outros [data-prog] do site. O driver só
       escreve --prog depois do primeiro callback do IntersectionObserver —
       com fallback 1 a linha nasce cheia e depois encolhe, o que pisca se a
       dobra já estiver na tela (deep link em #condicoes, F5 no meio da
       página, restauração de scroll). */
    transform: scaleX(var(--prog, 0));
    transform-origin: left center;
  }

  @media (max-width: 860px) {
    .etapa {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-block: 16px 0;
      padding-left: 0;
      /* rampa mais curta no mobile: os três números continuam grandes */
      --esc: calc(0.74 + var(--step, 0) * 0.13);
    }
    .etapa-l {
      max-width: none;
    }
    .preco {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .preco-cta {
      justify-self: stretch;
      width: 100%;
      margin-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .etapa::after,
    .preco::before {
      transform: scaleX(1);
      transition: none;
    }
    .cd-fecho span {
      transform: none;
    }
  }
</style>
