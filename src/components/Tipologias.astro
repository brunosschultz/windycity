---
import { Picture } from 'astro:assets';
import p2445 from '../assets/images/planta-24-45.png';
import p2628 from '../assets/images/planta-26-28.png';
import p3358 from '../assets/images/planta-33-58.png';
import p2841 from '../assets/images/planta-28-41.png';
import p4708 from '../assets/images/planta-47-08.png';
import p7170 from '../assets/images/planta-71-70.png';
/* Fotos de apoio: só as NÃO usadas por Diferenciais (que ocupa unid-sacada-01,
   unid-sacada-02 e unid-meio-02). Cada faixa usa uma dupla própria. */
import ambClaro from '../assets/images/unid-meio-01.jpg';
import ambMadeira from '../assets/images/unid-sacada-04.jpg';
import ambMeio3 from '../assets/images/unid-meio-03.jpg';
import ambSacada3 from '../assets/images/unid-sacada-03.jpg';
import { waHref } from '../config';

/* ⚠️ A METRAGEM de cada planta vem do nome do arquivo (dado real).
   A DIVISÃO entre Studio e Garden abaixo foi deduzida da própria planta —
   têm área privativa GRAMADA no térreo = Garden; têm apenas varanda/terraço
   pavimentado = Studio. (A de 33,58 m² foi reclassificada como Garden nesta
   revisão — a faixa ao longo da fachada é grama, não piso.) É a única leitura possível com o material em mãos e
   precisa de confirmação do cliente; se algum arquivo estiver na lista
   errada, basta movê-lo de `plantas` entre os dois blocos abaixo. */
const plantasStudio = [
  {
    img: p2445,
    area: '24,45 m²',
    alt: 'Planta humanizada de studio de 24,45 m² do WindyCity, com dormitório, estar, cozinha compacta e banheiro integrados',
    widths: [640, 960, 1280, 1536],
  },
  {
    img: p2628,
    area: '26,28 m²',
    alt: 'Planta humanizada de studio de 26,28 m² do WindyCity, com varanda lateral e cozinha integrada ao estar',
    widths: [560, 860, 1180, 1353],
  },
];
const plantasGarden = [
  {
    img: p2841,
    area: '28,41 m²',
    alt: 'Planta humanizada de garden de 28,41 m² do WindyCity, com área externa privativa gramada',
    widths: [480, 700, 913],
  },
  {
    img: p3358,
    area: '33,58 m²',
    alt: 'Planta humanizada de garden de 33,58 m² do WindyCity, com faixa gramada privativa ao longo de toda a fachada',
    widths: [560, 860, 1180, 1318],
  },
  {
    img: p4708,
    area: '47,08 m²',
    alt: 'Planta humanizada de garden de 47,08 m² do WindyCity, com área externa privativa gramada e deck de madeira',
    widths: [560, 800, 1088],
  },
  {
    img: p7170,
    area: '71,70 m²',
    alt: 'Planta humanizada de garden de 71,70 m² do WindyCity, com ampla área externa gramada, deck e espreguiçadeiras',
    widths: [560, 860, 1180, 1313],
  },
];

/*
  Arquitetura da dobra: duas CENAS editoriais de ~100svh, uma por tipologia,
  espelhadas. Em cada cena a PLANTA é a protagonista gráfica — sangrada até a
  borda da tela, em `multiply` sobre o bege (o branco do arquivo vira o fundo
  da seção, a planta "flutua"), crescendo sutilmente conduzida pelo scroll
  (data-prog na cena; a custom property herda). Atrás dela, um número-fantasma
  em serifada de pôster deriva na direção contrária. O título quebra em dois
  pesos: o NOME em escala display invadindo a planta, o restante como linha de
  apoio na coluna de leitura.

  `nome`/`sub` são o MESMO título aprovado, quebrado em spans — texto intacto,
  só hierarquia. `dir` guia a máscara de revelação para a borda em que a planta
  sangra. Studio (1536x763, ~2:1) deita; Garden (1088x929, quase quadrada)
  impõe massa — o porte diferente das duas é a própria mensagem.
*/
const tipos = [
  {
    num: '01',
    plantas: plantasStudio,
    nome: 'Studio',
    sub: '— praticidade para quem vive em movimento',
    texto:
      'Opção versátil para estudantes, profissionais e investidores que buscam mobilidade, funcionalidade e potencial para locações de curta permanência.',
    itens: [
      'Planta flexível — pode configurar um layout de 1 dormitório',
      'Investimento e short stay',
      'Estudantes e profissionais',
      'Moradia individual',
      'Quem prioriza localização e praticidade',
    ],
    cta: 'Conhecer Studios',
    dir: 'esq',
    sizes: '(max-width: 980px) 88vw, 42vw',
  },
  {
    num: '02',
    plantas: plantasGarden,
    nome: 'Garden',
    sub: '— mais espaço para viver por mais tempo',
    texto:
      'Com área externa privativa, oferece uma experiência mais residencial — indicada para quem busca conforto, privacidade e permanência prolongada.',
    itens: [
      'Moradia e locação de longa permanência',
      'Público maduro',
      'Quem valoriza área externa',
      'Quem busca mais privacidade e amplitude',
    ],
    cta: 'Conhecer Gardens',
    dir: 'dir',
    sizes: '(max-width: 980px) 88vw, 42vw',
  },
];
---

{/* Fundo BRANCO: o branco dos arquivos de planta é branco puro, então
    sobre o bege sobravam manchas claras nas bordas. Com a seção branca o
    `multiply` funde perfeitamente e nenhuma planta precisa ser reexportada. */}
<section class="section theme-branco tp" id="tipologias" aria-labelledby="tp-t">
  <div class="wrap">
    <header class="tp-head">
      <div class="tp-head-a">
        <p class="eyebrow" data-rv>Tipologias</p>
        <h2 class="h2-xl" id="tp-t" data-rv-pal>
          Duas formas de <em class="ac">viver</em> o WindyCity
        </h2>
      </div>
      <p class="body tp-lead" data-rv style="--d:160ms">
        Studios e Gardens compartilham a mesma arquitetura bem resolvida — iluminação natural,
        ventilação e melhor aproveitamento dos espaços. O que muda é a forma de viver ou investir.
      </p>
    </header>
  </div>

  {
    tipos.map((t, i) => (
      <>
        <article class={`tp-cena ${i === 0 ? 'tp-cena--a' : 'tp-cena--b'}`} data-prog>
          <div class="wrap tp-grid">
            {/* Número-fantasma: pintado ANTES da planta; o multiply dela deixa
                o número atravessar as áreas brancas do arquivo — camadas de
                impresso, não "imagem em cima de fundo". aria-hidden: é
                ornamento de cena, não conteúdo. */}
            <span class="tp-num num-xl" aria-hidden="true">
              {t.num}
            </span>

            {/* Carrossel das plantas da tipologia. Todas as opções vivem no
                HTML; sem JS elas simplesmente aparecem empilhadas, com a
                metragem de cada uma — nada fica escondido esperando script. */}
            <figure class="tp-fig" data-carrossel>
              <div class="tp-palco">
                {t.plantas.map((p, k) => (
                  <div
                    class={`tp-slide${k === 0 ? ' is-ativo' : ''}`}
                    data-slide
                    data-area={p.area}
                  >
                    {/* O blend fica num wrapper que contém SÓ a imagem; a
                        legenda fica fora — texto de 9px dentro de transform
                        sairia borrado. */}
                    <div class="tp-fig-bl" data-rv-img={k === 0 ? t.dir : undefined}>
                      <Picture
                        src={p.img}
                        formats={['avif', 'webp']}
                        fallbackFormat="webp"
                        widths={p.widths}
                        sizes={t.sizes}
                        alt={p.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <span class="tp-area-inline label">{p.area}</span>
                  </div>
                ))}
              </div>

              {/* Controles: só aparecem quando o script assume (.is-js) —
                  sem JS as setas não teriam o que fazer. */}
              <div class="tp-ctrl" data-ctrl>
                <button class="tp-seta" type="button" data-ant aria-label={`Planta anterior de ${t.nome}`}>
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <p class="tp-area" data-area-alvo aria-live="polite">{t.plantas[0].area}</p>
                <button class="tp-seta" type="button" data-prox aria-label={`Próxima planta de ${t.nome}`}>
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>

              <figcaption class="tp-il label">Imagens meramente ilustrativas</figcaption>
            </figure>

            <div class="tp-txt">
              <h3 class="tp-h3" data-rv>
                {/* Título aprovado intacto, quebrado em spans: nome em escala
                    display (invade a planta no desktop), restante como linha
                    de apoio. O nome acessível continua a frase inteira. */}
                <span class="tp-nome">{t.nome}</span>
                <span class="tp-sub">{t.sub}</span>
              </h3>
              <p class="tp-p" data-rv style="--d:90ms">
                {t.texto}
              </p>
              <ul class="tp-list" data-rv="fade" style="--d:170ms">
                {t.itens.map((it) => (
                  <li>
                    <span class="tp-mk" aria-hidden="true" />
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
              {/* O data-rv fica no invólucro, não no <a>: [data-rv].is-in
                  escreve em transform e venceria o levantar do .btn:hover. */}
              <div class="tp-cta-hold" data-rv style="--d:260ms">
                <a class="btn tp-cta" href={waHref()}>
                  <span>{t.cta}</span>
                  <svg class="arw" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M2 8h11m0 0L9 4m4 4l-4 4"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>

        {/* Faixa fotográfica depois de CADA cena — o Garden não tinha a dele.
            Sem legenda e sem vínculo com a tipologia: os arquivos dizem
            posição no pavimento ("meio"/"sacada"), não tipologia comercial —
            associá-los a Studio ou Garden seria inventar informação. Dupla
            assimétrica em sangria total; contexto isolado do multiply. */}
        <div class="tp-faixa bleed">
          <div class="tp-ft tp-ft--a" data-px="46" data-rv-img="esq">
            <Picture
              src={i === 0 ? ambClaro : ambMeio3}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 760, 1080, 1400, 1672]}
              sizes="(max-width: 860px) 100vw, 58vw"
              alt={
                i === 0
                  ? 'Ambiente interno do WindyCity com cozinha compacta branca, sofá-cama, closet envidraçado e piso de madeira em espinha'
                  : 'Ambiente interno do WindyCity visto da entrada, com marcenaria clara contínua, estar e dormitório no mesmo espaço'
              }
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="tp-ft tp-ft--b" data-px="24" data-rv-img="dir" style="--d:120ms">
            <Picture
              src={i === 0 ? ambMadeira : ambSacada3}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900, 1200]}
              sizes="(max-width: 860px) 78vw, 36vw"
              alt={
                i === 0
                  ? 'Detalhe interno do WindyCity com nicho de trabalho, bancada, banco embutido e cozinha em pedra clara ao lado'
                  : 'Detalhe da sacada do WindyCity, com guarda-corpo metálico, forro de madeira e vista para a cidade'
              }
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </>
    ))
  }

  <div class="wrap">
    <!-- Fecho tipográfico em escala. Revelação palavra a palavra via GSAP
         (script abaixo): SEM estado oculto em CSS estático — sem JS ou com
         movimento reduzido a frase está simplesmente lá. -->
    <div class="tp-fecho">
      <p class="tp-claim">
        <span class="tp-claim-l">Diferentes formas de ocupar.</span>
        <span class="tp-claim-l tp-claim-l--b ac">A mesma qualidade de projeto.</span>
      </p>
    </div>
  </div>
</section>

<script>
  import { aoAproximar, reduzMovimento, dividirPalavras } from '../scripts/ilha';

  /* ---------- Carrossel de plantas ----------
     Sem GSAP e sem dependência: só troca a classe do slide ativo e o rótulo
     da metragem. A classe `is-js` no <figure> é o que revela as setas e
     colapsa a pilha — sem script, as plantas ficam todas visíveis, cada uma
     com a própria metragem ao lado. */
  for (const fig of document.querySelectorAll<HTMLElement>('[data-carrossel]')) {
    const slides = [...fig.querySelectorAll<HTMLElement>('[data-slide]')];
    const alvoArea = fig.querySelector<HTMLElement>('[data-area-alvo]');
    if (slides.length < 2 || !alvoArea) continue;

    fig.classList.add('is-js');
    let atual = 0;

    const mostrar = (i: number) => {
      atual = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-ativo', k === atual));
      alvoArea.textContent = slides[atual].dataset.area ?? '';
    };

    fig.querySelector('[data-ant]')?.addEventListener('click', () => mostrar(atual - 1));
    fig.querySelector('[data-prox]')?.addEventListener('click', () => mostrar(atual + 1));
    mostrar(0);
  }

  const secao = document.querySelector('#tipologias');
  if (secao) {
    aoAproximar(secao, async () => {
      if (reduzMovimento()) return;
      const linhas = [...secao.querySelectorAll<HTMLElement>('.tp-claim-l')];
      if (!linhas.length) return;

      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      /* Split local (spans com overflow hidden). Só as palavras ficam ocultas,
         e só a partir daqui — se o import falhar, nada foi escondido. */
      const palavras = linhas.flatMap((l) => dividirPalavras(l));
      gsap.set(palavras, { yPercent: 112 });
      gsap.to(palavras, {
        yPercent: 0,
        duration: 0.9,
        ease: 'power4.out',
        stagger: 0.055,
        scrollTrigger: {
          trigger: secao.querySelector('.tp-claim'),
          start: 'top 86%',
          once: true, // dispara uma vez e se desregistra — nada fica escutando
        },
      });
    });
  }
</script>

<style>
  /* ---------- Abertura ---------- */
  .tp-head {
    margin-bottom: clamp(36px, 6vw, 84px);
  }
  .tp-head .h2-xl {
    /* "ch" no próprio h2: no pai (16px) o "ch" sairia ~4x mais estreito. */
    max-width: 20ch;
  }
  .tp-lead {
    max-width: 52ch;
    margin-top: 24px;
  }
  @media (min-width: 1000px) {
    .tp-head {
      display: grid;
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
      gap: clamp(40px, 5vw, 96px);
      align-items: end;
    }
    .tp-lead {
      max-width: 44ch;
      margin-top: 0;
      /* Fio editorial: o parágrafo apoia o título pela direita, pautado. */
      border-top: 1px solid var(--rule);
      padding-top: 18px;
    }
  }

  /* ---------- Cena por tipologia ---------- */
  /* `clip` (não hidden): corta o número-fantasma que sangra além da borda sem
     criar contexto de rolagem. Nada de sticky aqui dentro. */
  .tp-cena {
    position: relative;
    overflow: clip;
  }
  .tp-grid {
    position: relative;
    display: grid;
    gap: 30px;
    padding-block: clamp(40px, 7vw, 90px);
  }

  /* Número-fantasma. Deriva contra o scroll via --prog (herdada da cena,
     publicada pelo driver global) — compositor-only, custo zero de JS local. */
  .tp-num {
    position: absolute;
    z-index: 0;
    top: -0.06em;
    color: var(--marrom-16);
    pointer-events: none;
    user-select: none;
    font-size: clamp(5rem, 24vw, 20rem);
  }
  .tp-cena--a .tp-num {
    right: -0.05em;
  }
  .tp-cena--b .tp-num {
    left: -0.05em;
  }

  .tp-fig {
    position: relative;
    z-index: 1;
    margin: 0;
  }
  /* Palco de proporção fixa: os seis arquivos têm larguras e alturas bem
     diferentes (de 2:1 a quase quadrado). Com uma caixa única e `contain`,
     todas ocupam o MESMO espaço na página e nenhuma é distorcida ou
     recortada — a planta só se ajusta dentro do palco. */
  .tp-palco {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    /* Rede de segurança: sem isso, uma planta mais alta que a caixa
       transbordava e cobria as setas de navegação logo abaixo. */
    overflow: hidden;
  }
  .tp-slide {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  /* O branco do arquivo da planta vira exatamente o bege da seção — a planta
     flutua sem moldura e deixa o número-fantasma atravessar por baixo. */
  .tp-fig-bl {
    mix-blend-mode: multiply;
    width: 100%;
    min-height: 0;
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Aproximação guiada pelo scroll: chega 6% menor e atinge o tamanho
       natural antes do meio da cena. O clamp trava em 1 — nunca estoura a
       própria caixa. Com prefers-reduced-motion o driver publica --prog:1,
       o que já resolve em scale(1); ainda assim há o corte explícito abaixo. */
    transform: scale(clamp(0.94, calc(0.94 + var(--prog, 0) * 0.16), 1));
    transform-origin: center center;
  }
  .tp-fig-bl :global(picture) {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }
  .tp-fig-bl :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* Sem JS as plantas ficam empilhadas, cada uma com sua metragem */
  .tp-area-inline {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--marrom-50);
  }

  /* ---------- Controles do carrossel ---------- */
  .tp-ctrl {
    display: none;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2.4vw, 28px);
    margin-top: clamp(14px, 2vw, 22px);
  }
  .is-js .tp-ctrl {
    display: flex;
  }
  .tp-seta {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .tp-seta:hover {
    border-color: var(--verde);
    color: var(--verde);
  }
  .tp-seta:focus-visible {
    outline: 2px solid var(--verde);
    outline-offset: 3px;
  }
  /* Metragem da planta em exibição */
  .tp-area {
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    line-height: 1;
    color: var(--verde);
    min-width: 6ch;
    text-align: center;
    font-variant-numeric: lining-nums tabular-nums;
  }
  /* Com JS, só a planta ativa fica visível e a metragem migra pro controle */
  .is-js .tp-slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s var(--ease-out),
      visibility 0s linear 0.4s;
  }
  .is-js .tp-slide.is-ativo {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.45s var(--ease-out),
      visibility 0s;
  }
  .is-js .tp-area-inline {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .is-js .tp-slide,
    .is-js .tp-slide.is-ativo {
      transition: none;
    }
  }
  .tp-il {
    display: block;
    text-align: right;
    margin-top: 10px;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--marrom-50);
  }

  .tp-txt {
    position: relative;
    z-index: 2;
  }
  .tp-h3 {
    margin-bottom: 18px;
  }
  /* O nome em escala display; o restante do título como linha de apoio.
     (Mesmo h3, mesma frase — só pesos.) */
  .tp-nome {
    display: block;
    font-size: clamp(2.7rem, 13vw, 6.6rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .tp-sub {
    display: block;
    margin-top: 16px;
    font-size: clamp(1rem, 1.5vw, 1.3rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--fg);
    max-width: 30ch;
  }
  .tp-p {
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    line-height: 1.62;
    color: var(--fg-soft);
    margin-bottom: 30px;
    max-width: 46ch;
  }

  /* Lista como pauta: fio sobre cada item e sob o último — é o que torna
     Studio e Garden comparáveis linha a linha. */
  .tp-list {
    display: grid;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--rule);
  }
  .tp-list li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--fg-soft);
    opacity: 0;
    transform: translate3d(0, 9px, 0);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.55s var(--ease-out);
  }
