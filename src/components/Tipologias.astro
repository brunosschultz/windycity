---
import { Picture } from 'astro:assets';
import plantaStudio from '../assets/images/planta-24-45.png';
import plantaGarden from '../assets/images/planta-47-08.png';
/* As três fotos de apoio são as únicas do acervo interno ainda NÃO usadas em
   Diferenciais (que já leva unid-sacada-01, unid-sacada-02 e unid-meio-02) —
   a dobra anterior é vizinha desta, repetir a mesma foto seria evidente. */
import ambA from '../assets/images/unid-meio-01.jpg';
import ambB from '../assets/images/unid-sacada-03.jpg';
import ambC from '../assets/images/unid-sacada-04.jpg';
import { waHref } from '../config';

/*
  `esc` / `sizes` / `widths` NÃO são decoração: as duas plantas têm proporções
  muito diferentes (24-45 é 1536x763, quase 2:1; 47-08 é 1088x929, quase
  quadrada). Renderizar as duas na mesma largura achatava a leitura. Dando
  ao Studio uma caixa um pouco menor, a diferença de porte entre as duas
  tipologias — que é exatamente o que o texto afirma — passa a ser visível
  antes de ser lida. Não é escala métrica e não está rotulada como tal.

  `dir` guia a máscara de revelação para o lado em que a planta está na
  composição do desktop: o recorte abre a partir da margem, não do miolo.
*/
const tipos = [
  {
    img: plantaStudio,
    alt: 'Planta humanizada de studio do WindyCity, com dormitório, estar, cozinha compacta e banheiro integrados',
    titulo: 'Studio — praticidade para quem vive em movimento',
    texto:
      'Opção versátil para estudantes, profissionais e investidores que buscam mobilidade, funcionalidade e potencial para locações de curta permanência.',
    itens: [
      'Planta flexível — pode configurar um layout de 1 dormitório',
      'Investimento e short stay',
      'Estudantes e profissionais',
      'Moradia individual',
      'Quem prioriza localização e praticidade',
    ],
    cta: 'Conhecer Studios',
    esc: '90%',
    dir: 'esq',
    widths: [560, 820, 1120],
    sizes: '(max-width: 940px) 90vw, 47vw',
  },
  {
    img: plantaGarden,
    alt: 'Planta humanizada de garden do WindyCity, com área externa privativa gramada e deck de madeira',
    titulo: 'Garden — mais espaço para viver por mais tempo',
    texto:
      'Com área externa privativa, oferece uma experiência mais residencial — indicada para quem busca conforto, privacidade e permanência prolongada.',
    itens: [
      'Moradia e locação de longa permanência',
      'Público maduro',
      'Quem valoriza área externa',
      'Quem busca mais privacidade e amplitude',
    ],
    cta: 'Conhecer Gardens',
    esc: '100%',
    dir: 'dir',
    widths: [620, 900, 1240],
    sizes: '(max-width: 940px) 100vw, 52vw',
  },
];
---

<section class="section theme-bege tp" id="tipologias" aria-labelledby="tp-t">
  <div class="wrap">
    <div class="tp-head">
      <div class="tp-head-a">
        <p class="eyebrow" data-rv>Tipologias</p>
        <h2 class="h2-xl" id="tp-t" data-rv style="--d:80ms">
          Duas formas de <em class="ac">viver</em> o WindyCity
        </h2>
      </div>
      <div class="tp-head-b">
        <p class="body tp-body" data-rv style="--d:160ms">
          Studios e Gardens compartilham a mesma arquitetura bem resolvida — iluminação natural,
          ventilação e melhor aproveitamento dos espaços. O que muda é a forma de viver ou investir.
        </p>
      </div>
    </div>
  </div>

  <!--
    Faixa fotográfica COMUM à seção — é a evidência da frase logo acima
    ("compartilham a mesma arquitetura bem resolvida"). Fica de propósito
    FORA dos dois blocos de tipologia e sem legenda: os arquivos dizem
    "unidade meio" e "unidade sacada", que é POSIÇÃO no pavimento, não a
    tipologia comercial. Associar qualquer uma dessas fotos a Studio ou a
    Garden seria inventar informação. Aqui elas só mostram o padrão de
    acabamento — que é comum às duas.

    Contexto isolado do `multiply`: estas fotos não passam perto de .tp-fig.
  -->
  <div class="tp-faixa">
    <div class="tp-ft tp-ft--a" data-px="40" data-rv-img="esq">
      <Picture
        src={ambA}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[420, 640, 900, 1200]}
        sizes="(max-width: 860px) 100vw, 45vw"
        alt="Ambiente interno do WindyCity com cozinha compacta branca, sofá-cama, closet envidraçado e piso de madeira em espinha"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="tp-ft tp-ft--b" data-px="66" data-rv-img style="--d:110ms">
      <Picture
        src={ambB}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[340, 540, 780, 1040]}
        sizes="(max-width: 860px) 50vw, 33vw"
        alt="Ambiente interno do WindyCity revestido em madeira clara, com bancada de trabalho, cozinha ao fundo e cama junto à parede"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="tp-ft tp-ft--c" data-px="28" data-rv-img="dir" style="--d:200ms">
      <Picture
        src={ambC}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[340, 540, 780, 1040]}
        sizes="(max-width: 860px) 50vw, 35vw"
        alt="Detalhe interno do WindyCity com nicho de trabalho, bancada, banco embutido e cozinha em pedra clara ao lado"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <div class="wrap">
    {
      tipos.map((t, i) => (
        <article class={`tp-row ${i % 2 ? 'is-alt' : ''}`}>
          <figure class="tp-fig" style={`--esc:${t.esc}`}>
            {/* A escala guiada pelo scroll vai num wrapper que contém SÓ a
                imagem — a legenda fica fora dela, senão o texto de 9px
                entraria em transform e sairia borrado. */}
            <div class="tp-fig-in" data-prog data-rv-img={t.dir}>
              <Picture
                src={t.img}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={t.widths}
                sizes={t.sizes}
                alt={t.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="tp-il label">Imagens meramente ilustrativas</figcaption>
          </figure>

          <div class="tp-txt">
            <h3 class="tp-h3" data-rv>
              {t.titulo}
            </h3>
            <p class="tp-p" data-rv style="--d:90ms">
              {t.texto}
            </p>
            <ul class="tp-list" data-rv="fade" style="--d:170ms">
              {t.itens.map((it) => (
                <li>
                  <span class="tp-mk" aria-hidden="true" />
                  <span>{it}</span>
                </li>
              ))}
            </ul>
            {/* O data-rv fica no invólucro, não no <a>: [data-rv].is-in escreve
                em transform e, por ordem de fonte, venceria o .btn:hover —
                o botão perderia o levantar de 2px no hover. */}
            <div class="tp-cta-hold" data-rv style="--d:260ms">
              <a class="btn tp-cta" href={waHref()}>
                <span>{t.cta}</span>
                <svg class="arw" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M2 8h11m0 0L9 4m4 4l-4 4"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))
    }

    <div class="tp-fecho">
      <div class="tp-fecho-rule" data-rv="fade" aria-hidden="true"></div>
      <p class="tp-claim">
        <span data-rv>Diferentes formas de ocupar.</span>
        <span data-rv style="--d:130ms">A mesma qualidade de projeto.</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* ---------- Abertura ---------- */
  .tp-head {
    margin-bottom: clamp(10px, 1.5vw, 20px);
  }
  .tp-head .h2-xl {
    /* "ch" precisa ir no próprio h2: em .tp-head (16px) o "ch" saía ~4x
       mais estreito do que no h2 (78px), quebrando o título cedo demais. */
    max-width: 20ch;
    margin-bottom: 24px;
  }
  .tp-body {
    max-width: 52ch;
  }

  /* Em telas largas o parágrafo sai de baixo do título e passa a apoiá-lo
     pela direita, alinhado pela base — a abertura vira uma linha só. */
  @media (min-width: 1000px) {
    .tp-head {
      display: grid;
      grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
      gap: clamp(40px, 5vw, 96px);
      align-items: end;
    }
    .tp-head .h2-xl {
      margin-bottom: 0;
    }
    .tp-body {
      max-width: 44ch;
      padding-bottom: 0.4em;
    }
  }

  /* ---------- Faixa fotográfica comum ---------- */
  .tp-faixa {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(8px, 1.4vw, 20px);
    margin-top: clamp(40px, 6vw, 84px);
    margin-bottom: clamp(6px, 1.5vw, 24px);
  }
  .tp-ft {
    position: relative;
    overflow: hidden;
    background: var(--marrom-08);
  }
  .tp-ft :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tp-ft--a {
    grid-column: 1 / -1;
    height: clamp(200px, 50vw, 330px);
  }
  .tp-ft--b,
  .tp-ft--c {
    height: clamp(148px, 36vw, 250px);
  }

  @media (min-width: 861px) {
    /* Três peças numa linha, com alturas e alturas de partida diferentes:
       a base fica irregular de propósito, pra faixa não ler como "três
       thumbs iguais". O parallax (--py, só desktop) reforça o desencontro. */
    .tp-faixa {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.94fr) minmax(0, 1.02fr);
      align-items: start;
    }
    .tp-ft--a {
      grid-column: auto;
      height: clamp(290px, 38vh, 470px);
    }
    .tp-ft--b {
      height: clamp(320px, 44vh, 520px);
      margin-top: clamp(24px, 4vw, 70px);
    }
    .tp-ft--c {
      height: clamp(240px, 31vh, 390px);
      margin-top: clamp(50px, 7vw, 120px);
    }
  }

  /* ---------- Os dois blocos ---------- */
  .tp-row {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(30px, 6vw, 96px);
    align-items: center;
    padding-block: clamp(46px, 7vw, 100px);
    border-top: 1px solid var(--rule);
  }
  .tp-row:first-of-type {
    margin-top: clamp(34px, 5vw, 70px);
  }
  .tp-row.is-alt {
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
  }
  .tp-row.is-alt .tp-fig {
    order: 2;
    margin-left: auto;
  }

  /* A planta tem fundo branco no arquivo. `multiply` faz o branco virar
     exatamente a cor da seção — a planta flutua sem nenhuma moldura. */
  .tp-fig {
    position: relative;
    width: var(--esc, 100%);
    mix-blend-mode: multiply;
  }
  .tp-fig :global(img) {
    width: 100%;
    height: auto;
  }

  /* Aproximação guiada pelo scroll: a planta chega 7% menor e alcança o
     tamanho natural quando está no meio da tela — o clamp trava em 1, então
     ela NUNCA passa da própria caixa (nenhum risco de estouro lateral).
     Com prefers-reduced-motion o driver publica --prog:1 e isso já resolve
     em scale(1), sem precisar de regra extra. */
  .tp-fig-in {
    transform: scale(clamp(0.93, calc(0.93 + var(--prog, 0) * 0.14), 1));
    transform-origin: center center;
  }

  .tp-il {
    position: absolute;
    right: 0;
    bottom: -4px;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--marrom-50);
  }

  .tp-h3 {
    font-size: clamp(1.3rem, 2.4vw, 2.05rem);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.026em;
    margin-bottom: 16px;
    max-width: 18ch;
  }
  .tp-p {
    font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
    line-height: 1.62;
    color: var(--fg-soft);
    margin-bottom: 30px;
    max-width: 46ch;
  }

  /* Lista como pauta: fio em cima de cada item E embaixo do último, pra
     fechar o bloco. É o que torna Studio e Garden comparáveis linha a
     linha, mesmo com quantidades diferentes de itens. */
  .tp-list {
    display: grid;
    margin-bottom: 34px;
    border-bottom: 1px solid var(--rule);
  }
  .tp-list li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--fg-soft);
    opacity: 0;
    transform: translate3d(0, 9px, 0);
    transition:
      opacity 0.55s var(--ease-out),
      transform 0.55s var(--ease-out);
  }
  /* A <ul> carrega o data-rv="fade" (só opacidade, sem transform próprio);
     o movimento fica por conta dos itens, um atrás do outro. */
  .tp-list.is-in li {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
  .tp-list.is-in li:nth-child(1) {
    transition-delay: 180ms;
  }
  .tp-list.is-in li:nth-child(2) {
    transition-delay: 250ms;
  }
  .tp-list.is-in li:nth-child(3) {
    transition-delay: 320ms;
  }
  .tp-list.is-in li:nth-child(4) {
    transition-delay: 390ms;
  }
  .tp-list.is-in li:nth-child(5) {
    transition-delay: 460ms;
  }

  .tp-mk {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--verde);
    margin-top: 7px;
  }
  .tp-cta-hold {
    display: flex;
  }
  .tp-cta {
    align-self: flex-start;
  }

  /* ---------- Fecho ---------- */
  .tp-fecho {
    margin-top: clamp(46px, 6vw, 78px);
  }
  /* O fio é desenhado da esquerda para a direita quando o fecho aparece.
     A escala vai no ::after porque o próprio elemento já é alvo do
     [data-rv], que escreve em transform. */
  .tp-fecho-rule {
    position: relative;
    height: 1px;
  }
  .tp-fecho-rule::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--rule);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.1s var(--ease-out);
  }
  .tp-fecho-rule.is-in::after {
    transform: scaleX(1);
  }

  .tp-claim {
    padding-top: clamp(34px, 4vw, 54px);
    font-size: clamp(1.3rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.028em;
    line-height: 1.16;
    text-wrap: balance;
    color: var(--fg-soft);
  }
  .tp-claim span {
    display: block;
    max-width: 22ch;
  }
  /* A segunda frase é a tese da seção — ela fica em contraste cheio e
     deslocada, pra não empatar com a primeira. */
  .tp-claim span + span {
    color: var(--fg);
  }
  @media (min-width: 861px) {
    .tp-claim span + span {
      margin-left: clamp(40px, 7vw, 150px);
    }
  }

  @media (max-width: 940px) {
    .tp-row,
    .tp-row.is-alt {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .tp-row.is-alt .tp-fig {
      order: 0;
      margin-left: 0;
    }
    .tp-cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tp-list li {
      opacity: 1 !important;
      transform: none !important;
      transition-delay: 0ms !important;
    }
    .tp-fig-in,
    .tp-fecho-rule::after {
      transform: none;
    }
  }
</style>
