---
/* Cena de vídeo conduzida pelo scroll — mesma mecânica da hero: o vídeo
   não toca sozinho, o `currentTime` é puxado pelo avanço do scroll dentro
   de uma cena alta com filho sticky. Ao terminar, a cena é liberada e o
   conteúdo seguinte entra.

   O arquivo de 1920 é pesado (15 MB), então:
   - `preload="none"` + troca de `src` só quando a cena se aproxima;
   - variante de 960px para telas pequenas (7 MB);
   - nada é baixado por quem nunca chega nesta dobra. */
---

<section class="prox" aria-label="Vídeo das proximidades do WindyCity">
  <div class="prox-cena" data-prox>
    <div class="prox-fixo" data-prox-fixo>
      <video
        class="prox-video"
        data-prox-video
        muted
        playsinline
        preload="none"
        aria-hidden="true"
        data-src-desktop="/video/proximidades-1920.mp4"
        data-src-mobile="/video/proximidades-960.mp4"></video>

      <!-- Véu de base: costura a saída do vídeo com o bloco seguinte -->
      <div class="prox-veu" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .prox {
    position: relative;
    background: var(--preto);
  }
  /* Cena alta: o percurso extra é o que dá "duração" ao vídeo no scroll.
     A velocidade percebida é a razão entre os 12s do arquivo e esse
     percurso — alongar a cena deixa o vídeo mais lento SEM tocar no vídeo
     (nada de frames extras, nada de peso a mais). Descontada a tela fixa,
     500svh dão 4 telas de percurso útil, ~2,5x o que havia antes. */
  .prox-cena {
    height: 500svh;
    position: relative;
  }
  .prox-fixo {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--preto);
  }
  .prox-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .prox-veu {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 22%;
    background: linear-gradient(to bottom, transparent, var(--preto));
    pointer-events: none;
  }

  /* No celular a cena ocupa 60vh em vez da tela inteira: em tela estreita
     o vídeo é vertical demais e come a dobra toda. O percurso de scroll
     acompanha, para a velocidade de reprodução não mudar. */
  @media (max-width: 900px) {
    .prox-cena {
      height: 300vh;
    }
    .prox-fixo {
      height: 60vh;
    }
  }

  /* Movimento reduzido: sem cena alta e sem scrubbing — o vídeo vira um
     quadro estático de altura normal. */
  @media (prefers-reduced-motion: reduce) {
    .prox-cena {
      height: auto;
    }
    .prox-fixo {
      position: static;
      height: min(72svh, 620px);
    }
  }
</style>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  const cena = document.querySelector<HTMLElement>('[data-prox]');
  const video = document.querySelector<HTMLVideoElement>('[data-prox-video]');

  if (cena && video) {
    /* A fonte só é atribuída quando a cena se aproxima: sem isso o
       navegador buscaria os metadados do arquivo pesado já no load. */
    aoAproximar(
      cena,
      () => {
        const estreita = matchMedia('(max-width: 900px)').matches;
        const fonte = estreita
          ? video.dataset.srcMobile
          : video.dataset.srcDesktop;
        if (!fonte) return;
        video.preload = 'auto';
        video.src = fonte;

        if (reduzMovimento()) {
          /* Sem scrubbing: mostra um quadro representativo e para por aí. */
          video.addEventListener(
            'loadedmetadata',
            () => {
              video.currentTime = Math.min(1, video.duration / 2);
            },
            { once: true }
          );
          return;
        }

        let duracao = 0;
        /* Safari/iOS não repinta um vídeo que nunca entrou em "playing"
           quando o currentTime é movido por script — o play/pause mudo
           destrava o decodificador (mesmo tratamento da hero). */
        let ligado = false;
        const ligar = () => {
          if (ligado) return;
          ligado = true;
          const p = video.play();
          if (p && typeof p.then === 'function') {
            p.then(() => video.pause()).catch(() => {
              ligado = false;
            });
          } else {
            video.pause();
          }
        };

        video.addEventListener('loadedmetadata', () => {
          if (isFinite(video.duration) && video.duration > 0) duracao = video.duration;
          ligar();
          desenhar();
        });

        let pedido = false;
        const desenhar = () => {
          pedido = false;
          if (duracao <= 0) return;
          const r = cena.getBoundingClientRect();
          /* O percurso é a altura da cena menos a do QUADRO FIXO — não a da
             janela: no celular o quadro tem 60vh, e usar innerHeight faria o
             vídeo terminar antes do fim da cena. */
          const fixo = cena.querySelector<HTMLElement>('[data-prox-fixo]');
          const curso = cena.offsetHeight - (fixo?.offsetHeight ?? window.innerHeight);
          const p = curso > 0 ? Math.min(Math.max(-r.top / curso, 0), 1) : 0;
          // -0.02 evita travar um quadro antes do fim em navegadores que
          // arredondam currentTime para cima do duration e ignoram o seek
          const alvo = Math.min(p * duracao, duracao - 0.02);
          if (Math.abs(video.currentTime - alvo) > 0.01) video.currentTime = alvo;
        };
        const agendar = () => {
          if (pedido) return;
          pedido = true;
          requestAnimationFrame(desenhar);
        };

        addEventListener('scroll', agendar, { passive: true });
        addEventListener('resize', agendar, { passive: true });
        agendar();
      },
      '900px'
    );
  }
</script>
