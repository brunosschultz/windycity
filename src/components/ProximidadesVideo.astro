---
/* Cena de vídeo conduzida pelo scroll — mesma mecânica da hero: o vídeo
   não toca sozinho, o `currentTime` é puxado pelo avanço do scroll dentro
   de uma cena alta com filho sticky. Ao terminar, a cena é liberada e o
   conteúdo seguinte entra.

   O arquivo de 1920 é pesado (18 MB), então:
   - `preload="none"` + troca de `src` só quando a cena se aproxima;
   - variante de 960px para telas pequenas (8 MB);
   - nada é baixado por quem nunca chega nesta dobra.

   CODIFICAÇÃO — ao trocar o vídeo, os arquivos PRECISAM ser gerados para
   scrub, não para assistir. Scrub é seek contínuo, e seek custa decodificar
   tudo desde o keyframe anterior. Com o padrão do avconvert (1 keyframe por
   segundo = 30 quadros), cada seek custava até 29 decodificações: no iOS o
   AVFoundation mascarava, mas o MediaCodec do Android esvazia o decodificador
   a cada seek e a cena travava por completo.
   Receita atual: keyframe a cada 4 quadros (0,17s), sem B-frames, 24fps.
   O avconvert não expõe GOP; foi feito com AVAssetWriter
   (AVVideoMaxKeyFrameIntervalKey + AVVideoAllowFrameReordering:NO).
   Resultado: ~10x menos decodificação por seek E arquivos MENORES que os
   anteriores (8,3 MB contra 12,4 no mobile; 17,9 contra 26,7 no desktop),
   porque sem B-frames e a 24fps sobra bitrate para o que importa. */
---

<section class="prox" aria-label="Vídeo das proximidades do WindyCity">
  <div class="prox-cena" data-prox>
    <div class="prox-fixo" data-prox-fixo>
      <video
        class="prox-video"
        data-prox-video
        muted
        playsinline
        preload="none"
        aria-hidden="true"
        data-src-desktop="/video/proximidades-1920.mp4"
        data-src-mobile="/video/proximidades-960.mp4"></video>

    </div>
  </div>
</section>

<style>
  .prox {
    position: relative;
    background: var(--preto);
  }
  /* Cena alta: o percurso extra é o que dá "duração" ao vídeo no scroll.
     A velocidade percebida é a razão entre os 22s do arquivo e esse
     percurso — alongar a cena deixa o vídeo mais lento SEM tocar no vídeo
     (nada de frames extras, nada de peso a mais). Descontada a tela fixa,
     500svh dão 4 telas de percurso útil.
     ATENÇÃO ao trocar o arquivo: com 22s em vez de 12s, cada tela de scroll
     avança 5,5s de vídeo em vez de 3,0s. Se o corte novo NÃO for o mesmo
     conteúdo retimado mais devagar, é aqui que se recupera o ritmo. */
  .prox-cena {
    height: 500svh;
    position: relative;
  }
  .prox-fixo {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--preto);
  }
  .prox-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* No celular a cena ocupa 60vh em vez da tela inteira: em tela estreita
     o vídeo é vertical demais e come a dobra toda. O percurso de scroll
     acompanha, para a velocidade de reprodução não mudar. */
  @media (max-width: 900px) {
    .prox-cena {
      height: 300vh;
    }
    /* 60vh travados no MEIO da tela: com top:0 sobrava uma faixa preta de
       40vh embaixo, que lia como falha em vez de enquadramento. */
    .prox-fixo {
      height: 60vh;
      top: 20vh;
    }
  }

  /* Movimento reduzido: sem cena alta e sem scrubbing — o vídeo vira um
     quadro estático de altura normal. */
  @media (prefers-reduced-motion: reduce) {
    .prox-cena {
      height: auto;
    }
    .prox-fixo {
      position: static;
      height: min(72svh, 620px);
    }
  }
</style>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  const cena = document.querySelector<HTMLElement>('[data-prox]');
  const video = document.querySelector<HTMLVideoElement>('[data-prox-video]');

  if (cena && video) {
    /* A fonte só é atribuída quando a cena se aproxima: sem isso o
       navegador buscaria os metadados do arquivo pesado já no load. */
    aoAproximar(
      cena,
      () => {
        const estreita = matchMedia('(max-width: 900px)').matches;
        const fonte = estreita
          ? video.dataset.srcMobile
          : video.dataset.srcDesktop;
        if (!fonte) return;
        video.preload = 'auto';
        video.src = fonte;

        if (reduzMovimento()) {
          /* Sem scrubbing: mostra um quadro representativo e para por aí. */
          video.addEventListener(
            'loadedmetadata',
            () => {
              video.currentTime = Math.min(1, video.duration / 2);
            },
            { once: true }
          );
          return;
        }

        let duracao = 0;
        /* Safari/iOS não repinta um vídeo que nunca entrou em "playing"
           quando o currentTime é movido por script — o play/pause mudo
           destrava o decodificador (mesmo tratamento da hero). */
        let ligado = false;
        const ligar = () => {
          if (ligado) return;
          ligado = true;
          const p = video.play();
          if (p && typeof p.then === 'function') {
            p.then(() => video.pause()).catch(() => {
              ligado = false;
            });
          } else {
            video.pause();
          }
        };

        video.addEventListener('loadedmetadata', () => {
          if (isFinite(video.duration) && video.duration > 0) duracao = video.duration;
          ligar();
          desenhar();
        });

        /* Um seek por vez. O rAF pede posição nova até 60x por segundo, mas
           mover o currentTime enquanto o anterior ainda não terminou faz o
           Chrome do Android descartar o pedido e esvaziar o decodificador a
           cada vez — é daí que vem o engasgo e o quadro que "passa sem
           aparecer". No iOS o seek do AVFoundation é rápido o bastante para
           mascarar isso; no MediaCodec, não.
           Guardando só o ÚLTIMO alvo pendente, o vídeo anda no ritmo que o
           aparelho aguenta em vez de acumular fila. */
        let buscando = false;
        let pendente: number | null = null;
        let iniciouBusca = 0;
        let medivel = false;

        /* Só entra na média o seek que caiu em trecho JÁ bufferizado. Seek em
           trecho não baixado demora por rede, não por decodificação — sem
           esta guarda, um iPhone ótimo em conexão ruim seria rebaixado para
           o modo "tocar" por um problema que não é dele. */
        const bufferizado = (t: number) => {
          const b = video.buffered;
          for (let i = 0; i < b.length; i++) {
            if (t >= b.start(i) && t <= b.end(i)) return true;
          }
          return false;
        };

        const irPara = (t: number) => {
          if (buscando) {
            pendente = t;
            return;
          }
          buscando = true;
          medivel = bufferizado(t);
          iniciouBusca = performance.now();
          video.currentTime = t;
        };

        /* Plano B: se o aparelho não dá conta de raspar, ele TOCA.
           Reduzir a decodificação por seek em 10x (GOP de 30 para 4 quadros)
           melhorou pouco no Android — sinal de que o que sobrou é o custo
           FIXO de cada seek, o flush do MediaCodec, que independe de quantos
           quadros vêm depois. Contra isso não existe codificação que salve:
           só não fazer seek. Decodificação linear é justamente para o que o
           hardware foi construído, e roda lisa em qualquer aparelho.

           A escolha é medida, não farejada por user-agent: Android bom
           continua raspando, e aparelho ruim de QUALQUER plataforma cai para
           reprodução. O preço é perder o controle pelo dedo onde o scrub não
           funcionava mesmo. */
        const LIMITE_MS = 50; // ~20 atualizações/s: abaixo disso já é engasgo
        const MIN_AMOSTRAS = 8;
        let amostras: number[] = [];
        let modo: 'raspar' | 'tocar' = 'raspar';
        let medido = 0;

        const trocarParaTocar = () => {
          if (modo === 'tocar') return;
          modo = 'tocar';
          pendente = null;
          const fixo = cena.querySelector<HTMLElement>('[data-prox-fixo]');
          const io = new IntersectionObserver(
            (entradas) => {
              for (const e of entradas) {
                if (e.isIntersecting) {
                  if (video.ended) video.currentTime = 0;
                  video.play().catch(() => {});
                } else {
                  video.pause();
                }
              }
            },
            { threshold: 0.15 }
          );
          io.observe(fixo ?? cena);
        };

        const aoBuscar = () => {
          buscando = false;
          if (modo === 'raspar' && iniciouBusca && medivel) {
            amostras.push(performance.now() - iniciouBusca);
            if (amostras.length > 10) amostras.shift();
            if (amostras.length >= MIN_AMOSTRAS) {
              const ord = [...amostras].sort((a, b) => a - b);
              const mediana = ord[Math.floor(ord.length / 2)];
              medido = mediana;
              if (mediana > LIMITE_MS) {
                trocarParaTocar();
                return;
              }
            }
          }
          if (pendente === null) return;
          const t = pendente;
          pendente = null;
          irPara(t);
        };
        video.addEventListener('seeked', aoBuscar);
        // se o seek falhar, não trava o scrub para sempre
        video.addEventListener('error', () => {
          buscando = false;
        });

        /* Leitura no próprio aparelho com ?debug=video — bug que só aparece
           no celular se resolve com medida, não com chute. */
        if (new URLSearchParams(location.search).get('debug') === 'video') {
          const painel = document.createElement('div');
          painel.setAttribute(
            'style',
            'position:fixed;left:8px;bottom:8px;z-index:9999;background:#000c;' +
              'color:#0f0;font:11px/1.4 monospace;padding:6px 8px;border-radius:4px'
          );
          document.body.append(painel);
          setInterval(() => {
            painel.textContent =
              `modo: ${modo} · seek mediana: ${medido.toFixed(0)}ms ` +
              `(limite ${LIMITE_MS}) · amostras: ${amostras.length}`;
          }, 400);
        }

        let pedido = false;
        const desenhar = () => {
          pedido = false;
          // no modo "tocar" o scroll não manda mais no currentTime
          if (duracao <= 0 || modo === 'tocar') return;
          /* Progresso medido pelo deslocamento do QUADRO FIXO dentro da
             cena: enquanto ele está travado, essa distância vai de 0 até o
             percurso útil. Ler assim vale para qualquer `top` de sticky —
             no celular o quadro trava a 20vh, não no topo. */
          const fixo = cena.querySelector<HTMLElement>('[data-prox-fixo]');
          if (!fixo) return;
          const rc = cena.getBoundingClientRect();
          const rf = fixo.getBoundingClientRect();
          const curso = cena.offsetHeight - fixo.offsetHeight;
          const p = curso > 0 ? Math.min(Math.max((rf.top - rc.top) / curso, 0), 1) : 0;
          // -0.02 evita travar um quadro antes do fim em navegadores que
          // arredondam currentTime para cima do duration e ignoram o seek
          const alvo = Math.min(p * duracao, duracao - 0.02);
          /* Zona morta de ~1 quadro (24fps = 0,042s): abaixo disso o seek não
             muda nada na tela e só gasta decodificador. Era 0.01s — um quarto
             de quadro, ou seja, seek jogado fora. */
          if (Math.abs(video.currentTime - alvo) > 0.04) irPara(alvo);
        };
        const agendar = () => {
          if (pedido) return;
          pedido = true;
          requestAnimationFrame(desenhar);
        };

        addEventListener('scroll', agendar, { passive: true });
        addEventListener('resize', agendar, { passive: true });
        agendar();
      },
      '900px'
    );
  }
</script>
