---
import { Picture, getImage } from 'astro:assets';
import ComparativoDif from './ComparativoDif.astro';
import CenaCompacto from './CenaCompacto.astro';
import plantaSol from '../assets/images/planta-sol.png';
import solJanela from '../assets/images/sol-janela.png';

/* Planta do pavimento usada dentro do esquema: entra como <image> do SVG
   (e não como <Picture>) para viver na mesma caixa de coordenadas das
   fachadas e do arco do sol. */
const plantaSrc = (await getImage({ src: plantaSol, width: 900, format: 'webp' })).src;
---

<section class="section dif" id="diferenciais" aria-labelledby="dif-t">
  <!-- ============================================================
       ATO 1 · Comparativo mercado × WindyCity — composição única de
       duas colunas sobre fundo claro (coluna esquerda sticky, trilha
       de fotografias à direita) fechando em imagem arquitetônica ampla.
       O tema claro fica no próprio bloco; os atos seguintes seguem
       escuros, então cada trecho carrega seus tokens.
       ============================================================ -->
  <div class="theme-bege dif-claro">
    <ComparativoDif />
  </div>

  <div class="theme-preto dif-escuro">
    <!-- ============================================================
       ATO 2 · Demonstração em camadas: foto interna de fundo escurecida
       por véu de token, diagrama SVG sobreposto como camada técnica e
       texto por cima. O diagrama se desenha com ScrollTrigger (scrub
       curto); sem JS ou com reduced-motion ele está completo no HTML.
       ============================================================ -->
  <!-- Dobra dividida ao meio: à esquerda um bloco verde chapado com o
       argumento; à direita, fundo branco, a planta do pavimento em escala
       maior, com Leste e Oeste centralizados em cada lado dela e o sol
       cruzando por cima. -->
  <div class="demo">
    <div class="demo-txt">
      <div class="demo-bg" aria-hidden="true">
        <Picture
          src={solJanela}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[560, 800, 1100, 1254]}
          sizes="(max-width: 980px) 100vw, 50vw"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
      {/* Véu preto: a foto tem áreas muito claras (cortina, janela) e o
          texto precisa de contraste independente de onde caia o recorte. */}
      <div class="demo-veu" aria-hidden="true"></div>

      <div class="demo-txt-in">
        <h3 class="demo-h3" data-rv>
          Unidades paralelas à face de <em class="ac">iluminação</em>
        </h3>
        <p class="demo-p" data-rv style="--d:120ms">
          Cada unidade foi implantada com o lado mais longo encostado diretamente na fachada leste ou
          oeste — o esquema não é perpendicular, é paralelo a ela. A janela acompanha toda a extensão
          da unidade, e não apenas uma abertura no fim de um corredor interno. Isso garante luz
          natural em todos os cômodos do estúdio, sem exceção, e ventilação em todos os ambientes.
        </p>
      </div>
    </div>

    <figure class="demo-fig" data-demo-diagrama>
      <svg viewBox="0 0 320 350" role="img" aria-labelledby="arch-desc">
        <title id="arch-desc">
          Planta do pavimento: unidades implantadas com o lado mais longo paralelo às fachadas leste
          e oeste, corredor central entre elas, e o percurso do sol de leste a oeste passando sobre
          o edifício
        </title>

        <!-- trajetória do sol (só referência; o sol anda sobre ela) -->
        <path
          id="dg-arco"
          class="dg-arco"
          d="M24 56 A 224 224 0 0 1 296 56"
          fill="none"
          stroke="rgba(65,55,55,.22)"
          stroke-width="1"
          stroke-dasharray="2 5"></path>

        <g class="dg-sol" data-sol>
          <circle r="17" fill="url(#dg-brilho)"></circle>
          <circle r="6" fill="#e8a33c"></circle>
        </g>

        <!-- planta do pavimento -->
        <image
          class="dg-planta"
          href={plantaSrc}
          x="40"
          y="62"
          width="240"
          height="280"
          preserveAspectRatio="xMidYMid meet"></image>

        <!-- Leste e Oeste centralizados na altura da planta, um de cada lado -->
        <text class="ax dg-l" x="18" y="206" text-anchor="middle">LESTE</text>
        <text class="ax dg-l" x="302" y="206" text-anchor="middle">OESTE</text>

        <defs>
          <radialGradient id="dg-brilho">
            <stop offset="0%" stop-color="#f2b350" stop-opacity="0.6" />
            <stop offset="100%" stop-color="#f2b350" stop-opacity="0" />
          </radialGradient>
        </defs>
      </svg>
    </figure>
  </div>

    <!-- ATO 3 · Cena da luz (frase-síntese sobre mídia em 100svh) -->
    <CenaCompacto />
  </div>
</section>

<style>
  /* ================================================================
     Base = mobile. Composições de tela grande entram em
     @media (min-width: 981px) como progressive enhancement.
     ================================================================ */
  /* A seção não pinta fundo próprio: cada trecho carrega o seu, porque a
     dobra comparativa é clara e as seguintes são escuras. O padding do topo
     fica no bloco claro e o do pé é zero (a cena final encosta na próxima). */
  .dif {
    padding-block: 0;
    background: none;
  }
  /* O respiro do topo mora no próprio comparativo: em duas colunas ele
     precisa ser exatamente o `top` da coluna sticky, para a composição já
     nascer na posição em que vai ficar parada. */
  .dif-claro {
    background: var(--bg);
    color: var(--fg);
  }
  .dif-escuro {
    background: var(--bg);
    color: var(--fg);
  }

  /* ---------- Ato 2 · Metade verde | metade branca ----------
     À esquerda o argumento sobre verde chapado; à direita a planta sobre
     branco. Sem fotografia de fundo: o esquema é a peça gráfica da dobra. */
  .demo {
    display: grid;
    min-height: 100svh;
    background: var(--branco);
  }
  .demo-txt {
    position: relative;
    isolation: isolate;
    color: var(--bege);
    display: flex;
    align-items: center;
    padding: clamp(48px, 8vw, 96px) var(--gutter);
    background: var(--preto);
    /* tokens escuros para o texto sobre a fotografia */
    --fg: var(--bege);
    --acento: #45b37c;
  }
  .demo-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .demo-bg :global(picture) {
    display: block;
    height: 100%;
  }
  .demo-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* o casal e a janela ficam à direita do quadro; o texto cai sobre a
       parte mais calma da cena */
    object-position: 66% 50%;
  }
  .demo-veu {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgb(1 8 17 / 88%) 0%,
      rgb(1 8 17 / 72%) 48%,
      rgb(1 8 17 / 46%) 100%
    );
  }
  /* Caixa de leitura estreita: a coluna toda tinha largura de parágrafo
     longo demais para o corpo do texto. */
  .demo-txt-in {
    max-width: 34ch;
  }
  .demo-h3 {
    font-size: clamp(1.95rem, 5.4vw, 3.05rem);
    font-weight: 800;
    line-height: 1.03;
    letter-spacing: -0.032em;
    text-wrap: balance;
    margin-bottom: clamp(16px, 2.4vw, 26px);
    color: var(--bege);
  }
  .demo-p {
    font-size: clamp(0.95rem, 1.2vw, 1.0625rem);
    line-height: 1.62;
    color: var(--bege-80);
  }

  .demo-fig {
    margin: 0;
    display: grid;
    place-items: center;
    padding: clamp(28px, 5vw, 72px) clamp(16px, 3vw, 56px);
  }
  .demo-fig svg {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: block;
  }
  /* Sobre branco, os rótulos vão no marrom da marca */
  .demo-fig :global(.ax) {
    font-family: 'Sora', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    fill: var(--marrom);
  }
  /* O sol nasce parado no leste; sem JS/movimento reduzido fica ali. */
  .dg-sol {
    transform: translate(24px, 56px);
  }

  /* ---------------- Desktop ---------------- */
  @media (min-width: 981px) {
    .demo {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* O movimento restante desta seção é GSAP e já fica atrás de
     reduzMovimento(); o comparativo trata o próprio reduced-motion. */
</style>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  /* ATO 2 — o diagrama se constrói conforme o scroll se aproxima dele:
     fachadas leste/oeste se desenham (stroke-dashoffset), unidades surgem
     e os rótulos em seguida. Estado inicial escondido SÓ via gsap.set —
     sem JS ou com reduced-motion o SVG está completo no HTML. */
  const diagrama = document.querySelector<HTMLElement>('[data-demo-diagrama]');
  if (diagrama) {
    aoAproximar(diagrama, async () => {
      if (reduzMovimento()) return;

      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      const planta = diagrama.querySelectorAll('.dg-planta');
      const rotulos = diagrama.querySelectorAll('.dg-l');

      gsap.set([...planta, ...rotulos], { opacity: 0 });

      gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: diagrama,
            start: 'top 85%',
            end: 'top 30%',
            scrub: 0.6,
          },
        })
        .to(planta, { opacity: 1, duration: 0.6 })
        .to(rotulos, { opacity: 1, duration: 0.35, stagger: 0.06 }, '<');

      /* ---------- Percurso do sol ----------
         O sol anda sobre o próprio arco desenhado no SVG: em vez de
         aproximar a curva na mão, lemos os pontos do <path> com
         getPointAtLength — assim o traço e o percurso nunca divergem.
         A travessia é conduzida pelo scroll (scrub) ao longo de toda a
         cena, e a fachada iluminada acompanha o lado em que o sol está. */
      const arco = diagrama.querySelector<SVGPathElement>('#dg-arco');
      const sol = diagrama.querySelector<SVGGElement>('[data-sol]');
      const [rotL, rotO] = [...diagrama.querySelectorAll<SVGTextElement>('.dg-l')];

      if (arco && sol) {
        const total = arco.getTotalLength();
        const estado = { p: 0 };
        const posicionar = () => {
          const pt = arco.getPointAtLength(estado.p * total);
          gsap.set(sol, { x: pt.x, y: pt.y });
          /* nascente à esquerda, poente à direita: o rótulo do lado em que
             o sol está fica cheio, o oposto recua */
          if (rotL) gsap.set(rotL, { opacity: 0.35 + (1 - estado.p) * 0.65 });
          if (rotO) gsap.set(rotO, { opacity: 0.35 + estado.p * 0.65 });
        };
        posicionar();

        gsap.to(estado, {
          p: 1,
          ease: 'none',
          onUpdate: posicionar,
          scrollTrigger: {
            trigger: diagrama.closest('.demo'),
            start: 'top bottom',
            end: 'bottom top',
            scrub: 0.8,
          },
        });
      }
    });
  }
</script>
