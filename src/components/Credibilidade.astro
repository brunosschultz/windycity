---
import { Picture } from 'astro:assets';
import LogoGirassol from './LogoGirassol.astro';
import { VIDEO_INSTITUCIONAL } from '../config';
import { waHref } from '../config';
import thumbVideo from '../assets/images/thumb-video.png';
import girassolProposito from '../assets/images/girassol-proposito.png';
import fachadaDia from '../assets/images/fachada-dia-hd.jpg';
import fachadaNoite from '../assets/images/fachada-noite-hd.jpg';
import { EMPREENDIMENTO } from '../config';

/* `pendente` = dado que o próprio wireframe marca como a confirmar. */
const stats = [
  { valor: String(EMPREENDIMENTO.unidades), count: EMPREENDIMENTO.unidades, label: 'unidades no empreendimento' },
  { valor: String(EMPREENDIMENTO.walkScore), count: EMPREENDIMENTO.walkScore, label: 'Walk Score da região' },
  { valor: EMPREENDIMENTO.comercializado, label: 'das unidades já comercializadas' },
  {
    valor: `${EMPREENDIMENTO.anosEquipe} anos`,
    count: EMPREENDIMENTO.anosEquipe,
    sufixo: 'anos',
    label: 'de experiência combinada da equipe técnica',
  },
];

---

<section class="section theme-preto cr" id="girassol" aria-labelledby="gi-t">
  <!-- ============ 1 · ABERTURA ============
       O título não fica AO LADO da foto: ele atravessa a foto. A torre em
       contra-plongée sangra até a borda direita em ~92svh; um véu lateral
       (preto → transparente) funde a foto ao fundo da seção e garante a
       leitura das palavras que pousam sobre o céu. As linhas do h2 sobem
       uma a uma via GSAP (estado inicial escondido SÓ via JS). -->
  <div class="wrap">
    <div class="cr-abre">
      <p class="eyebrow" data-rv>Conheça a Girassol</p>

      <h2 class="h2-xl cr-titulo" id="gi-t">
        <span class="cr-tl"><span>Por que</span></span>
        <span class="cr-tl cr-tl--rec"><span><em class="ac">confiar</em></span></span>
        <span class="cr-tl"><span>na Girassol?</span></span>
      </h2>

      <p class="body cr-body" data-rv style="--d:140ms">
        A Girassol é formada por profissionais com experiência em planejamento, construção e gestão
        de empreendimentos. A marca é recente — a experiência, não. Aqui, o contato com quem decide é
        direto: sem coordenador do coordenador.
      </p>

      {/* Peça composta da incorporadora, não fotografia: traz texto e o
          símbolo do girassol embutidos, sobre fundo transparente. Por isso
          NÃO leva parallax (data-px) nem recorte por `cover` — deslocar ou
          cortar uma arte com texto a mutila. O texto é branco e só existe
          por cima do transparente, então ela depende do fundo escuro da
          seção para ser lida; aqui isso está garantido pelo theme-preto. */}
      <figure class="cr-abre-fig cr-abre-fig--arte bleed-r" data-rv-img="cima">
        <Picture
          src={girassolProposito}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1400, 1650]}
          sizes="(max-width: 900px) 100vw, 52vw"
          alt="Uma incorporadora com Propósito. Transformar cidades. Transformar espaços. Transformar vidas. Ao lado, a fachada do WindyCity vista de baixo e o símbolo do girassol da Girassol Incorporações."
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>

  <!-- ============ 2 · CENA DA PROVA ============
       Sticky storytelling: a fachada fica presa em tela cheia passando do
       dia para a noite (crossfade guiado por --prog), enquanto os 4 números
       avançam por cima em etapas — fotografia fixa, dados progredindo.
       O véu inferior (tokens de preto) garante a leitura dos stats.
       As etapas são GSAP+ScrollTrigger só no desktop; no mobile os stats
       ficam visíveis desde o início, por cima do véu. -->
  <div class="cr-cena cena-alta" data-prog="pin">
    <div class="cena-fixa cr-palco">
      <figure class="cr-ciclo cena-zoom">
        <Picture
          src={fachadaDia}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[760, 1100, 1500, 1920, 2560]}
          sizes="100vw"
          alt="Fachada completa do WindyCity em vista diurna, com jardineiras nas varandas"
          loading="lazy"
          decoding="async"
        />
        <span class="cr-noite" aria-hidden="true">
          <Picture
            src={fachadaNoite}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[760, 1100, 1500, 1920, 2560]}
            sizes="100vw"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
      </figure>

      {/* Assinatura da incorporadora ao centro do palco: entra junto com a
          progressão dos números (ver script), fechando a leitura de prova. */}
      <div class="cr-selo" data-cr-selo aria-hidden="true"><LogoGirassol /></div>

      <ul class="stats">
        {
          stats.map((s) => (
            <li class="stat">
              <i class="stat-fio" aria-hidden="true" />
              <span class={`stat-n ${s.pendente ? 'is-pend' : ''}`}>
                {s.count ? <span data-count={s.count}>0</span> : s.valor}
                {s.sufixo && <span class="stat-suf">{s.sufixo.trim()}</span>}
              </span>
              <span class="stat-l">{s.label}</span>
              {s.nota && <span class="stat-nota">{s.nota}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- ============ 3 · PILARES ============
       Composição editorial em diagonal: dois blocos de tipografia e fio,
       desencontrados no grid — sem card, sem caixa. -->
  <div class="wrap">
    <div class="cr-pilares">
      <div class="pilar pilar-1" data-rv>
        <h3 class="h3 pilar-t">Histórico</h3>
        <p class="pilar-p">
          Experiência construída ao longo de décadas em planejamento, construção e gestão de
          empreendimentos.
        </p>
      </div>
      <div class="pilar pilar-2" data-rv style="--d:120ms">
        <h3 class="h3 pilar-t">Atendimento próximo</h3>
        <p class="pilar-p">Contato direto com quem decide — inclusive no pós-obra, sem intermediários.</p>
      </div>
    </div>

    <!-- ============ 4 · VÍDEO INSTITUCIONAL ============
         Enquadramento recomposto: a imagem sangra só à esquerda e a legenda
         sai de cima da foto para uma coluna própria, ancorada na base. -->
    <figure class="cr-vrow">
      {/* Capa + play. Com VIDEO_INSTITUCIONAL preenchido, o play é um <button>
          que troca a capa pelo player do YouTube e pede tela cheia. Sem ID, o
          bloco volta a ser capa estática e o play deixa de ser botão — um
          botão que não faz nada ao ser clicado é pior do que nenhum.
          O `data-px` (parallax) sai quando há vídeo: deslocar o quadro com um
          player dentro cortaria os controles. */}
      <div
        class="cr-vmedia"
        data-px={VIDEO_INSTITUCIONAL ? undefined : '80'}
        data-rv-img="esq"
        data-video={VIDEO_INSTITUCIONAL ?? undefined}
      >
        <Picture
          src={thumbVideo}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[760, 1100, 1327]}
          sizes="(max-width: 900px) 100vw, 76vw"
          alt="Capa do vídeo institucional da Girassol Incorporações"
          loading="lazy"
          decoding="async"
        />
        {
          VIDEO_INSTITUCIONAL ? (
            <button class="cr-play" type="button" data-play>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
                <path d="M9 7.5 17 12l-8 4.5v-9Z" stroke-linejoin="round" />
              </svg>
              <span class="sr-only">Assistir ao vídeo institucional</span>
            </button>
          ) : (
            <span class="cr-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1">
                <path d="M9 7.5 17 12l-8 4.5v-9Z" stroke-linejoin="round" />
              </svg>
            </span>
          )
        }
      </div>
      <figcaption class="cr-vcap" data-rv>
        <span class="cr-vtit">Vídeo institucional</span>
        <span class="cr-vsub">Fundadores apresentando a Girassol e o WindyCity</span>
      </figcaption>
    </figure>

    <div class="cr-cta" data-rv>
      <a class="btn btn--light" href={waHref()}>
        <span>Saiba mais</span>
        <svg class="arw" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M2 8h11m0 0L9 4m4 4l-4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  /* Clique no play: a capa dá lugar ao player do YouTube, no mesmo quadro.
     O iframe é criado SÓ aqui — antes do clique nada do YouTube é carregado,
     nenhum script de terceiro e nenhum cookie. Por isso também o domínio
     `youtube-nocookie`. */
  const quadro = document.querySelector<HTMLElement>('[data-video]');
  const botao = quadro?.querySelector<HTMLButtonElement>('[data-play]');
  if (quadro && botao) {
    botao.addEventListener('click', () => {
      const id = quadro.dataset.video;
      if (!id) return;

      const ifr = document.createElement('iframe');
      ifr.className = 'cr-vplayer';
      ifr.src =
        `https://www.youtube-nocookie.com/embed/${id}` +
        '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
      ifr.title = 'Vídeo institucional da Girassol Incorporações';
      ifr.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      ifr.allowFullscreen = true;
      ifr.setAttribute('frameborder', '0');

      quadro.classList.add('is-tocando');
      quadro.append(ifr);
      /* Sem pedir tela cheia. A chamada anterior colocava o CONTÊINER em
         fullscreen, mas o iframe continuava dimensionado pela caixa antiga:
         dava tela preta com o vídeo pequeno num canto. Tela cheia agora é
         escolha do usuário, pelo botão do próprio player — que já sabe se
         redimensionar. `allowFullscreen` continua ligado para isso. */
    });
  }

  const secao = document.querySelector<HTMLElement>('#girassol');
  if (secao) {
    aoAproximar(secao, async () => {
      if (reduzMovimento()) return; // sem movimento: tudo já está visível
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      /* 1 · Título: as linhas sobem de dentro das máscaras (overflow no
         wrapper estático; o esconder é feito AQUI, nunca no CSS). */
      const linhas = secao.querySelectorAll<HTMLElement>('.cr-tl > span');
      if (linhas.length) {
        gsap.set(linhas, { yPercent: 112 });
        gsap.to(linhas, {
          yPercent: 0,
          duration: 1.15,
          ease: 'power4.out',
          stagger: 0.1,
          scrollTrigger: {
            trigger: secao.querySelector('.cr-abre'),
            start: 'top 74%',
            once: true,
          },
        });
      }

      /* 2 · Cena da prova (só desktop): os 4 números entram em etapas
         enquanto a fachada cruza do dia para a noite. gsap.matchMedia
         cuida de criar/reverter tudo ao cruzar o breakpoint. */
      const mm = gsap.matchMedia();
      mm.add('(min-width: 901px)', () => {
        const cena = secao.querySelector<HTMLElement>('.cr-cena');
        const itens = gsap.utils.toArray<HTMLElement>('.cr-cena .stat');
        if (!cena || !itens.length) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: cena,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.35,
          },
        });

        itens.forEach((el, i) => {
          const fio = el.querySelector('.stat-fio');
          const conteudo = el.querySelectorAll('.stat-n, .stat-l, .stat-nota');
          const t = 0.06 + i * 0.2;
          if (fio) {
            tl.fromTo(
              fio,
              { scaleX: 0, transformOrigin: 'left center' },
              { scaleX: 1, duration: 0.1, ease: 'none' },
              t
            );
          }
          tl.fromTo(
            conteudo,
            { autoAlpha: 0, y: 34 },
            { autoAlpha: 1, y: 0, duration: 0.14, ease: 'none' },
            t + 0.02
          );
        });
        /* A assinatura da Girassol acompanha a progressão: nasce discreta
           com o primeiro número e chega inteira junto com o último. Estado
           inicial só via JS — sem script o selo está lá, visível. */
        const selo = cena.querySelector<HTMLElement>('[data-cr-selo]');
        if (selo) {
          tl.fromTo(
            selo,
            { autoAlpha: 0, scale: 0.9 },
            { autoAlpha: 1, scale: 1, duration: 0.62, ease: 'none' },
            0.06
          );
        }

        /* respiro final: o último número assenta antes da cena soltar */
        tl.to({}, { duration: 0.16 });
      });
    });
  }
</script>

<style>
  .cr {
    padding-bottom: clamp(70px, 9vw, 130px);
  }

  /* ---------- 1 · Abertura: título atravessando a foto ---------- */
  .cr-abre {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 0;
  }
  .cr-abre .eyebrow {
    grid-column: 1;
  }
  .cr-titulo {
    position: relative;
    z-index: 2; /* por cima da foto no desktop */
    font-size: clamp(2.7rem, 8vw, 8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: clamp(22px, 3vw, 40px);
  }
  .cr-tl {
    display: block;
    overflow: hidden;
  }
  .cr-tl > span {
    display: block;
    /* respiro para descendentes da itálica não serem decapitados pela máscara */
    padding-bottom: 0.09em;
    margin-bottom: -0.09em;
  }
  /* linha recuada: escadinha editorial */
  .cr-tl--rec {
    padding-left: clamp(20px, 6vw, 130px);
  }
  .cr-body {
    max-width: 46ch;
  }
  .cr-abre-fig {
    position: relative;
    overflow: hidden;
    height: clamp(320px, 58svh, 560px);
    margin-top: clamp(26px, 4vw, 48px);
  }
  .cr-abre-fig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 68%; /* letreiro na metade inferior: nunca cortar */
  }
  /* A arte é exibida INTEIRA e na proporção original: a caixa assume o
     formato dela, então não sobra letterbox nem falta pedaço. */
  .cr-abre-fig--arte {
    height: auto;
    aspect-ratio: 1650 / 1350;
    /* Anula o respiro que separa a abertura da cena seguinte: a arte encosta
       na base, emendando direto no topo do bloco de baixo. Vale nas duas
       larguras — no mobile ela já ocupa a tela de borda a borda. */
    margin-bottom: calc(var(--cr-vao) * -1);
  }
  .cr-abre-fig--arte :global(img) {
    height: auto;
    object-fit: contain;
    object-position: center;
  }
  /* O véu lateral existia para fundir uma FOTOGRAFIA ao preto e proteger a
     leitura do título. Sobre a arte ele cairia justamente em cima do texto
     branco, que já vem com o respiro embutido na composição. */
  .cr-abre-fig--arte::after {
    display: none;
  }

  /* Acento do título: só NESTA seção o verde dá lugar ao degradê do girassol
     da arte ao lado. Os dois tons foram amostrados da própria peça — a
     pétala vai de #F8AB00 a #F39200 — em vez de escolhidos no olho.
     A cor sólida vem primeiro como base: se `background-clip: text` não for
     suportado, o texto continua legível em amarelo em vez de sumir. */
  .cr-titulo .ac {
    color: #f8ab00;
  }
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .cr-titulo .ac {
      background: linear-gradient(100deg, #f8ab00 0%, #f39200 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }
  /* véu lateral: funde a foto ao fundo preto e segura a leitura do título */
  .cr-abre-fig::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgba(1, 8, 17, 0.86),
      rgba(1, 8, 17, 0.4) 34%,
      rgba(1, 8, 17, 0) 64%
    );
  }

  /* ---------- 2 · Cena da prova ---------- */
  /* Respiro entre a abertura e a cena. Guardado em variável porque a arte
     do girassol precisa anular exatamente este valor para encostar na cena
     — se os dois números vivessem separados, sairiam de sincronia. */
  .cr {
    --cr-vao: clamp(56px, 9vw, 140px);
  }
  .cr-cena {
    height: 165svh;
    margin-top: var(--cr-vao);
  }
  .cr-palco {
    background: var(--preto);
  }
  .cr-ciclo {
    position: absolute;
    inset: 0;
    z-index: 0;
    --zoom: 0.03;
  }
  .cr-ciclo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }
  /* a noite cruza por cima conforme a cena avança (termina antes do fim) */
  .cr-noite {
    position: absolute;
    inset: 0;
    display: block;
    opacity: min(1, calc(var(--prog, 0) * 1.18));
    will-change: opacity;
  }
  /* véu de leitura dos números: constante, tokens de preto */
  .cr-palco::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to top,
        rgba(1, 8, 17, 0.92) 0%,
        rgba(1, 8, 17, 0.55) 26%,
        rgba(1, 8, 17, 0) 58%
      ),
      linear-gradient(to bottom, rgba(1, 8, 17, 0.38), rgba(1, 8, 17, 0) 22%);
  }
  /* Assinatura da incorporadora: centro exato do palco, escala grande */
  .cr-selo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 2;
  }
  .cr-selo :global(svg) {
    width: clamp(160px, 26vw, 360px);
    height: auto;
    max-width: none;
    opacity: 0.92;
    filter: drop-shadow(0 10px 40px rgba(1, 8, 17, 0.6));
  }
  .stats {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(24px, 6vh, 64px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(18px, 3vw, 44px) 20px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stat-fio {
    display: block;
    height: 1px;
    background: var(--bege-40);
    margin-bottom: 6px;
  }
  .stat-n {
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(2.4rem, 5.4vw, 5.8rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--bege);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .stat-n.is-pend {
    font-size: clamp(1.3rem, 2.6vw, 2.4rem);
    color: var(--bege-60);
  }
  /* "anos" ao lado do número, na mesma linha de base */
  .stat-suf {
    margin-left: 0.18em;
  }
  .stat-l {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--bege-80);
    max-width: 18ch;
  }
  .stat-nota {
    font-size: 0.6875rem;
    font-style: italic;
    color: var(--verde);
  }

  /* ---------- 3 · Pilares em diagonal ---------- */
  .cr-pilares {
    margin-top: clamp(64px, 9vw, 140px);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    row-gap: clamp(36px, 6vw, 72px);
  }
  .pilar {
    position: relative;
    grid-column: 1 / -1;
    padding-top: clamp(16px, 2vw, 26px);
  }
  /* fio que se desenha quando o bloco entra (via .is-in do contrato data-rv) */
  .pilar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--bege-40);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.9s var(--ease-out);
    transition-delay: var(--d, 0ms);
  }
  .pilar.is-in::before {
    transform: scaleX(1);
  }
  .pilar-t {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .pilar-p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--bege-60);
    max-width: 38ch;
  }

  button.cr-play {
    cursor: pointer;
  }
  button.cr-play:focus-visible {
    outline: 2px solid var(--bege);
    outline-offset: 3px;
  }
  /* Com o player em cena, a capa e o play saem */
  .cr-vmedia.is-tocando :global(picture),
  .cr-vmedia.is-tocando .cr-play {
    display: none;
  }
  /* Serve ao <iframe> do YouTube. Sem `object-fit`: iframe não é mídia
     substituída — quem cuida do enquadramento é o player. Em tela cheia o
     quadro vira o container, e as barras pretas do YouTube ficam por conta
     dele, não do nosso layout. */
  /* `:global` é obrigatório aqui: o iframe é criado por JS em tempo de
     execução e por isso NÃO recebe o atributo data-astro-cid-* que o Astro
     usa para escopar o CSS. Sem isso a regra nunca casava e o iframe ficava
     no tamanho padrão do navegador — 300x150 num quadro bem maior, ou seja,
     tela preta com o vídeo pequeno num canto. */
  :global(.cr-vplayer) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--preto);
  }

  /* ---------- 4 · Vídeo institucional ---------- */
  .cr-vrow {
    margin-top: clamp(72px, 10vw, 150px);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 28px);
  }
