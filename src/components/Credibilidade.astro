---
import { Picture } from 'astro:assets';
import LogoGirassol from './LogoGirassol.astro';
import poster from '../assets/images/fachada-02.png';
import torre from '../assets/images/fachada-baixo.jpg';
import fachadaDia from '../assets/images/fachada-dia-hd.jpg';
import fachadaNoite from '../assets/images/fachada-noite-hd.jpg';
import { EMPREENDIMENTO } from '../config';

/* `pendente` = dado que o próprio wireframe marca como a confirmar. */
const stats = [
  { valor: String(EMPREENDIMENTO.unidades), count: EMPREENDIMENTO.unidades, label: 'unidades no empreendimento' },
  { valor: String(EMPREENDIMENTO.walkScore), count: EMPREENDIMENTO.walkScore, label: 'Walk Score da região' },
  { valor: EMPREENDIMENTO.comercializado, label: 'das unidades já comercializadas' },
  {
    valor: `${EMPREENDIMENTO.anosEquipe} anos`,
    count: EMPREENDIMENTO.anosEquipe,
    sufixo: 'anos',
    label: 'de experiência combinada da equipe técnica',
  },
];

---

<section class="section theme-preto cr" id="girassol" aria-labelledby="gi-t">
  <!-- ============ 1 · ABERTURA ============
       O título não fica AO LADO da foto: ele atravessa a foto. A torre em
       contra-plongée sangra até a borda direita em ~92svh; um véu lateral
       (preto → transparente) funde a foto ao fundo da seção e garante a
       leitura das palavras que pousam sobre o céu. As linhas do h2 sobem
       uma a uma via GSAP (estado inicial escondido SÓ via JS). -->
  <div class="wrap">
    <div class="cr-abre">
      <p class="eyebrow" data-rv>Conheça a Girassol</p>

      <h2 class="h2-xl cr-titulo" id="gi-t">
        <span class="cr-tl"><span>Por que</span></span>
        <span class="cr-tl cr-tl--rec"><span><em class="ac">confiar</em></span></span>
        <span class="cr-tl"><span>na Girassol?</span></span>
      </h2>

      <p class="body cr-body" data-rv style="--d:140ms">
        A Girassol é formada por profissionais com experiência em planejamento, construção e gestão
        de empreendimentos. A marca é recente — a experiência, não. Aqui, o contato com quem decide é
        direto: sem coordenador do coordenador.
      </p>

      <figure class="cr-abre-fig bleed-r" data-px="60" data-rv-img="cima">
        <Picture
          src={torre}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1400, 2000]}
          sizes="(max-width: 900px) 100vw, 62vw"
          alt="Fachada do WindyCity vista de baixo para cima, com o letreiro windycity na base e as varandas recortadas contra o céu"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>

  <!-- ============ 2 · CENA DA PROVA ============
       Sticky storytelling: a fachada fica presa em tela cheia passando do
       dia para a noite (crossfade guiado por --prog), enquanto os 4 números
       avançam por cima em etapas — fotografia fixa, dados progredindo.
       O véu inferior (tokens de preto) garante a leitura dos stats.
       As etapas são GSAP+ScrollTrigger só no desktop; no mobile os stats
       ficam visíveis desde o início, por cima do véu. -->
  <div class="cr-cena cena-alta" data-prog="pin">
    <div class="cena-fixa cr-palco">
      <figure class="cr-ciclo cena-zoom">
        <Picture
          src={fachadaDia}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[760, 1100, 1500, 1920, 2560]}
          sizes="100vw"
          alt="Fachada completa do WindyCity em vista diurna, com jardineiras nas varandas"
          loading="lazy"
          decoding="async"
        />
        <span class="cr-noite" aria-hidden="true">
          <Picture
            src={fachadaNoite}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[760, 1100, 1500, 1920, 2560]}
            sizes="100vw"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </span>
      </figure>

      {/* Assinatura da incorporadora ao centro do palco: entra junto com a
          progressão dos números (ver script), fechando a leitura de prova. */}
      <div class="cr-selo" data-cr-selo aria-hidden="true"><LogoGirassol /></div>

      <ul class="stats">
        {
          stats.map((s) => (
            <li class="stat">
              <i class="stat-fio" aria-hidden="true" />
              <span class={`stat-n ${s.pendente ? 'is-pend' : ''}`}>
                {s.count ? <span data-count={s.count}>0</span> : s.valor}
                {s.sufixo && <span class="stat-suf">{s.sufixo.trim()}</span>}
              </span>
              <span class="stat-l">{s.label}</span>
              {s.nota && <span class="stat-nota">{s.nota}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- ============ 3 · PILARES ============
       Composição editorial em diagonal: dois blocos de tipografia e fio,
       desencontrados no grid — sem card, sem caixa. -->
  <div class="wrap">
    <div class="cr-pilares">
      <div class="pilar pilar-1" data-rv>
        <h3 class="h3 pilar-t">Histórico</h3>
        <p class="pilar-p">
          Experiência construída ao longo de décadas em planejamento, construção e gestão de
          empreendimentos.
        </p>
      </div>
      <div class="pilar pilar-2" data-rv style="--d:120ms">
        <h3 class="h3 pilar-t">Atendimento próximo</h3>
        <p class="pilar-p">Contato direto com quem decide — inclusive no pós-obra, sem intermediários.</p>
      </div>
    </div>

    <!-- ============ 4 · VÍDEO INSTITUCIONAL ============
         Enquadramento recomposto: a imagem sangra só à esquerda e a legenda
         sai de cima da foto para uma coluna própria, ancorada na base. -->
    <figure class="cr-vrow">
      <div class="cr-vmedia" data-px="80" data-rv-img="esq">
        <Picture
          src={poster}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[760, 1100, 1500, 1920]}
          sizes="(max-width: 900px) 100vw, 76vw"
          alt="Fachada do WindyCity vista da calçada, com pessoas circulando na rua"
          loading="lazy"
          decoding="async"
        />
        <span class="cr-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1">
            <path d="M9 7.5 17 12l-8 4.5v-9Z" stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>
      <figcaption class="cr-vcap" data-rv>
        <span class="cr-vtit">Vídeo institucional</span>
        <span class="cr-vsub">Fundadores apresentando a Girassol e o WindyCity</span>
      </figcaption>
    </figure>

    <div class="cr-cta" data-rv>
      <a class="btn btn--light" href="#contato">
        <span>Saiba mais</span>
        <svg class="arw" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M2 8h11m0 0L9 4m4 4l-4 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  const secao = document.querySelector<HTMLElement>('#girassol');
  if (secao) {
    aoAproximar(secao, async () => {
      if (reduzMovimento()) return; // sem movimento: tudo já está visível
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      /* 1 · Título: as linhas sobem de dentro das máscaras (overflow no
         wrapper estático; o esconder é feito AQUI, nunca no CSS). */
      const linhas = secao.querySelectorAll<HTMLElement>('.cr-tl > span');
      if (linhas.length) {
        gsap.set(linhas, { yPercent: 112 });
        gsap.to(linhas, {
          yPercent: 0,
          duration: 1.15,
          ease: 'power4.out',
          stagger: 0.1,
          scrollTrigger: {
            trigger: secao.querySelector('.cr-abre'),
            start: 'top 74%',
            once: true,
          },
        });
      }

      /* 2 · Cena da prova (só desktop): os 4 números entram em etapas
         enquanto a fachada cruza do dia para a noite. gsap.matchMedia
         cuida de criar/reverter tudo ao cruzar o breakpoint. */
      const mm = gsap.matchMedia();
      mm.add('(min-width: 901px)', () => {
        const cena = secao.querySelector<HTMLElement>('.cr-cena');
        const itens = gsap.utils.toArray<HTMLElement>('.cr-cena .stat');
        if (!cena || !itens.length) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: cena,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.35,
          },
        });

        itens.forEach((el, i) => {
          const fio = el.querySelector('.stat-fio');
          const conteudo = el.querySelectorAll('.stat-n, .stat-l, .stat-nota');
          const t = 0.06 + i * 0.2;
          if (fio) {
            tl.fromTo(
              fio,
              { scaleX: 0, transformOrigin: 'left center' },
              { scaleX: 1, duration: 0.1, ease: 'none' },
              t
            );
          }
          tl.fromTo(
            conteudo,
            { autoAlpha: 0, y: 34 },
            { autoAlpha: 1, y: 0, duration: 0.14, ease: 'none' },
            t + 0.02
          );
        });
        /* A assinatura da Girassol acompanha a progressão: nasce discreta
           com o primeiro número e chega inteira junto com o último. Estado
           inicial só via JS — sem script o selo está lá, visível. */
        const selo = cena.querySelector<HTMLElement>('[data-cr-selo]');
        if (selo) {
          tl.fromTo(
            selo,
            { autoAlpha: 0, scale: 0.9 },
            { autoAlpha: 1, scale: 1, duration: 0.62, ease: 'none' },
            0.06
          );
        }

        /* respiro final: o último número assenta antes da cena soltar */
        tl.to({}, { duration: 0.16 });
      });
    });
  }
</script>

<style>
  .cr {
    padding-bottom: clamp(70px, 9vw, 130px);
  }

  /* ---------- 1 · Abertura: título atravessando a foto ---------- */
  .cr-abre {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 0;
  }
  .cr-abre .eyebrow {
    grid-column: 1;
  }
  .cr-titulo {
    position: relative;
    z-index: 2; /* por cima da foto no desktop */
    font-size: clamp(2.7rem, 8vw, 8rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: clamp(22px, 3vw, 40px);
  }
  .cr-tl {
    display: block;
    overflow: clip;
  }
  .cr-tl > span {
    display: block;
    /* respiro para descendentes da itálica não serem decapitados pela máscara */
    padding-bottom: 0.09em;
    margin-bottom: -0.09em;
  }
  /* linha recuada: escadinha editorial */
  .cr-tl--rec {
    padding-left: clamp(20px, 6vw, 130px);
  }
  .cr-body {
    max-width: 46ch;
  }
  .cr-abre-fig {
    position: relative;
    overflow: clip;
    height: clamp(320px, 58svh, 560px);
    margin-top: clamp(26px, 4vw, 48px);
  }
  .cr-abre-fig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 68%; /* letreiro na metade inferior: nunca cortar */
  }
  /* véu lateral: funde a foto ao fundo preto e segura a leitura do título */
  .cr-abre-fig::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgba(1, 8, 17, 0.86),
      rgba(1, 8, 17, 0.4) 34%,
      rgba(1, 8, 17, 0) 64%
    );
  }

  /* ---------- 2 · Cena da prova ---------- */
  .cr-cena {
    height: 165svh;
    margin-top: clamp(56px, 9vw, 140px);
  }
  .cr-palco {
    background: var(--preto);
  }
  .cr-ciclo {
    position: absolute;
    inset: 0;
    z-index: 0;
    --zoom: 0.03;
  }
  .cr-ciclo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 38%;
  }
  /* a noite cruza por cima conforme a cena avança (termina antes do fim) */
  .cr-noite {
    position: absolute;
    inset: 0;
    display: block;
    opacity: min(1, calc(var(--prog, 0) * 1.18));
    will-change: opacity;
  }
  /* véu de leitura dos números: constante, tokens de preto */
  .cr-palco::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to top,
        rgba(1, 8, 17, 0.92) 0%,
        rgba(1, 8, 17, 0.55) 26%,
        rgba(1, 8, 17, 0) 58%
      ),
      linear-gradient(to bottom, rgba(1, 8, 17, 0.38), rgba(1, 8, 17, 0) 22%);
  }
  /* Assinatura da incorporadora: centro exato do palco, escala grande */
  .cr-selo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    z-index: 2;
  }
  .cr-selo :global(svg) {
    width: clamp(160px, 26vw, 360px);
    height: auto;
    max-width: none;
    opacity: 0.92;
    filter: drop-shadow(0 10px 40px rgba(1, 8, 17, 0.6));
  }
  .stats {
    position: absolute;
    z-index: 2;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(24px, 6vh, 64px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(18px, 3vw, 44px) 20px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stat-fio {
    display: block;
    height: 1px;
    background: var(--bege-40);
    margin-bottom: 6px;
  }
  .stat-n {
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(2.4rem, 5.4vw, 5.8rem);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--bege);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .stat-n.is-pend {
    font-size: clamp(1.3rem, 2.6vw, 2.4rem);
    color: var(--bege-60);
  }
  /* "anos" ao lado do número, na mesma linha de base */
  .stat-suf {
    margin-left: 0.18em;
  }
  .stat-l {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--bege-80);
    max-width: 18ch;
  }
  .stat-nota {
    font-size: 0.6875rem;
    font-style: italic;
    color: var(--verde);
  }

  /* ---------- 3 · Pilares em diagonal ---------- */
  .cr-pilares {
    margin-top: clamp(64px, 9vw, 140px);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    row-gap: clamp(36px, 6vw, 72px);
  }
  .pilar {
    position: relative;
    grid-column: 1 / -1;
    padding-top: clamp(16px, 2vw, 26px);
  }
  /* fio que se desenha quando o bloco entra (via .is-in do contrato data-rv) */
  .pilar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--bege-40);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.9s var(--ease-out);
    transition-delay: var(--d, 0ms);
  }
  .pilar.is-in::before {
    transform: scaleX(1);
  }
  .pilar-t {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .pilar-p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--bege-60);
    max-width: 38ch;
  }

  /* ---------- 4 · Vídeo institucional ---------- */
  .cr-vrow {
    margin-top: clamp(72px, 10vw, 150px);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 28px);
  }
  .cr-vmedia {
    position: relative;
    overflow: clip;
    height: clamp(300px, 54svh, 520px);
    margin-inline: calc(var(--gutter) * -1);
  }
  .cr-vmedia :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  .cr-vmedia::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(1, 8, 17, 0.5), rgba(1, 8, 17, 0) 40%);
    pointer-events: none;
  }
  .cr-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: clamp(64px, 8vw, 104px);
    aspect-ratio: 1;
    border: 1px solid var(--bege-40);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--bege);
    background: rgba(1, 8, 17, 0.26);
    transition:
      transform 0.5s var(--ease),
      background-color 0.4s ease,
      border-color 0.4s ease;
  }
  .cr-play svg {
    width: 42%;
    height: 42%;
  }
  .cr-vcap {
    display: grid;
    gap: 6px;
    padding-top: clamp(14px, 2vw, 20px);
    border-top: 1px solid var(--bege-40);
    color: var(--bege);
  }
  .cr-vcap .label {
    color: var(--bege);
  }
  .cr-vtit {
    display: block;
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--fg);
    margin-bottom: 8px;
  }
  .cr-vsub {
    font-size: 0.875rem;
    color: var(--bege-60);
  }
  @media (hover: hover) {
    .cr-vmedia:hover .cr-play {
      transform: translate(-50%, -50%) scale(1.07);
      background: rgba(239, 230, 226, 0.14);
      border-color: var(--bege);
    }
  }
  @media (hover: hover) {
  }

  .cr-cta {
    display: flex;
    margin-top: clamp(56px, 8vw, 110px);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 901px) {
    .cr-abre {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
      align-content: center;
      column-gap: clamp(24px, 3vw, 56px);
      min-height: 92svh;
    }
    .cr-abre .eyebrow {
      grid-row: 1;
      align-self: end;
    }
    .cr-titulo {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .cr-body {
      grid-column: 1;
      grid-row: 3;
      align-self: start;
      margin-top: clamp(18px, 2.6vw, 36px);
    }
    .cr-abre-fig {
      grid-column: 2;
      grid-row: 1 / span 3;
      height: clamp(520px, 92svh, 1000px);
      margin-top: 0;
      align-self: center;
    }

    .cr-cena {
      height: 280svh;
    }
    .cr-ciclo {
      --zoom: 0.055;
    }
    .stats {
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(20px, 3vw, 44px);
      bottom: clamp(36px, 8vh, 88px);
    }

    .pilar-1 {
      grid-column: 1 / span 5;
    }
    .pilar-2 {
      grid-column: 8 / span 5;
      margin-top: clamp(56px, 9vw, 160px);
    }

    .cr-vrow {
      grid-template-columns: minmax(0, 1fr) clamp(190px, 20vw, 300px);
      column-gap: clamp(24px, 3.4vw, 64px);
      align-items: end;
    }
    .cr-vmedia {
      margin-inline: 0;
      margin-left: calc(var(--sangria) * -1); /* sangra só à esquerda */
      height: clamp(420px, 80vh, 820px);
    }
    .cr-vcap {
      padding-bottom: clamp(8px, 1vw, 18px);
    }
  }

  @media (max-width: 900px) {
    .cr-abre-fig {
      margin-inline: calc(var(--gutter) * -1); /* foto de borda a borda */
    }
    .cr-cta .btn {
      width: 100%;
    }
  }

  /* ---------- Sem movimento ----------
     A cena deixa de ser alta e de prender: vira uma foto normal (só o DIA,
     nunca meio-transparente — quem lê o alt vê exatamente essa imagem)
     seguida dos números estáticos sobre o fundo preto. Fios visíveis. */
  @media (prefers-reduced-motion: reduce) {
    .cr-cena {
      height: auto;
    }
    .cr-ciclo {
      position: relative;
      inset: auto;
      aspect-ratio: 16 / 9;
    }
    .cr-noite {
      opacity: 0;
    }
    .cr-palco::after {
      display: none;
    }
    .stats {
      position: static;
      margin-top: clamp(28px, 4vw, 48px);
      padding-inline: var(--gutter);
    }
    /* "anos" ao lado do número, na mesma linha de base */
  .stat-suf {
    margin-left: 0.18em;
  }
  .stat-l {
      color: var(--bege-60);
    }
    .stat-fio,
    .pilar::before {
      transform: none;
    }
  }
</style>
