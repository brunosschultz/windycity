---
import { Picture } from 'astro:assets';
import { EMPREENDIMENTO } from '../config';
import MapaLocalizacao from './MapaLocalizacao.astro';
import ProximidadesVideo from './ProximidadesVideo.astro';

/* A mídia de abertura é a fachada com a rua e o ponto de ônibus à vista —
   o mesmo enquadramento em que o vídeo de drone vai nascer antes de subir
   e revelar a região. Usar aqui a foto aérea da Arena repetiria, poucos
   blocos abaixo, exatamente a imagem do ponto 01. */
import aberturaRua from '../assets/images/fachada-dia-hd.jpg';
import arena from '../assets/images/loc-arena.jpg';
import mobilidade from '../assets/images/loc-mobilidade.jpg';
import pucpr from '../assets/images/loc-pucpr.jpg';
/* Fachada do Unicuritiba — arquivo trazido da pasta de imagens do outro
   projeto da agência (era o único no computador). Se a origem não for a
   pretendida, basta substituir este arquivo. */
import unicuritiba from '../assets/images/loc-unicuritiba.jpg';
import shopping from '../assets/images/loc-shopping.jpg';
import restaurante from '../assets/images/loc-restaurante.jpg';
import farmacia from '../assets/images/loc-farmacia.jpg';

/* =====================================================================
   PLACEHOLDER Walk Score: substituir por foto definitiva do entorno —
   trocar SÓ este import quando a imagem final chegar (o recorte vertical
   e o object-position ficam em .score-foto, no <style> abaixo).
   ===================================================================== */
import fotoWalkScore from '../assets/images/loc-mobilidade.jpg';

/* Conteúdo do wireframe aprovado. O item 05 ("Sem vaga de garagem
   obrigatória") foi REMOVIDO por autorização expressa do cliente —
   a sequência agora é 01–04. `leg` é a identificação visível da foto
   no painel (nomes próprios reais exigidos pelo cliente). */
const pontos = [
  {
    t: 'Arena da Baixada',
    d: 'proximidade com jogos, shows e grandes eventos',
    /* `meta` é o dado objetivo do ponto, exibido sobre a fotografia no
       lugar do antigo título repetido. */
    meta: '950 m',
  },
  {
    t: 'Mobilidade',
    d: 'fácil acesso ao transporte público e eixos urbanos',
    meta: 'Ponto de ônibus em frente',
  },
  { t: 'Universidades', d: 'próximo à PUCPR e outros centros de ensino', meta: null },
  { t: 'Cotidiano', d: 'mercados, farmácias, restaurantes e serviços essenciais', meta: null },
];
---

<section class="section theme-branco loc" id="localizacao" aria-labelledby="loc-t">
  <!-- 1 · Abertura editorial: título em escala de pôster à esquerda,
       parágrafo deslocado para a coluna oposta, rente à base do título.
       O parágrafo carrega o texto aprovado INTEIRO — a sobreposição da
       foto abaixo é o endereço do empreendimento, não um trecho dele. -->
  <header class="wrap loc-abre">
    <p class="eyebrow" data-rv>Localização</p>
    <h2 class="h2-xl loc-titulo" id="loc-t" data-rv style="--d:40ms">
      Viva a cidade com mais <em class="ac">autonomia</em>
    </h2>
    <p class="lede loc-lede" data-rv style="--d:90ms">
      O WindyCity está em uma região conectada a transporte, universidades, serviços, lazer e aos
      principais movimentos de Curitiba — com ponto de ônibus em frente e menor dependência do
      carro.
    </p>
  </header>

  <!-- ==========================================================================
       MÍDIA PRINCIPAL DA DOBRA — bloco isolado de propósito.
       Quando o vídeo de drone (subida da fachada revelando a cidade) chegar,
       trocar SOMENTE o <Picture> abaixo por um <video autoplay muted loop
       playsinline poster="..."> com as mesmas regras de .loc-media img
       (width/height 100% + object-fit:cover). Nada mais da dobra muda:
       o parallax (data-px) e a revelação por máscara (data-rv-img) ficam no
       <figure>, e a legenda editorial (figcaption) permanece sobreposta,
       independente de a mídia ser foto ou vídeo.
       ========================================================================== -->
  <figure class="bleed loc-media" data-px="60" data-rv-img data-prog>
    <!-- data-prog alimenta --prog (0→1) durante a travessia da figura pela
         viewport; o zoom-out lê essa custom property em CSS puro. Só
         transform, sem recálculo de layout. -->
    <div class="loc-media-zoom">
      <Picture
        src={aberturaRua}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[760, 1160, 1600, 2048, 2880]}
        sizes="100vw"
        alt="Fachada do WindyCity vista da rua em dia de sol, com calçada arborizada e ponto de ônibus em frente"
        loading="lazy"
        decoding="async"
      />
    </div>
    <!-- Endereço como assinatura da imagem: escala de pôster, quebrado em
         duas linhas (logradouro + bairro/cidade) para não perder legibilidade. -->
    <figcaption class="loc-media-leg">
      <address class="loc-endereco" data-rv style="--d:160ms">
        <span class="loc-endereco-l1">Rua Conselheiro Dantas, 1287</span>
        <span class="loc-endereco-l2">Prado Velho | Curitiba/PR</span>
      </address>
    </figcaption>
  </figure>

  <!-- 3 · Scrollytelling 01–04.
       Mobile / sem JS: fluxo vertical natural — foto identificada + número
       + texto, intercalados via display:contents + order.
       Desktop com JS (classe .is-js aplicada pelo script): painel sticky
       sangrando até a borda esquerda; cada item da coluna direita percorre
       ~80svh e troca a fotografia do painel com máscara direcional (GSAP). -->
  <div class="wrap loc-scrolly-wrap">
    <div class="loc-scrolly" data-loc-scrolly>
      <div class="loc-painel">
        <figure class="loc-foto f-arena" data-foto style="--o:1" data-rv-img>
          <div class="loc-mov" data-mov>
            <Picture
              src={arena}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[520, 760, 1080, 1480, 2000]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Arena da Baixada vista de cima à noite, com a fachada iluminada em vermelho"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">{pontos[0].meta}</span>
          </figcaption>
        </figure>

        <figure class="loc-foto f-mob" data-foto style="--o:3" data-rv-img="esq">
          <div class="loc-mov" data-mov>
            <Picture
              src={mobilidade}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 760, 1080, 1536]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Estações-tubo de Curitiba com ônibus biarticulado vermelho e prédio histórico ao fundo"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">{pontos[1].meta}</span>
          </figcaption>
        </figure>

        <!-- Universidades: PUC-PR e Unicuritiba são DUAS etapas da mesma
             sequência — cada fachada ocupa o painel inteiro, como as demais,
             em vez de dividirem o quadro. O item 03 percorre o dobro de
             altura (ver .loc-item--duplo) para as duas terem o mesmo tempo
             de tela das outras. -->
        <figure class="loc-foto f-puc" data-foto style="--o:5" data-rv-img="dir">
          <div class="loc-mov" data-mov>
            <Picture
              src={pucpr}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900, 1200]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Campus da PUCPR, com bloco de fachada vermelha e passarela de acesso"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">PUC-PR</span>
          </figcaption>
        </figure>

        <figure class="loc-foto f-uni" data-foto style="--o:5" data-rv-img="dir">
          <div class="loc-mov" data-mov>
            <Picture
              src={unicuritiba}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900, 1079]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Fachada do Unicuritiba, com o volume envidraçado da entrada e o letreiro da instituição"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">Unicuritiba</span>
          </figcaption>
        </figure>

        <!-- Cotidiano reúne as três fotos de serviço, cada uma com o nome
             próprio visível (exigência do cliente). O Shopping Estação
             conduz; a farmácia é o arquivo de menor resolução (555px) e por
             isso só aparece em miniatura, recortada com cover (o recorte
             elimina os cantos arredondados embutidos no JPG). -->
        <figure class="loc-foto f-cot" data-foto style="--o:7" data-rv-img>
          <div class="loc-mov loc-colagem" data-mov>
            <div class="cot-tile cot-main">
              <Picture
                src={shopping}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[400, 640, 920, 1280]}
                sizes="(max-width: 1023px) 56vw, 32vw"
                alt="Fachada curva do Shopping Estação, com o relógio no alto"
                loading="lazy"
                decoding="async"
              />
              <span class="cot-rotulo label">Shopping Estação</span>
            </div>
            <div class="cot-tile">
              <Picture
                src={restaurante}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[280, 440, 640, 880]}
                sizes="(max-width: 1023px) 34vw, 22vw"
                alt="Fachada amarela do Restaurante Peixinho, entre palmeiras"
                loading="lazy"
                decoding="async"
              />
              <span class="cot-rotulo label">Restaurante Peixinho</span>
            </div>
            <div class="cot-tile">
              <Picture
                src={farmacia}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[240, 400, 540]}
                sizes="(max-width: 1023px) 34vw, 22vw"
                alt="Fachada de farmácia Droga Raia aberta 24 horas"
                loading="lazy"
                decoding="async"
              />
              <span class="cot-rotulo label">Droga Raia</span>
            </div>
          </div>
        </figure>
      </div>

      <ol class="loc-itens">
        {
          pontos.map((p, i) => (
            <li
              class:list={['loc-item', { 'is-ativo': i === 0, 'loc-item--duplo': i === 2 }]}
              data-item
              data-fotos={i === 2 ? 2 : 1}
              data-rv
              style={`--d:${i * 55}ms;--o:${i * 2 + 2}`}
            >
              <span class="loc-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="loc-t">{p.t}</span>
              <span class="loc-d">{p.d}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- 4 · Cena de vídeo das proximidades conduzida pelo scroll.

       MAPA OCULTO A PEDIDO DO CLIENTE (decisão temporária): o componente e
       todos os dados dele seguem no projeto, intactos. Para trazer de volta,
       basta reativar a linha abaixo — nada mais precisa mudar. -->
  <ProximidadesVideo />
  {/* <MapaLocalizacao /> */}

  <!-- 5 · Walk Score — fecho da dobra: faixa preta em sangria total, número
       gigante e régua à esquerda, fotografia em recorte vertical colada às
       bordas superior/inferior/direita da faixa (tratamento deliberadamente
       oposto ao painel largo do item 02, para a mesma foto placeholder não
       ler como repetição). -->
  <div class="score theme-preto bleed">
    <div class="wrap score-grid">
      <div class="score-num" data-rv>
        <span class="num-xl" data-count={EMPREENDIMENTO.walkScore}>0</span>
        <span class="label score-esc">de 0 a 100</span>
      </div>

      <div class="score-txt" data-rv style="--d:80ms">
        <h3 class="h3">Walk Score {EMPREENDIMENTO.walkScore}</h3>
        <p>
          Walk Score é um índice internacional que avalia, de 0 a 100, o quanto uma região permite
          viver o dia a dia a pé.
        </p>
        <p>
          Alto potencial para realizar atividades do cotidiano a pé — serviços, comércio,
          universidades e lazer próximos, com pouca ou nenhuma dependência de carro.
        </p>
      </div>

      <!-- Régua do índice: representação gráfica do valor na escala 0–100 já
           informada ao lado. Decorativa, sem texto novo. O preenchimento sai
           do mesmo EMPREENDIMENTO.walkScore do número — nunca de um % fixo no
           CSS, senão a régua desencontra do dado se o config mudar. -->
      <div
        class="score-reg"
        data-rv
        style={`--d:150ms;--pct:${EMPREENDIMENTO.walkScore}%`}
        aria-hidden="true"
      >
        <span class="score-reg-fill"></span>
      </div>

      <div class="score-cta" data-rv style="--d:200ms">
        <a class="btn btn--light" href="#contato">
          <span>Ver o entorno</span>
          <svg
            class="arw"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 8h11m0 0L9 4m4 4l-4 4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <figure class="score-foto" data-rv-img="dir">
        <!-- PLACEHOLDER Walk Score: substituir por foto definitiva do entorno — trocar SÓ este import -->
        <Picture
          src={fotoWalkScore}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 760, 1080, 1536]}
          sizes="(max-width: 1023px) 100vw, 46vw"
          alt="Estações-tubo de Curitiba com ônibus biarticulado vermelho e prédio histórico ao fundo"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  /* A faixa preta do Walk Score é o fecho: a seção termina nela, sem
     respiro branco depois (o padding-bottom padrão de .section sai). */
  .loc {
    padding-block: var(--section-y) 0;
  }

  /* ---------------- 1 · Abertura editorial ---------------- */
  .loc-abre {
    margin-bottom: clamp(30px, 4.5vw, 64px);
  }
  .loc-titulo {
    font-size: clamp(2.4rem, 7.2vw, 6.4rem);
    max-width: 13ch;
  }
  .loc-lede {
    margin-top: clamp(20px, 3.5vw, 44px);
    max-width: 44ch;
  }
  @media (min-width: 1024px) {
    .loc-abre {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      column-gap: clamp(48px, 6vw, 130px);
    }
    .loc-abre .eyebrow,
    .loc-titulo {
      grid-column: 1;
    }
    .loc-lede {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      justify-self: end;
      margin-top: 0;
      padding-bottom: 0.4em;
      max-width: 38ch;
    }
  }

  /* ---------------- 2 · Mídia principal (slot do vídeo de drone) ---------------- */
  .loc-media {
    position: relative;
    overflow: hidden;
    height: 100svh;
    background: var(--marrom-08);
  }
  /* Zoom-out conforme o scroll avança: entra ampliada e vai abrindo até a
     escala natural. Interpola 1.16 → 1.0 sobre --prog (0→1). Sem JS a
     custom property não existe e o fallback `1` entrega a imagem já aberta. */
  .loc-media-zoom {
    height: 100%;
    transform: scale(calc(1.16 - 0.16 * var(--prog, 1)));
    transform-origin: center center;
    will-change: transform;
  }
  .loc-media :global(picture) {
    display: block;
    height: 100%;
  }
  .loc-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  @media (max-width: 760px) {
    .loc-media {
      height: min(78svh, 660px);
    }
    /* em retrato, desloca o recorte para a direita: mantém o prédio e o
       ponto de ônibus (que a legenda menciona) dentro do quadro */
    .loc-media :global(img) {
      object-position: 62% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loc-media-zoom {
      transform: none;
    }
  }
  /* Endereço centralizado na altura da foto. O véu agora é radial a partir
     do centro (não mais um gradiente de base), porque o texto deixou de
     cair sobre a base escura da imagem. */
  .loc-media-leg {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-inline: var(--sangria);
    /* Gradiente HORIZONTAL, não radial: em tela de celular o radial
       produzia anéis de banding — as "linhas pontilhadas" que apareciam
       atravessando o endereço. O linear em um eixo só não banda. */
    background: linear-gradient(
      90deg,
      rgb(1 8 17 / 74%) 0%,
      rgb(1 8 17 / 62%) 32%,
      rgb(1 8 17 / 40%) 58%,
      rgb(1 8 17 / 18%) 80%,
      rgb(1 8 17 / 8%) 100%
    );
    pointer-events: none;
  }
  /* Endereço em escala de pôster sobre a fachada. A linha 1 (logradouro,
     mais longa) governa a escala: usa vw para crescer com a largura, mas
     o clamp impede que estoure a sangria em telas largas. A linha 2 é
     menor de propósito — hierarquia dentro do próprio endereço. */
  .loc-endereco {
    display: block;
    font-style: normal;
    color: #fff;
    line-height: 1.14;
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 2px 40px rgb(0 0 0 / 35%);
  }
  .loc-endereco-l1,
  .loc-endereco-l2 {
    display: block;
    font-weight: 600;
    line-height: 1.14;
  }
  .loc-endereco-l2 {
    margin-top: 0.28em;
  }
  .loc-endereco-l1 {
    font-size: clamp(1.9rem, 5.1vw, 5.4rem);
  }
  /* Bairro + cidade: 20% menor que a escala anterior desta linha, para o
     logradouro seguir sendo a informação dominante. */
  .loc-endereco-l2 {
    font-size: clamp(1.08rem, 2.72vw, 2.88rem);
    color: var(--bege);
  }

  /* ---------------- 3 · Scrollytelling ----------------
     Base (mobile e desktop sem JS): coluna única; display:contents faz
     figuras e itens virarem irmãos na mesma grade e o `order` (--o) os
     intercala — foto identificada, depois número + texto. */
  .loc-scrolly-wrap {
    margin-block: clamp(48px, 7vw, 110px);
  }
  .loc-scrolly {
    display: grid;
    max-width: 860px;
    margin-inline: auto;
  }
  .loc-painel,
  .loc-itens {
    display: contents;
  }
  .loc-itens {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .loc-foto {
    order: var(--o, 0);
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--marrom-08);
    margin-bottom: clamp(18px, 4vw, 24px);
  }
  .f-arena {
    aspect-ratio: 16 / 9;
  }
  .f-mob,
  .f-puc,
  .f-uni {
    aspect-ratio: 3 / 2;
  }
  /* O Cotidiano é um conjunto de três fotos soltas, sem moldura: nada de
     fundo, borda ou sombra atrás delas. */
  .f-cot {
    aspect-ratio: 4 / 3;
    background: none;
    overflow: visible;
    border-radius: 0;
  }
  .loc-mov {
    position: absolute;
    inset: 0;
  }
  .loc-mov :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .loc-mov :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* pontos focais auditados — nada de cover+center cego */
  .f-arena :global(img) {
    object-position: center 62%;
  }
  .f-puc :global(img) {
    object-position: 38% 50%;
  }
  .f-uni :global(img) {
    object-position: center 45%;
  }
  .cot-main :global(img) {
    object-position: center 28%;
  }

  /* colagem do Cotidiano */
  .loc-colagem {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }
  .cot-tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .cot-main {
    grid-row: 1 / span 2;
  }
  .cot-tile :global(picture) {
    position: absolute;
    inset: 0;
  }
  /* identificação visível de cada serviço (nomes reais) */
  .cot-tile .cot-rotulo {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 2;
    background: var(--preto);
    color: var(--bege);
    padding: 4px 8px;
    border-radius: var(--radius);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
  }

  /* Sobre a fotografia fica só o dado objetivo do ponto (distância,
     descrição) — o nome já é o título do item ao lado, não se repete. */
  .loc-leg {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    padding: clamp(40px, 8vw, 96px) clamp(14px, 2vw, 32px) clamp(12px, 1.8vw, 26px);
    background: linear-gradient(180deg, transparent, var(--preto) 140%);
    pointer-events: none;
  }
  .loc-leg-m {
    color: var(--bege);
    font-size: clamp(0.95rem, 1.9vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* itens 01–04 */
  .loc-item {
    order: var(--o, 0);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 6px;
    align-items: baseline;
    /* respiro generoso entre um ponto e o próximo, para cada bloco de foto
       + descrição ler como uma unidade */
    margin: 4px 0 clamp(64px, 15vw, 96px);
  }
  .loc-item:last-child {
    margin-bottom: 0;
  }
  .loc-num {
    grid-row: 1 / span 2;
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-weight: 400;
    font-variant-numeric: lining-nums;
    color: var(--verde);
    font-size: clamp(2.6rem, 9vw, 3.8rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
  }
  .loc-t {
    font-weight: 700;
    font-size: clamp(1.2rem, 4.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .loc-d {
    grid-column: 2;
    color: var(--fg-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: 44ch;
  }

  /* ---------------- 3 · Scrollytelling — desktop com JS ----------------
     .is-js só existe quando o script rodou (e sem prefers-reduced-motion):
     é ele que autoriza empilhar as fotos em absoluto dentro do painel
     sticky. Sem JS nada nasce escondido — o fluxo acima permanece. */
  @media (min-width: 1024px) {
    .loc-scrolly.is-js {
      max-width: none;
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
      column-gap: clamp(48px, 5vw, 120px);
      align-items: start;
    }
    .is-js .loc-painel {
      display: block;
      position: sticky;
      --ph: min(74svh, 40vw);
      top: calc((100svh - var(--ph)) / 2);
      height: var(--ph);
      margin-left: calc(var(--sangria) * -1);
      overflow: hidden;
      border-radius: 0 var(--radius) var(--radius) 0;
    }
    .is-js .loc-foto {
      position: absolute;
      inset: 0;
      margin: 0;
      order: 0;
      aspect-ratio: auto;
      border-radius: 0;
    }
    .is-js .loc-leg {
      padding: clamp(80px, 8vw, 150px) clamp(28px, 3vw, 56px) clamp(22px, 2.4vw, 44px);
    }
    .is-js .loc-leg-m {
      font-size: clamp(1.15rem, 1.5vw, 1.55rem);
    }
    .is-js .cot-tile .cot-rotulo {
      left: 12px;
      bottom: 12px;
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
    }
    /* Sem caixa cinza: nem o painel nem o quadro do Cotidiano pintam fundo,
       então as três fotos ficam soltas sobre o branco da seção. */
    .is-js .f-cot {
      overflow: hidden;
      background: none;
    }

    .is-js .loc-itens {
      display: block;
    }
    /* cada item percorre ~80svh: é essa altura que dá ao painel o tempo
       de ficar preso e trocar de fotografia com calma */
    .is-js .loc-item {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      min-height: 80svh;
      margin: 0;
      padding-block: clamp(28px, 4vh, 48px);
    }
    /* Universidades comanda duas fotografias: percorre o dobro para cada
       uma ficar o mesmo tempo em tela que os demais pontos. */
    .is-js .loc-item--duplo {
      min-height: 160svh;
    }
    /* Numeral discreto: deixou de ser marca-d'água em escala de pôster —
       agora só marca a etapa, e quem carrega o peso visual é o título. */
    .is-js .loc-num {
      font-size: clamp(1.6rem, 2.1vw, 2.1rem);
      line-height: 1;
      color: var(--marrom-50);
      transition: color 0.5s var(--ease);
    }
    .is-js .loc-item.is-ativo .loc-num {
      color: var(--verde);
    }
    /* Título com mais presença e afastado do numeral (antes ele subia
       -0.62em para encaixar sob o número gigante). */
    .is-js .loc-t {
      position: relative;
      z-index: 1;
      margin-top: clamp(14px, 1.6vw, 22px);
      font-size: clamp(2rem, 3.2vw, 3.1rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.05;
      opacity: 0.4;
      transition: opacity 0.45s var(--ease);
    }
    .is-js .loc-d {
      margin-top: 14px;
      font-size: 1rem;
      opacity: 0.4;
      transition: opacity 0.45s var(--ease);
    }
    .is-js .loc-item.is-ativo .loc-t,
    .is-js .loc-item.is-ativo .loc-d {
      opacity: 1;
    }
  }

  /* ---------------- 5 · Walk Score ---------------- */
  /* Colada no mapa: sem respiro branco entre as duas. */
  .score {
    margin-top: 0;
    background: var(--preto);
    color: var(--bege);
    overflow: hidden;
  }
  .score-grid {
    --padY: clamp(60px, 10vw, 120px);
    display: grid;
    gap: clamp(30px, 6vw, 48px);
    padding-block: var(--padY);
  }
  .score-num {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }
  .score-num .num-xl {
    color: var(--bege);
    font-size: clamp(5.6rem, 23vw, 15rem);
  }
  .score-esc {
    color: var(--bege-40);
    letter-spacing: 0.24em;
  }
  .score-txt {
    display: grid;
    gap: 16px;
    max-width: 46ch;
  }
  .score-txt .h3 {
    color: var(--bege);
  }
  .score-txt p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--bege-60);
  }

  /* Régua 0–100: cresce em scaleX (compositor). A largura vem de --pct,
     publicado na marcação a partir do config. */
  .score-reg {
    position: relative;
    height: 2px;
    background: var(--bege-14);
  }
  .score-reg-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pct, 92%);
    background: var(--verde);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.05s var(--ease-out) 0.15s;
  }
  .score-reg.is-in .score-reg-fill {
    transform: scaleX(1);
  }

  .score-cta .btn {
    width: 100%;
  }

  /* foto do entorno: recorte fechado e vertical, colado à base da faixa
     (mobile) — o oposto do painel largo do item 02 */
  .score-foto {
    position: relative;
    overflow: hidden;
    margin-inline: calc(var(--sangria) * -1);
    margin-bottom: calc(var(--padY) * -1);
    aspect-ratio: 4 / 5;
  }
  .score-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* fatia vertical focada nas estações-tubo e no ônibus, à esquerda do
       quadro original */
    object-position: 30% 50%;
  }

  @media (min-width: 1024px) {
    /* Faixa dividida ao meio: metade esquerda é a fotografia (sangrando
       até a borda da tela), metade direita é o bloco preto com as infos. */
    .score-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(48px, 5vw, 110px);
      row-gap: 0;
      padding-block: 0;
    }
    .score-num,
    .score-txt,
    .score-reg,
    .score-cta {
      grid-column: 2;
    }
    .score-num {
      padding-top: clamp(72px, 9vw, 150px);
    }
    .score-txt {
      margin-top: clamp(26px, 3vw, 44px);
    }
    .score-reg {
      margin-top: clamp(34px, 4vw, 56px);
    }
    .score-cta {
      margin-top: clamp(30px, 3.4vw, 52px);
      padding-bottom: clamp(72px, 9vw, 150px);
    }
    .score-cta .btn {
      width: auto;
    }
    .score-foto {
      grid-column: 1;
      grid-row: 1 / span 4;
      align-self: stretch;
      height: 100%;
      aspect-ratio: auto;
      margin: 0 0 0 calc(var(--sangria) * -1);
    }
  }

  /* ---------------- reduced motion ----------------
     O GSAP nem inicializa (a media query do matchMedia inclui
     no-preference), então .is-js nunca existe e o fluxo estático vale.
     Aqui só desligamos as transições CSS novas e cravamos a régua cheia. */
  @media (prefers-reduced-motion: reduce) {
    .loc-num,
    .loc-t,
    .loc-d,
    .score-reg-fill {
      transition: none;
    }
    .score-reg-fill {
      transform: scaleX(1);
    }
  }
</style>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  const raiz = document.querySelector<HTMLElement>('[data-loc-scrolly]');
  if (raiz) {
    const mq = matchMedia('(min-width: 1024px)');
    let carregado = false;

    /* GSAP só é baixado se o viewport for (ou virar) desktop — no mobile a
       dobra é fluxo puro e não paga o peso da lib. */
    const iniciar = async () => {
      if (carregado) return;
      carregado = true;
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      /* gsap.matchMedia cria e DESTRÓI tudo (triggers, estilos inline)
         quando a condição muda — inclusive se o usuário ligar
         prefers-reduced-motion no meio da sessão. */
      const mm = gsap.matchMedia();
      mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
        raiz.classList.add('is-js');

        const fotos = gsap.utils.toArray<HTMLElement>('[data-foto]', raiz);
        const movs = fotos.map((f) => f.querySelector<HTMLElement>('[data-mov]'));
        const itens = gsap.utils.toArray<HTMLElement>('[data-item]', raiz);
        let atual = 0;

        /* as figuras têm data-rv-img (máscara de entrada no mobile); no
           painel empilhado a máscara já cumpriu seu papel — destrava o img
           imediatamente para a troca via GSAP nunca revelar um img clipado */
        fotos.forEach((f) => f.classList.add('is-in'));

        /* estado inicial oculto SÓ via JS (regra de ouro): sem JS as fotos
           seguem no fluxo, visíveis */
        gsap.set(fotos, { autoAlpha: 0, zIndex: 1 });
        gsap.set(fotos[0], { autoAlpha: 1, zIndex: 2 });

        const ativar = (i: number, iItem: number, dir: 1 | -1) => {
          itens.forEach((el, k) => el.classList.toggle('is-ativo', k === iItem));
          if (i === atual) return;
          const idxSai = atual;
          const entra = fotos[i];
          const sai = fotos[idxSai];
          atual = i;
          /* garante que nenhuma foto antiga (ex.: a Arena) permaneça
             visível sob a transição quando o assunto ativo é outro */
          fotos.forEach((f, k) => {
            if (k !== i && k !== idxSai) gsap.set(f, { autoAlpha: 0, zIndex: 1 });
          });

          gsap.killTweensOf([entra, sai, movs[i]].filter(Boolean));
          gsap.set(sai, { zIndex: 1, autoAlpha: 1, clipPath: 'inset(0% 0% 0% 0%)' });
          gsap.set(entra, { zIndex: 2, autoAlpha: 1 });

          /* máscara direcional: descendo, a nova foto varre de baixo para
             cima; subindo, o inverso — funciona nos dois sentidos */
          gsap.fromTo(
            entra,
            { clipPath: dir === 1 ? 'inset(100% 0% 0% 0%)' : 'inset(0% 0% 100% 0%)' },
            {
              clipPath: 'inset(0% 0% 0% 0%)',
              duration: 0.85,
              ease: 'power3.inOut',
              onComplete: () => gsap.set(sai, { autoAlpha: 0 }),
            }
          );
          const mov = movs[i];
          if (mov) {
            gsap.fromTo(
              mov,
              { yPercent: dir * 9, scale: 1.07 },
              { yPercent: 0, scale: 1, duration: 1.1, ease: 'power3.out' }
            );
          }
        };

        /* Um gatilho por FOTO, não por item: quando um item comanda mais de
           uma fotografia (Universidades: PUC-PR e Unicuritiba), a altura dele
           é dividida igualmente entre elas, e cada fatia troca a foto sem
           trocar o item ativo na coluna de texto. */
        let iFoto = 0;
        itens.forEach((el, i) => {
          const n = Math.max(1, Number(el.dataset.fotos) || 1);
          for (let k = 0; k < n; k++) {
            const idx = iFoto++;
            ScrollTrigger.create({
              trigger: el,
              start: `${(k / n) * 100}% 55%`,
              end: `${((k + 1) / n) * 100}% 55%`,
              onEnter: () => ativar(idx, i, 1),
              onEnterBack: () => ativar(idx, i, -1),
            });
          }
        });

        /* a página pode carregar já rolada até o meio da lista (refresh,
           âncora): sincroniza o painel com o item sob a linha de leitura */
        let inicialItem = 0;
        let inicialFoto = 0;
        const linha = window.innerHeight * 0.55;
        let acumulado = 0;
        itens.forEach((el, k) => {
          const n = Math.max(1, Number(el.dataset.fotos) || 1);
          const r = el.getBoundingClientRect();
          if (r.top < linha) {
            inicialItem = k;
            const dentro = Math.min(Math.max((linha - r.top) / r.height, 0), 0.999);
            inicialFoto = acumulado + Math.floor(dentro * n);
          }
          acumulado += n;
        });
        if (inicialFoto > 0) ativar(inicialFoto, inicialItem, 1);

        return () => {
          raiz.classList.remove('is-js');
          itens.forEach((el, k) => el.classList.toggle('is-ativo', k === 0));
          atual = 0;
        };
      });
    };

    aoAproximar(raiz, () => {
      if (reduzMovimento()) return;
      if (mq.matches) {
        iniciar();
      } else {
        const aoMudar = (e: MediaQueryListEvent) => {
          if (e.matches) {
            mq.removeEventListener('change', aoMudar);
            iniciar();
          }
        };
        mq.addEventListener('change', aoMudar);
      }
    });
  }
</script>
