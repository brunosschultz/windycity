---
import { Picture } from 'astro:assets';
import { EMPREENDIMENTO } from '../config';
import { waHref } from '../config';
import MapaLocalizacao from './MapaLocalizacao.astro';
import ProximidadesVideo from './ProximidadesVideo.astro';

/* A mídia de abertura é a fachada com a rua e o ponto de ônibus à vista —
   o mesmo enquadramento em que o vídeo de drone vai nascer antes de subir
   e revelar a região. Usar aqui a foto aérea da Arena repetiria, poucos
   blocos abaixo, exatamente a imagem do ponto 01. */
import aberturaRua from '../assets/images/fachada-dia-hd.jpg';
import arena from '../assets/images/loc-arena.jpg';
import pontoOnibus from '../assets/images/loc-ponto-onibus.jpg';
import pucpr from '../assets/images/loc-pucpr.jpg';
/* Fachada do Unicuritiba — arquivo trazido da pasta de imagens do outro
   projeto da agência (era o único no computador). Se a origem não for a
   pretendida, basta substituir este arquivo. */
import unicuritiba from '../assets/images/loc-unicuritiba.jpg';
import fazendaChurrascada from '../assets/images/loc-fazenda-churrascada.webp';
import restaurante from '../assets/images/loc-restaurante.jpg';
import farmacia from '../assets/images/loc-farmacia.jpg';

/* Conteúdo do wireframe aprovado. O item 05 ("Sem vaga de garagem
   obrigatória") foi REMOVIDO por autorização expressa do cliente —
   a sequência agora é 01–04. `leg` é a identificação visível da foto
   no painel (nomes próprios reais exigidos pelo cliente). */
const pontos = [
  {
    t: 'Arena da Baixada',
    d: 'proximidade com jogos, shows e grandes eventos',
    /* `meta` é o dado objetivo do ponto, exibido sobre a fotografia no
       lugar do antigo título repetido. */
    meta: '900 m',
  },
  {
    t: 'Mobilidade',
    d: 'fácil acesso ao transporte público e eixos urbanos',
    meta: 'Ponto de ônibus em frente',
  },
  { t: 'Universidades', d: 'próximo à PUCPR e outros centros de ensino', meta: null },
  { t: 'Cotidiano', d: 'mercados, farmácias, restaurantes e serviços essenciais', meta: null },
];
---

<section class="section theme-branco loc" id="localizacao" aria-labelledby="loc-t">
  <!-- 1 · Abertura editorial: título em escala de pôster à esquerda,
       parágrafo deslocado para a coluna oposta, rente à base do título.
       O parágrafo carrega o texto aprovado INTEIRO — a sobreposição da
       foto abaixo é o endereço do empreendimento, não um trecho dele. -->
  <header class="wrap loc-abre">
    <p class="eyebrow" data-rv>Localização</p>
    <h2 class="h2-xl loc-titulo" id="loc-t" data-rv-pal>
      Viva a cidade com mais <em class="ac">autonomia</em>
    </h2>
    <p class="lede loc-lede" data-rv style="--d:90ms">
      O WindyCity está em uma região conectada a transporte, universidades, serviços, lazer e aos
      principais movimentos de Curitiba — com ponto de ônibus em frente e menor dependência do
      carro.
    </p>
  </header>

  <!-- ==========================================================================
       MÍDIA PRINCIPAL DA DOBRA — bloco isolado de propósito.
       Quando o vídeo de drone (subida da fachada revelando a cidade) chegar,
       trocar SOMENTE o <Picture> abaixo por um <video autoplay muted loop
       playsinline poster="..."> com as mesmas regras de .loc-media img
       (width/height 100% + object-fit:cover). Nada mais da dobra muda:
       o parallax (data-px) e a revelação por máscara (data-rv-img) ficam no
       <figure>, e a legenda editorial (figcaption) permanece sobreposta,
       independente de a mídia ser foto ou vídeo.
       ========================================================================== -->
  <figure class="bleed loc-media" data-px="60" data-rv-img data-prog>
    <!-- data-prog alimenta --prog (0→1) durante a travessia da figura pela
         viewport; o zoom-out lê essa custom property em CSS puro. Só
         transform, sem recálculo de layout. -->
    <div class="loc-media-zoom">
      <Picture
        src={aberturaRua}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[760, 1160, 1600, 2048, 2880]}
        sizes="100vw"
        alt="Fachada do WindyCity vista da rua em dia de sol, com calçada arborizada e ponto de ônibus em frente"
        loading="lazy"
        decoding="async"
      />
    </div>
    <!-- Endereço como assinatura da imagem: escala de pôster, quebrado em
         duas linhas (logradouro + bairro/cidade) para não perder legibilidade. -->
    <figcaption class="loc-media-leg">
      <address class="loc-endereco" data-rv style="--d:160ms">
        <span class="loc-endereco-l1">Rua Conselheiro Dantas, 1287</span>
        <span class="loc-endereco-l2">Rebouças | Curitiba/PR</span>
      </address>
    </figcaption>
  </figure>

  <!-- 3 · Scrollytelling 01–04.
       Mobile / sem JS: fluxo vertical natural — foto identificada + número
       + texto, intercalados via display:contents + order.
       Desktop com JS (classe .is-js aplicada pelo script): painel sticky
       sangrando até a borda esquerda; cada item da coluna direita percorre
       ~80svh e troca a fotografia do painel com máscara direcional (GSAP). -->
  <div class="wrap loc-scrolly-wrap">
    <div class="loc-scrolly" data-loc-scrolly>
      <div class="loc-painel">
        <figure class="loc-foto f-arena" data-foto style="--o:1" data-rv-img>
          <div class="loc-mov" data-mov>
            <Picture
              src={arena}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[520, 760, 1080, 1480, 2000]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Arena da Baixada vista de cima à noite, com a fachada iluminada em vermelho"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">{pontos[0].meta}</span>
          </figcaption>
        </figure>

        <figure class="loc-foto f-mob" data-foto style="--o:3" data-rv-img="esq">
          <div class="loc-mov" data-mov>
            <Picture
              src={pontoOnibus}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 760, 1080, 1200]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Obra do WindyCity vista da rua, com o ponto de ônibus coberto na calçada em frente e o tapume da Girassol com a frase Viva o novo ritmo urbano"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">{pontos[1].meta}</span>
          </figcaption>
        </figure>

        <!-- Universidades: PUC-PR e Unicuritiba são DUAS etapas da mesma
             sequência — cada fachada ocupa o painel inteiro, como as demais,
             em vez de dividirem o quadro. O item 03 percorre o dobro de
             altura (ver .loc-item--duplo) para as duas terem o mesmo tempo
             de tela das outras. -->
        <figure class="loc-foto f-puc" data-foto style="--o:5" data-rv-img="dir">
          <div class="loc-mov" data-mov>
            <Picture
              src={pucpr}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900, 1200]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Campus da PUCPR, com bloco de fachada vermelha e passarela de acesso"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">PUC-PR</span>
          </figcaption>
        </figure>

        <figure class="loc-foto f-uni" data-foto style="--o:5" data-rv-img="dir">
          <div class="loc-mov" data-mov>
            <Picture
              src={unicuritiba}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[420, 640, 900, 1079]}
              sizes="(max-width: 1023px) 92vw, 55vw"
              alt="Fachada do Unicuritiba, com o volume envidraçado da entrada e o letreiro da instituição"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="loc-leg">
            <span class="loc-leg-m">Unicuritiba</span>
          </figcaption>
        </figure>

        <!-- Cotidiano reúne as três fotos de serviço, cada uma com o nome
             próprio visível (exigência do cliente). A Fazenda Churrascada
             conduz; a farmácia é o arquivo de menor resolução (555px) e por
             isso só aparece em miniatura, recortada com cover (o recorte
             elimina os cantos arredondados embutidos no JPG). -->
        <figure class="loc-foto f-cot" data-foto style="--o:7" data-rv-img>
          <div class="loc-mov loc-colagem" data-mov>
            <div class="cot-tile cot-main">
              <Picture
                src={fazendaChurrascada}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[400, 640, 920, 1280]}
                sizes="(max-width: 1023px) 56vw, 32vw"
                alt="Entrada da Fazenda Churrascada, com o telhado de telhas, a varanda de madeira e a placa do restaurante entre as araucárias"
                loading="lazy"
                decoding="async"
              />
              <span class="cot-rotulo label">Fazenda Churrascada</span>
            </div>
            <div class="cot-tile">
              <Picture
                src={restaurante}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[280, 440, 640, 880]}
                sizes="(max-width: 1023px) 34vw, 22vw"
                alt="Fachada amarela do Restaurante Peixinho, entre palmeiras"
                loading="lazy"
                decoding="async"
              />
              <span class="cot-rotulo label">Restaurante Peixinho</span>
            </div>
            <div class="cot-tile">
              <Picture
                src={farmacia}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[240, 400, 540]}
                sizes="(max-width: 1023px) 34vw, 22vw"
                alt="Fachada de farmácia Droga Raia aberta 24 horas"
                loading="lazy"
                decoding="async"
              />
              <span class="cot-rotulo label">Droga Raia</span>
            </div>
          </div>
        </figure>
      </div>

      {/* A caixa existe só para dar PERCURSO de scroll no desktop: os itens
          empilham num palco sticky e não ocupam mais altura própria, então
          alguém precisa segurar a rolagem. `display: contents` por padrão —
          no mobile e sem JS ela some do layout e nada muda.
          --passos = uma fatia por FOTOGRAFIA (Universidades comanda duas). */}
      <div class="loc-itens-caixa" data-itens-caixa style={`--passos:${pontos.length + 1}`}>
        <div class="loc-palco">
          <ol class="loc-itens">
          {
            pontos.map((p, i) => (
              <li
                class:list={['loc-item', { 'is-ativo': i === 0, 'loc-item--duplo': i === 2 }]}
                data-item
                data-fotos={i === 2 ? 2 : 1}
                data-rv
                style={`--d:${i * 55}ms;--o:${i * 2 + 2}`}
              >
                <span class="loc-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="loc-t">{p.t}</span>
                <span class="loc-d">{p.d}</span>
              </li>
            ))
          }
          </ol>

          {/* Guia de navegação: mostra que a dobra tem quatro pontos, quanto
              já se percorreu do atual e permite pular direto para qualquer um.
              Só existe no palco do desktop — no mobile os quatro itens já
              aparecem em sequência e um indicador de progresso não teria o que
              indicar. O número é duplicado de propósito: a cópia de dentro do
              preenchimento é recortada junto com ele, então o algarismo troca
              de cor exatamente na linha do avanço, em vez de ficar meio verde
              meio bege sobre o fundo errado. */}
          <nav class="loc-guia" data-guia aria-label="Pontos da localização">
            {
              pontos.map((p, i) => (
                <button type="button" class="loc-bt" data-guia-bt data-i={i}>
                  <span class="loc-bt-n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="loc-bt-cheio" aria-hidden="true">
                    <span class="loc-bt-n">{String(i + 1).padStart(2, '0')}</span>
                  </span>
                  <span class="sr-only">Ir para {p.t}</span>
                </button>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- 4 · Cena de vídeo das proximidades conduzida pelo scroll.

       MAPA OCULTO A PEDIDO DO CLIENTE (decisão temporária): o componente e
       todos os dados dele seguem no projeto, intactos. Para trazer de volta,
       basta reativar a linha abaixo — nada mais precisa mudar. -->
  <ProximidadesVideo />
  {/* <MapaLocalizacao /> */}

  <!-- 5 · Walk Score — fecho da dobra: faixa preta em sangria total, número
       gigante e régua à esquerda, fotografia em recorte vertical colada às
       bordas superior/inferior/direita da faixa (tratamento deliberadamente
       oposto ao painel largo do item 02, para a mesma foto placeholder não
       ler como repetição). -->
  <div class="score theme-preto bleed">
    <div class="wrap score-grid">
      <div class="score-num" data-rv>
        <span class="num-xl" data-count={EMPREENDIMENTO.walkScore}>0</span>
        <span class="label score-esc">de 0 a 100</span>
      </div>

      <div class="score-txt" data-rv style="--d:80ms">
        <h3 class="h3">Walk Score {EMPREENDIMENTO.walkScore}</h3>
        <p>
          Walk Score é um índice internacional que avalia, de 0 a 100, o quanto uma região permite
          viver o dia a dia a pé.
        </p>
        <p>
          Alto potencial para realizar atividades do cotidiano a pé — serviços, comércio,
          universidades e lazer próximos, com pouca ou nenhuma dependência de carro.
        </p>
      </div>

      <!-- Régua do índice: representação gráfica do valor na escala 0–100 já
           informada ao lado. Decorativa, sem texto novo. O preenchimento sai
           do mesmo EMPREENDIMENTO.walkScore do número — nunca de um % fixo no
           CSS, senão a régua desencontra do dado se o config mudar. -->
      <div
        class="score-reg"
        data-rv
        style={`--d:150ms;--pct:${EMPREENDIMENTO.walkScore}%`}
        aria-hidden="true"
      >
        <span class="score-reg-fill"></span>
      </div>

      <div class="score-cta" data-rv style="--d:200ms">
        <a class="btn btn--light" href={waHref()}>
          <span>Tenho interesse</span>
          <svg
            class="arw"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M2 8h11m0 0L9 4m4 4l-4 4"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <!-- Animação em loop no lugar da fotografia. Decorativa: o índice e o
           texto ao lado já dizem tudo, então ela fica fora da árvore de
           acessibilidade. O `src` só é atribuído quando a dobra se aproxima
           (ver script) — sem isso o arquivo entraria no carregamento inicial. -->
      <figure class="score-foto" data-rv-img="dir">
        <video
          class="score-video"
          data-score-video
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          data-src-desktop="/video/walkscore-960.mp4"
          data-src-mobile="/video/walkscore-640.mp4"></video>
      </figure>
    </div>
  </div>
</section>

<style>
  /* A faixa preta do Walk Score é o fecho: a seção termina nela, sem
     respiro branco depois (o padding-bottom padrão de .section sai). */
  .loc {
    padding-block: var(--section-y) 0;
  }

  /* ---------------- 1 · Abertura editorial ---------------- */
  .loc-abre {
    margin-bottom: clamp(30px, 4.5vw, 64px);
  }
  .loc-titulo {
    font-size: clamp(2.4rem, 7.2vw, 6.4rem);
    max-width: 13ch;
  }
  .loc-lede {
    margin-top: clamp(20px, 3.5vw, 44px);
    max-width: 44ch;
  }
  @media (min-width: 1024px) {
    .loc-abre {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      column-gap: clamp(48px, 6vw, 130px);
    }
    .loc-abre .eyebrow,
    .loc-titulo {
      grid-column: 1;
    }
    .loc-lede {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      justify-self: end;
      margin-top: 0;
      padding-bottom: 0.4em;
      max-width: 38ch;
    }
  }

  /* ---------------- 2 · Mídia principal (slot do vídeo de drone) ---------------- */
  /* A dobra nasce como um quadro menor, com cantos arredondados, e ABRE
     até ocupar a tela inteira conforme o scroll avança. O crescimento é
     por `clip-path`, não por width/height: recorte é pintura, então não
     há recálculo de layout a cada quadro.
     `--abre` remapeia o --prog do driver (0 ao encostar embaixo, 1 ao sair
     em cima) para fechar antes do meio do percurso. Sem JS o --prog não
     existe e o fallback `1` já entrega o quadro inteiro. */
  .loc-media {
    position: relative;
    overflow: hidden;
    height: 100svh;
    background: var(--marrom-08);
    --abre: min(1, max(0, calc((var(--prog, 1) - 0.06) * 2.6)));
    clip-path: inset(
      calc((1 - var(--abre)) * 9svh) calc((1 - var(--abre)) * 8vw) round
        calc((1 - var(--abre)) * 16px)
    );
  }
  /* Zoom-out do CONTEÚDO, mais discreto que antes: quem carrega o gesto
     agora é a abertura do quadro (ver .loc-media). Interpola 1.08 → 1.0. */
  .loc-media-zoom {
    height: 100%;
    transform: scale(calc(1.08 - 0.08 * var(--prog, 1)));
    transform-origin: center center;
    will-change: transform;
  }
  .loc-media :global(picture) {
    display: block;
    height: 100%;
  }
  .loc-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  @media (max-width: 760px) {
    /* 60svh a pedido: em pé a fachada não precisa da tela inteira, e sobra
       menos rolagem até o conteúdo seguinte. */
    .loc-media {
      height: 60svh;
    }
    /* em retrato, desloca o recorte para a direita: mantém o prédio e o
       ponto de ônibus (que a legenda menciona) dentro do quadro */
    .loc-media :global(img) {
      object-position: 62% 50%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loc-media-zoom {
      transform: none;
    }
    .loc-media {
      clip-path: none;
    }
  }
  /* Endereço centralizado na altura da foto. O véu agora é radial a partir
     do centro (não mais um gradiente de base), porque o texto deixou de
     cair sobre a base escura da imagem. */
  .loc-media-leg {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    padding-inline: var(--sangria);
    /* Gradiente HORIZONTAL, não radial: em tela de celular o radial
       produzia anéis de banding — as "linhas pontilhadas" que apareciam
       atravessando o endereço. O linear em um eixo só não banda. */
    background: linear-gradient(
      90deg,
      rgb(1 8 17 / 74%) 0%,
      rgb(1 8 17 / 62%) 32%,
      rgb(1 8 17 / 40%) 58%,
      rgb(1 8 17 / 18%) 80%,
      rgb(1 8 17 / 8%) 100%
    );
    pointer-events: none;
  }
  /* Endereço em escala de pôster sobre a fachada. A linha 1 (logradouro,
     mais longa) governa a escala: usa vw para crescer com a largura, mas
     o clamp impede que estoure a sangria em telas largas. A linha 2 é
     menor de propósito — hierarquia dentro do próprio endereço. */
  .loc-endereco {
    display: block;
    font-style: normal;
    color: #fff;
    line-height: 1.14;
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 2px 40px rgb(0 0 0 / 35%);
  }
  .loc-endereco-l1,
  .loc-endereco-l2 {
    display: block;
    font-weight: 600;
    line-height: 1.14;
  }
  .loc-endereco-l2 {
    margin-top: 0.28em;
  }
  .loc-endereco-l1 {
    font-size: clamp(1.9rem, 5.1vw, 5.4rem);
  }
  /* Bairro + cidade: 20% menor que a escala anterior desta linha, para o
     logradouro seguir sendo a informação dominante. */
  .loc-endereco-l2 {
    font-size: clamp(1.08rem, 2.72vw, 2.88rem);
    color: var(--bege);
  }

  /* ---------------- 3 · Scrollytelling ----------------
     Base (mobile e desktop sem JS): coluna única; display:contents faz
     figuras e itens virarem irmãos na mesma grade e o `order` (--o) os
     intercala — foto identificada, depois número + texto.

     O respiro lateral desta dobra é EXPLÍCITO e em px (ver o bloco mobile
     no fim do arquivo), não herdado do gutter em `vw` do .wrap: se o
     layout viewport do aparelho divergir da tela — o que acontece no
     Safari do iOS quando algo estica a página — o padding em `vw` deixa de
     bater com a largura real e a imagem sai do eixo. Em px isso não
     acontece. */
  .loc-scrolly-wrap {
    margin-block: clamp(48px, 7vw, 110px);
  }
  .loc-scrolly {
    display: grid;
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
  }
  .loc-painel,
  .loc-itens,
  .loc-itens-caixa,
  .loc-palco {
    display: contents;
  }
  /* O guia só faz sentido no palco travado do desktop: no mobile os quatro
     pontos já aparecem em sequência, um sob o outro, e não há progresso
     dentro de um item para indicar. */
  .loc-guia {
    display: none;
  }
  .loc-itens {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .loc-foto {
    order: var(--o, 0);
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--marrom-08);
    margin-bottom: clamp(18px, 4vw, 24px);
  }
  .f-arena {
    aspect-ratio: 16 / 9;
  }
  .f-mob,
  .f-puc,
  .f-uni {
    aspect-ratio: 3 / 2;
  }
  /* O Cotidiano é um conjunto de três fotos soltas, sem moldura: nada de
     fundo, borda ou sombra atrás delas. */
  .f-cot {
    aspect-ratio: 4 / 3;
    background: none;
    overflow: visible;
    border-radius: 0;
  }
  .loc-mov {
    position: absolute;
    inset: 0;
  }
  .loc-mov :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .loc-mov :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* pontos focais auditados — nada de cover+center cego */
  .f-arena :global(img) {
    object-position: center 62%;
  }
  .f-puc :global(img) {
    object-position: 38% 50%;
  }
  .f-uni :global(img) {
    object-position: center 45%;
  }
  /* Ponto focal recalibrado para a foto nova: ela é 3:2 deitada num quadro
     retrato, então o `cover` mostra só ~54% da largura. Centralizado, esse
     recorte começava em 23% e decepava a placa da Fazenda Churrascada, que
     fica entre 14% e 24%. Com 25% o recorte abre em ~11% e a placa entra
     inteira, sem perder o telhado nem a varanda. */
  .cot-main :global(img) {
    object-position: 25% 50%;
  }

  /* colagem do Cotidiano */
  .loc-colagem {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }
  .cot-tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .cot-main {
    grid-row: 1 / span 2;
  }
  .cot-tile :global(picture) {
    position: absolute;
    inset: 0;
  }
  /* identificação visível de cada serviço (nomes reais) */
  .cot-tile .cot-rotulo {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 2;
    background: var(--preto);
    color: var(--bege);
    padding: 4px 8px;
    border-radius: var(--radius);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
  }

  /* Sobre a fotografia fica só o dado objetivo do ponto (distância,
     descrição) — o nome já é o título do item ao lado, não se repete. */
  .loc-leg {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    padding: clamp(40px, 8vw, 96px) clamp(14px, 2vw, 32px) clamp(12px, 1.8vw, 26px);
    background: linear-gradient(180deg, transparent, var(--preto) 140%);
    pointer-events: none;
  }
  .loc-leg-m {
    color: var(--bege);
    font-size: clamp(0.95rem, 1.9vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* itens 01–04 */
  .loc-item {
    order: var(--o, 0);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 16px;
    row-gap: 6px;
    align-items: baseline;
    /* respiro generoso entre um ponto e o próximo, para cada bloco de foto
       + descrição ler como uma unidade */
    margin: 4px 0 clamp(64px, 15vw, 96px);
  }
  .loc-item:last-child {
    margin-bottom: 0;
  }
  .loc-num {
    grid-row: 1 / span 2;
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-weight: 400;
    font-variant-numeric: lining-nums;
    color: var(--verde);
    font-size: clamp(2.6rem, 9vw, 3.8rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
  }
  .loc-t {
    font-weight: 700;
    font-size: clamp(1.2rem, 4.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .loc-d {
    grid-column: 2;
    color: var(--fg-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
    max-width: 44ch;
  }

  /* ---------------- 3 · Scrollytelling — desktop com JS ----------------
     .is-js só existe quando o script rodou (e sem prefers-reduced-motion):
     é ele que autoriza empilhar as fotos em absoluto dentro do painel
     sticky. Sem JS nada nasce escondido — o fluxo acima permanece. */
  @media (min-width: 1024px) {
    .loc-scrolly.is-js {
      max-width: none;
      /* o vão entre foto e borda da tela é medido a partir DESTA variável;
         guardá-la evita que a margem negativa da caixa e o gap saiam de
         sincronia se um dos dois mudar */
      --loc-gap: clamp(48px, 5vw, 120px);
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
      column-gap: var(--loc-gap);
      align-items: start;
    }
    .is-js .loc-painel {
      display: block;
      position: sticky;
      --ph: min(74svh, 40vw);
      top: calc((100svh - var(--ph)) / 2);
      height: var(--ph);
      margin-left: calc(var(--sangria) * -1);
      overflow: hidden;
      border-radius: 0 var(--radius) var(--radius) 0;
    }
    .is-js .loc-foto {
      position: absolute;
      inset: 0;
      margin: 0;
      order: 0;
      aspect-ratio: auto;
      border-radius: 0;
    }
    .is-js .loc-leg {
      padding: clamp(80px, 8vw, 150px) clamp(28px, 3vw, 56px) clamp(22px, 2.4vw, 44px);
    }
    .is-js .loc-leg-m {
      font-size: clamp(1.15rem, 1.5vw, 1.55rem);
    }
    .is-js .cot-tile .cot-rotulo {
      left: 12px;
      bottom: 12px;
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
    }
    /* Sem caixa cinza: nem o painel nem o quadro do Cotidiano pintam fundo,
       então as três fotos ficam soltas sobre o branco da seção. */
    .is-js .f-cot {
      overflow: hidden;
      background: none;
    }

    /* A caixa vira o percurso: 80svh por fotografia, igual ao que os itens
       ocupavam antes somados. É ela que segura o painel preso. */
    /* A caixa passa a ocupar o VÃO INTEIRO — da borda direita da fotografia
       até a borda da tela — desfazendo o gap à esquerda e a sangria à
       direita. Antes ela começava depois do gap e parava no limite do
       `.wrap`, então o bloco de texto, alinhado à esquerda dentro de uma
       coluna larga, ficava visivelmente encostado no lado esquerdo do vão.
       Com a caixa cobrindo o vão, centrar o conteúdo nela é centrar no vão.
       Nada disso mexe na largura da fotografia: o grid e o gap continuam
       iguais, só a caixa transborda para os dois lados. */
    .loc-scrolly.is-js .loc-itens-caixa {
      display: block;
      height: calc(var(--passos, 5) * 80svh);
      margin-left: calc(var(--loc-gap) * -1);
      margin-right: calc(var(--sangria) * -1);
    }
    /* O texto vira PALCO, não coluna que rola: gruda na mesma linha da foto
       e os itens se revezam no mesmo lugar. Antes cada item tinha altura
       própria e subia pela tela — agora a troca é no lugar, como no
       comparativo de Diferenciais. */
    /* O sticky mora no PALCO, não na lista: ele precisa segurar o texto e o
       guia juntos, na mesma linha da fotografia. */
    .loc-scrolly.is-js .loc-palco {
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* centra o bloco no vão; o texto segue alinhado à esquerda DENTRO dele,
         como manda o sistema (eixo de leitura constante) */
      align-items: center;
      padding-inline: clamp(24px, 2.6vw, 64px);
      position: sticky;
      --ph: min(74svh, 40vw);
      top: calc((100svh - var(--ph)) / 2);
      height: var(--ph);
    }
    /* Largura fixa e igual para texto e guia: sem isso o bloco encolheria
       para o tamanho de cada item e o conjunto ANDARIA de lado a cada troca
       de ponto, já que os textos têm comprimentos diferentes. 33rem é a
       largura que a coluna já tinha, então as quebras de linha não mudam. */
    .loc-scrolly.is-js .loc-itens,
    .loc-scrolly.is-js .loc-guia {
      width: min(100%, 33rem);
    }
    .loc-scrolly.is-js .loc-itens {
      display: grid;
      align-content: center;
    }

    /* ---- Guia numerado 01–04 ---- */
    .loc-scrolly.is-js .loc-guia {
      display: flex;
      gap: 10px;
      margin-top: clamp(24px, 3.5vh, 44px);
    }
    /* Quadrado de verdade: aspect-ratio 1 com largura fixa, para o algarismo
       não deformar a caixa quando a fonte cair no fallback. */
    .loc-bt {
      position: relative;
      width: clamp(38px, 3.2vw, 46px);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      padding: 0;
      border: 1px solid var(--verde);
      background: none;
      color: var(--verde);
      cursor: pointer;
      overflow: hidden;
      transition: border-color 0.3s var(--ease);
    }
    .loc-bt-n {
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }
    /* O preenchimento avança por clip-path, não por scaleX: transform
       escalaria também o algarismo de dentro, e a contra-escala necessária
       para desentortá-lo explode quando o progresso é zero. clip-path é só
       pintura — não recalcula layout e não toca no filho. */
    /* inset -1px, não 0: um absoluto se posiciona pela caixa de PADDING, que
       exclui a borda — com 0 sobrava um anel de 1px por fora do preenchimento.
       Estendendo por baixo da borda, o verde cobre o botão inteiro, e o
       `overflow: hidden` do pai apara o que passa. */
    .loc-bt-cheio {
      position: absolute;
      inset: -1px;
      display: grid;
      place-items: center;
      background: var(--verde);
      color: var(--bege);
      clip-path: inset(0 calc((1 - var(--p, 0)) * 100%) 0 0);
    }
    .loc-bt:hover {
      border-color: var(--marrom);
    }
    .loc-bt:focus-visible {
      outline: 2px solid var(--marrom);
      outline-offset: 2px;
    }
    @media (prefers-reduced-motion: reduce) {
      .loc-bt {
        transition: none;
      }
    }
    /* Empilhados na mesma célula. O estado escondido é o mesmo vocabulário
       do Diferenciais: sobe 12px, desfoca 3px e some — sutil, sem salto. */
    .loc-scrolly.is-js .loc-item {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      min-height: 0;
      margin: 0;
      padding-block: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px);
      filter: blur(3px);
      transition:
        opacity 0.52s var(--ease-out),
        transform 0.52s var(--ease-out),
        filter 0.52s var(--ease-out),
        visibility 0s linear 0.52s;
    }
    .loc-scrolly.is-js .loc-item.is-ativo {
      opacity: 1;
      visibility: visible;
      transform: none;
      filter: none;
      transition:
        opacity 0.58s var(--ease-out),
        transform 0.58s var(--ease-out),
        filter 0.58s var(--ease-out),
        visibility 0s;
    }
    /* Numeral em escala de pôster. Com os itens empilhados só o ativo está
       na tela, então ele já nasce verde: a antiga transição de cor virava
       um piscar durante o crossfade, porque o item que sai ainda aparece
       por meio segundo. */
    .is-js .loc-num {
      font-size: clamp(6rem, 9.5vw, 11rem);
      line-height: 0.8;
      color: var(--verde);
    }
    .is-js .loc-t {
      position: relative;
      z-index: 1;
      margin-top: clamp(16px, 2vw, 28px);
      font-size: clamp(1.9rem, 3vw, 2.9rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.05;
    }
    .is-js .loc-d {
      margin-top: 14px;
      font-size: 1rem;
    }
    /* opacidade de título e descrição agora é do ITEM inteiro (crossfade);
       o esmaecimento individual sobrava e criava transição dupla */
    .loc-scrolly.is-js .loc-t,
    .loc-scrolly.is-js .loc-d {
      opacity: 1;
    }
  }

  /* ================================================================
     MOBILE / TABLET — a dobra 01–04 se auto-contém.
     Sem `vw`, sem `--gutter`, sem `--sangria` e sem `max-width` + `margin
     auto`: largura 100% do pai, respiro em px, e cada peça travada em
     `max-width: 100%`. Isso torna o centramento imune a qualquer
     divergência entre o layout viewport e a tela.
     ================================================================ */
  @media (max-width: 1023px) {
    .loc-scrolly-wrap {
      /* substitui o padding do .wrap por um valor fixo e previsível */
      padding-inline: 24px;
      max-width: 100%;
    }
    .loc-scrolly {
      max-width: 100%;
      margin-inline: 0;
    }
    .loc-foto,
    .loc-item {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
    }
    .loc-colagem {
      width: 100%;
      max-width: 100%;
    }
  }

  /* ---------------- 5 · Walk Score ---------------- */
  /* Colada no mapa: sem respiro branco entre as duas. */
  .score {
    margin-top: 0;
    background: var(--preto);
    color: var(--bege);
    overflow: hidden;
  }
  .score-grid {
    --padY: clamp(60px, 10vw, 120px);
    display: grid;
    gap: clamp(30px, 6vw, 48px);
    padding-block: var(--padY);
  }
  .score-num {
    display: flex;
    align-items: baseline;
    gap: 18px;
  }
  .score-num .num-xl {
    color: var(--bege);
    font-size: clamp(5.6rem, 23vw, 15rem);
  }
  .score-esc {
    color: var(--bege-40);
    letter-spacing: 0.24em;
  }
  .score-txt {
    display: grid;
    gap: 16px;
    max-width: 46ch;
  }
  .score-txt .h3 {
    color: var(--bege);
  }
  .score-txt p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--bege-60);
  }

  /* Régua 0–100: cresce em scaleX (compositor). A largura vem de --pct,
     publicado na marcação a partir do config. */
  .score-reg {
    position: relative;
    height: 2px;
    background: var(--bege-14);
  }
  .score-reg-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pct, 92%);
    background: var(--verde);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.05s var(--ease-out) 0.15s;
  }
  .score-reg.is-in .score-reg-fill {
    transform: scaleX(1);
  }

  .score-cta .btn {
    width: 100%;
  }

  /* foto do entorno: recorte fechado e vertical, colado à base da faixa
     (mobile) — o oposto do painel largo do item 02 */
  .score-foto {
    position: relative;
    overflow: hidden;
    margin-inline: calc(var(--sangria) * -1);
    margin-bottom: calc(var(--padY) * -1);
    aspect-ratio: 4 / 5;
  }
  /* O arquivo é quadrado (960x960) e a faixa é bem mais alta que larga no
     mobile: o recorte mantém o personagem no eixo central. */
  .score-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--marrom-08);
  }

  @media (min-width: 1024px) {
    /* Faixa dividida ao meio: metade esquerda é a fotografia (sangrando
       até a borda da tela), metade direita é o bloco preto com as infos. */
    .score-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(48px, 5vw, 110px);
      row-gap: 0;
      padding-block: 0;
    }
    .score-num,
    .score-txt,
    .score-reg,
    .score-cta {
      grid-column: 2;
    }
    .score-num {
      padding-top: clamp(72px, 9vw, 150px);
    }
    .score-txt {
      margin-top: clamp(26px, 3vw, 44px);
    }
    .score-reg {
      margin-top: clamp(34px, 4vw, 56px);
    }
    .score-cta {
      margin-top: clamp(30px, 3.4vw, 52px);
      padding-bottom: clamp(72px, 9vw, 150px);
    }
    .score-cta .btn {
      width: auto;
    }
    .score-foto {
      grid-column: 1;
      grid-row: 1 / span 4;
      align-self: stretch;
      height: 100%;
      aspect-ratio: auto;
      margin: 0 0 0 calc(var(--sangria) * -1);
    }
  }

  /* ---------------- reduced motion ----------------
     O GSAP nem inicializa (a media query do matchMedia inclui
     no-preference), então .is-js nunca existe e o fluxo estático vale.
     Aqui só desligamos as transições CSS novas e cravamos a régua cheia. */
  @media (prefers-reduced-motion: reduce) {
    .loc-num,
    .loc-t,
    .loc-d,
    .score-reg-fill {
      transition: none;
    }
    .score-reg-fill {
      transform: scaleX(1);
    }
  }
</style>

<script>
  import { aoAproximar, reduzMovimento } from '../scripts/ilha';

  /* ---------- Animação do Walk Score ----------
     O arquivo só entra na rede quando a dobra se aproxima; a variante de
     640px atende telas estreitas, onde a faixa é bem menor. Com movimento
     reduzido o vídeo não toca: fica no primeiro quadro, como uma imagem. */
  const ws = document.querySelector<HTMLVideoElement>('[data-score-video]');
  if (ws) {
    aoAproximar(
      ws,
      () => {
        const estreita = matchMedia('(max-width: 900px)').matches;
        const fonte = estreita ? ws.dataset.srcMobile : ws.dataset.srcDesktop;
        if (!fonte) return;
        ws.preload = 'auto';
        ws.src = fonte;
        if (reduzMovimento()) {
          ws.addEventListener('loadeddata', () => ws.pause(), { once: true });
          return;
        }
        ws.autoplay = true;
        /* `play()` pode ser rejeitado por política de autoplay; o vídeo é
           mudo, então na prática passa — o catch evita erro no console. */
        ws.play().catch(() => {});
      },
      '700px'
    );
  }

  const raiz = document.querySelector<HTMLElement>('[data-loc-scrolly]');
  if (raiz) {
    const mq = matchMedia('(min-width: 1024px)');
    let carregado = false;

    /* GSAP só é baixado se o viewport for (ou virar) desktop — no mobile a
       dobra é fluxo puro e não paga o peso da lib. */
    const iniciar = async () => {
      if (carregado) return;
      carregado = true;
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      /* gsap.matchMedia cria e DESTRÓI tudo (triggers, estilos inline)
         quando a condição muda — inclusive se o usuário ligar
         prefers-reduced-motion no meio da sessão. */
      const mm = gsap.matchMedia();
      mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
        raiz.classList.add('is-js');

        const fotos = gsap.utils.toArray<HTMLElement>('[data-foto]', raiz);
        const movs = fotos.map((f) => f.querySelector<HTMLElement>('[data-mov]'));
        const itens = gsap.utils.toArray<HTMLElement>('[data-item]', raiz);
        let atual = 0;

        /* as figuras têm data-rv-img (máscara de entrada no mobile); no
           painel empilhado a máscara já cumpriu seu papel — destrava o img
           imediatamente para a troca via GSAP nunca revelar um img clipado */
        fotos.forEach((f) => f.classList.add('is-in'));

        /* estado inicial oculto SÓ via JS (regra de ouro): sem JS as fotos
           seguem no fluxo, visíveis */
        gsap.set(fotos, { autoAlpha: 0, zIndex: 1 });
        gsap.set(fotos[0], { autoAlpha: 1, zIndex: 2 });

        const ativar = (i: number, iItem: number, dir: 1 | -1) => {
          itens.forEach((el, k) => el.classList.toggle('is-ativo', k === iItem));
          if (i === atual) return;
          const idxSai = atual;
          const entra = fotos[i];
          const sai = fotos[idxSai];
          atual = i;
          /* garante que nenhuma foto antiga (ex.: a Arena) permaneça
             visível sob a transição quando o assunto ativo é outro */
          fotos.forEach((f, k) => {
            if (k !== i && k !== idxSai) gsap.set(f, { autoAlpha: 0, zIndex: 1 });
          });

          gsap.killTweensOf([entra, sai, movs[i]].filter(Boolean));
          gsap.set(sai, { zIndex: 1, autoAlpha: 1, clipPath: 'inset(0% 0% 0% 0%)' });
          gsap.set(entra, { zIndex: 2, autoAlpha: 1 });

          /* máscara direcional: descendo, a nova foto varre de baixo para
             cima; subindo, o inverso — funciona nos dois sentidos */
          gsap.fromTo(
            entra,
            { clipPath: dir === 1 ? 'inset(100% 0% 0% 0%)' : 'inset(0% 0% 100% 0%)' },
            {
              clipPath: 'inset(0% 0% 0% 0%)',
              duration: 0.85,
              ease: 'power3.inOut',
              onComplete: () => gsap.set(sai, { autoAlpha: 0 }),
            }
          );
          const mov = movs[i];
          if (mov) {
            gsap.fromTo(
              mov,
              { yPercent: dir * 9, scale: 1.07 },
              { yPercent: 0, scale: 1, duration: 1.1, ease: 'power3.out' }
            );
          }
        };

        /* UM gatilho, na caixa, dividido em fatias — uma por FOTOGRAFIA.
           Antes cada item era o próprio trigger, o que só funcionava porque
           cada um tinha 80svh de altura própria e passava pela tela. Agora
           os itens estão empilhados no palco sticky: todos ocupam o mesmo
           lugar, então usá-los como trigger faria as quatro etapas
           dispararem no mesmo ponto de scroll. O percurso passou a ser a
           caixa, e o progresso dela é que diz em que etapa estamos.
           Universidades comanda duas fotos e por isso vale duas fatias —
           cada fachada fica o mesmo tempo em tela que os demais pontos. */
        const caixa = raiz.querySelector<HTMLElement>('[data-itens-caixa]');

        // fatia (fotografia) → item de texto correspondente
        const itemDaFoto: number[] = [];
        itens.forEach((el, i) => {
          const n = Math.max(1, Number(el.dataset.fotos) || 1);
          for (let k = 0; k < n; k++) itemDaFoto.push(i);
        });
        const totalFotos = itemDaFoto.length;

        /* O texto entra por crossfade e não sobe mais junto com o scroll, então
           o data-rv (que nasce com opacity 0) não pode continuar mandando:
           quem controla a visibilidade agora é .is-ativo. */
        itens.forEach((el) => el.classList.add('is-in'));

        /* Faixa de progresso de cada ITEM dentro do percurso total, em
           fatias. Universidades ocupa duas, então sua faixa é o dobro das
           outras — e o botão 03 leva o dobro do scroll para completar, que é
           exatamente a informação que o guia deve passar. */
        const faixa = itens.map((_, i) => {
          const de = itemDaFoto.indexOf(i);
          const ate = itemDaFoto.lastIndexOf(i) + 1;
          return { de: de / totalFotos, ate: ate / totalFotos };
        });

        const botoes = [...raiz.querySelectorAll<HTMLElement>('[data-guia-bt]')];
        const pintarGuia = (progresso: number) => {
          botoes.forEach((bt, i) => {
            const { de, ate } = faixa[i];
            const p = Math.min(1, Math.max(0, (progresso - de) / (ate - de)));
            bt.style.setProperty('--p', p.toFixed(3));
            // estado para leitor de tela: qual ponto está em foco agora
            if (p > 0 && p < 1) bt.setAttribute('aria-current', 'true');
            else bt.removeAttribute('aria-current');
          });
        };

        let ultimaFatia = -1;
        const aplicar = (progresso: number) => {
          pintarGuia(progresso);
          const f = Math.min(totalFotos - 1, Math.max(0, Math.floor(progresso * totalFotos)));
          if (f === ultimaFatia) return;
          const dir: 1 | -1 = f > ultimaFatia ? 1 : -1;
          ultimaFatia = f;
          ativar(f, itemDaFoto[f], dir);
        };

        if (caixa) {
          const gatilho = ScrollTrigger.create({
            trigger: caixa,
            start: 'top top',
            end: 'bottom bottom',
            onUpdate: (self) => aplicar(self.progress),
            // cobre o carregamento já rolado no meio da dobra (refresh, âncora)
            onRefresh: (self) => aplicar(self.progress),
          });

          /* Clique leva ao INÍCIO da faixa do ponto. A posição vem do próprio
             gatilho (start/end em pixels de scroll), então continua correta se
             a altura da caixa mudar — não há número mágico duplicado aqui. */
          botoes.forEach((bt, i) => {
            bt.addEventListener('click', () => {
              const destino = gatilho.start + faixa[i].de * (gatilho.end - gatilho.start);
              window.scrollTo({
                top: destino + 1, // +1px entra na faixa, não fica na fronteira
                behavior: reduzMovimento() ? 'auto' : 'smooth',
              });
            });
          });
        }

        return () => {
          raiz.classList.remove('is-js');
          itens.forEach((el, k) => el.classList.toggle('is-ativo', k === 0));
          atual = 0;
        };
      });
    };

    aoAproximar(raiz, () => {
      if (reduzMovimento()) return;
      if (mq.matches) {
        iniciar();
      } else {
        const aoMudar = (e: MediaQueryListEvent) => {
          if (e.matches) {
            mq.removeEventListener('change', aoMudar);
            iniciar();
          }
        };
        mq.addEventListener('change', aoMudar);
      }
    });
  }
</script>
