---
import { waHref } from '../config';

const href = waHref();
---

<!-- Desktop: botão circular. Mobile: barra fixa inferior (alcance do polegar). -->
<a class="wa" data-wa-float href={href} aria-label="Falar no WhatsApp com a Girassol">
  <svg class="wa-ic" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M3.5 20.5 4.8 16A8.2 8.2 0 1 1 8 19.2l-4.5 1.3Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
    <path
      d="M9.2 8.4c-.2 1.9 1.3 3.9 2.6 4.9 1 .8 2.2 1.2 3 1.3.4 0 .8-.3.9-.7l.2-.7-2-1-.7.8c-.9-.3-2-1.4-2.4-2.4l.8-.7-1-1.9-.7.1c-.4.1-.7.4-.7.8Z"
      fill="currentColor"></path>
  </svg>
  <span class="wa-txt">Falar no WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed;
    z-index: 90;
    background: var(--verde);
    color: var(--bege);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 10px 30px rgba(1, 8, 17, 0.28);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .wa-ic {
    width: 26px;
    height: 26px;
    flex: none;
  }

  /* Ao chegar no formulário o CTA flutuante sai de cena:
     ele levaria ao mesmo destino e no mobile cobriria os campos. */
  .wa.is-off {
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 130%, 0);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      visibility 0s linear 0.45s;
  }

  /* Desktop */
  @media (min-width: 761px) {
    .wa {
      right: 24px;
      bottom: 24px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
    }
    .wa-txt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .wa:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow: 0 16px 38px rgba(1, 8, 17, 0.34);
    }
  }

  /* Mobile: mesmo botão redondo do desktop, no canto inferior direito.
     Era uma barra de largura inteira colada no pé — presente demais, comia
     a base de toda seção e competia com o conteúdo. O rótulo vira só o
     aria-label; o ícone já é reconhecível sozinho. 56px mantém o alvo de
     toque confortável mesmo sendo menor que os 60px do desktop. */
  @media (max-width: 760px) {
    .wa {
      left: auto;
      right: 14px;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      width: 56px;
      height: 56px;
      min-height: 0;
      border-radius: 50%;
    }
    .wa-txt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .wa-ic {
      width: 26px;
      height: 26px;
    }
    .wa:active {
      transform: scale(0.94);
    }
  }
</style>
