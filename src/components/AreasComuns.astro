---
import { Picture } from 'astro:assets';
import SwipeAreas from './SwipeAreas.astro';
import fachadaBaixo from '../assets/images/fachada-baixo.jpg';
import terraco03 from '../assets/images/comum-terraco-03.jpg';
import lavanderia02 from '../assets/images/comum-lavanderia-02.jpg';
---

<section class="section theme-bege acs" id="areas-comuns" aria-labelledby="ac-t">
  <!-- ======================= INTRO · fachada à ESQUERDA =======================
       Introdução cinematográfica do slider: recorte vertical alto da fachada
       (letreiro "windycity" preservado — foco center 68%) sangrando pela
       esquerda, coluna de texto à direita amarrada por alinhamentos: o topo do
       texto alinha com o topo da foto e o índice 01–04 fecha rente à base
       dela — sem vão morto. No mobile empilha com a imagem primeiro. -->
  <div class="wrap">
    <div class="acs-intro">
      <figure class="acs-intro-fig bleed-l" data-rv-img="esq" data-px="36">
        <Picture
          src={fachadaBaixo}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1400, 1920]}
          sizes="(max-width: 860px) 100vw, 46vw"
          alt="Fachada do WindyCity vista de baixo, com o letreiro da marca em destaque na entrada"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="acs-intro-txt">
        <div class="acs-intro-topo">
          <p class="eyebrow" data-rv>Espaços que completam a experiência</p>
          <h2 class="h2-xl acs-h2" id="ac-t" data-rv style="--d:80ms">
            <em class="ac">Tudo</em> o que o seu dia a dia pede, sem sair do prédio.
          </h2>
          <p class="body acs-body" data-rv style="--d:160ms">
            Áreas comuns pensadas para ampliar a rotina, a convivência e a praticidade de moradores
            e hóspedes — muito além da unidade.
          </p>
        </div>

        <!-- Índice das quatro áreas: mesmo conteúdo aprovado dos painéis,
             reagrupado como sumário do slider que vem a seguir. -->
        <ol class="acs-indice" data-rv style="--d:240ms">
          <li><span class="acs-ix">01</span><span class="acs-item">Rooftop</span></li>
          <li><span class="acs-ix">02</span><span class="acs-item">Lavanderia</span></li>
          <li><span class="acs-ix">03</span><span class="acs-item">Bicicletário</span></li>
          <li><span class="acs-ix">04</span><span class="acs-item">Sala de reunião</span></li>
        </ol>
      </div>
    </div>
  </div>

  <!-- ================= SWIPE SLIDER · 4 painéis de 100svh ================= -->
  <SwipeAreas />

  <!-- ============== DETALHES · dupla editorial assimétrica ==============
       Vistas complementares dos ambientes 01 e 02 (nenhuma foto repetida dos
       painéis): a bancada do rooftop grande sangrando pela direita, a
       lavanderia menor deslocada pra baixo à esquerda, parallax em forças
       distintas pra elas se descolarem no scroll. -->
  <div class="wrap">
    <div class="acs-dupla">
      <figure class="acs-dupla-a bleed-r" data-px="44" data-rv-img="dir">
        <div class="acs-media acs-media--terr">
          <Picture
            src={terraco03}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[560, 900, 1250, 1700]}
            sizes="(max-width: 860px) 100vw, 62vw"
            alt="Bancada gourmet de madeira do rooftop, com churrasqueira embutida e nicho de lenha ao lado"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="acs-cap">
          <span class="acs-ix">01</span>
          <span class="acs-item">Rooftop</span>
        </figcaption>
      </figure>

      <figure class="acs-dupla-b" data-px="92" data-rv-img="cima" style="--d:120ms">
        <div class="acs-media acs-media--lav">
          <Picture
            src={lavanderia02}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 100vw, 30vw"
            alt="Lavanderia coletiva do WindyCity em ângulo aberto, com bancada de pedra, prateleiras e plantas"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="acs-cap">
          <span class="acs-ix">02</span>
          <span class="acs-item">Lavanderia</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /*
    Prefixo da seção é "acs" (Áreas ComunS), de propósito diferente de "ac" —
    ".ac" já é a classe global de acento em Times Italic (ver global.css).
    Como font-family/font-style são herdados, usar ".ac-" como prefixo de
    layout já fez a seção inteira herdar Times itálica no passado. NADA nesta
    folha começa com ".ac-".
  */
  .acs {
    padding-bottom: clamp(70px, 9vw, 130px);
  }

  /* ------------------------- Intro invertida ------------------------- */
  .acs-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 4.5vw, 84px);
    align-items: stretch;
    margin-bottom: clamp(64px, 9vw, 140px);
  }
  .acs-intro-fig {
    margin: 0;
    overflow: hidden;
    height: clamp(560px, 88svh, 880px);
  }
  .acs-intro-fig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* letreiro "windycity" na metade inferior — nunca decapitar */
    object-position: center 68%;
    display: block;
  }
  /* Texto distribuído na MESMA altura da foto: topo com o topo, índice
     fechando rente à base — é o amarre da composição. */
  .acs-intro-txt {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(44px, 7vh, 96px);
    padding-block: clamp(6px, 1.2vh, 18px);
  }
  .acs-h2 {
    margin-block: 0 22px;
    max-width: clamp(560px, 40vw, 680px);
  }
  .acs-body {
    max-width: 50ch;
  }

  /* Índice 01–04: sumário do slider */
  .acs-indice {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .acs-indice li {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-block: clamp(12px, 1.6vh, 18px);
    border-top: 1px solid var(--rule);
  }
  .acs-indice li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  /* Número serifado + nome em caixa alta (par usado no índice e nas legendas) */
  .acs-ix {
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--verde);
    min-width: 2ch;
  }
  .acs-item {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* --------------------- Peça de mídia da dupla --------------------- */
  .acs-media {
    overflow: hidden;
    height: 100%;
  }
  .acs-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .acs-cap {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 16px;
  }

  /* ------------------ Dupla editorial assimétrica ------------------ */
  .acs-dupla {
    display: grid;
    grid-template-columns: minmax(0, 0.36fr) minmax(0, 0.64fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
    padding-top: clamp(64px, 9vw, 150px);
  }
  .acs-dupla-a {
    margin: 0;
    grid-column: 2;
    grid-row: 1;
  }
  .acs-dupla-b {
    margin: 0;
    grid-column: 1;
    grid-row: 1;
    /* chega bem mais baixa: quebra a leitura de grade */
    margin-top: clamp(90px, 16vw, 260px);
  }
  .acs-media--terr {
    height: clamp(320px, 62vh, 680px);
  }
  .acs-media--lav {
    height: clamp(240px, 40vh, 460px);
  }

  /* ------------------------------ Mobile ------------------------------
     Empilhado, imagem da fachada primeiro (ordem do DOM já é essa) e em
     sangria total; dupla vira coluna alternando o lado da sangria. O
     parallax global já desliga sozinho abaixo de 761px. */
  @media (max-width: 860px) {
    .acs-intro {
      display: block;
      margin-bottom: clamp(48px, 10vw, 80px);
    }
    .acs-intro-fig {
      /* .bleed-l já puxa a esquerda; aqui sangra também a direita */
      margin-right: calc(var(--sangria) * -1);
      height: clamp(400px, 112vw, 600px);
    }
    .acs-intro-txt {
      display: block;
      margin-top: clamp(28px, 7vw, 44px);
    }
    .acs-h2 {
      max-width: none;
      margin-bottom: 18px;
    }
    .acs-indice {
      margin-top: clamp(28px, 7vw, 40px);
    }

    .acs-dupla {
      display: block;
      padding-top: clamp(48px, 10vw, 72px);
    }
    .acs-dupla-b {
      margin-top: 26px;
      /* alterna o lado: a grande sangra à direita (bleed-r), esta à esquerda */
      margin-left: calc(var(--sangria) * -1);
    }
    .acs-media--terr {
      height: clamp(240px, 60vw, 380px);
    }
    .acs-media--lav {
      height: clamp(240px, 66vw, 400px);
    }
    .acs-cap {
      padding-right: var(--gutter);
    }
  }
</style>
