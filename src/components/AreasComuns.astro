---
import { Picture } from 'astro:assets';
import rooftop from '../assets/images/comum-rooftop.png';
import lavanderia from '../assets/images/comum-lavanderia.png';
import bicicletario from '../assets/images/comum-bicicletario.png';
import salaReuniao from '../assets/images/comum-sala-reuniao.png';
import predioCutout from '../assets/images/fachada-07-alpha-logo.png';
---

<section class="section theme-bege acs" id="areas-comuns" aria-labelledby="ac-t">
  <!-- Bloco de abertura: texto à esquerda / foto à direita, sobre o bege
       da própria seção (sem tema escuro — herda o fundo do <section> pai). -->
  <div class="acs-duo bleed">
    <div class="wrap acs-duo-in">
      <div class="acs-duo-txt">
        <p class="eyebrow" data-rv>Espaços que completam a experiência</p>
        <h2 class="h2-xl acs-duo-h2" id="ac-t" data-rv style="--d:80ms">
          <em class="ac">Tudo</em> o que o<br class="brk" />
          seu dia a dia<br class="brk" />
          pede, sem sair<br class="brk" />
          do prédio.
        </h2>
        <p class="body ac-body" data-rv style="--d:160ms">
          Áreas comuns pensadas para ampliar a rotina, a convivência e a praticidade de moradores e
          hóspedes — muito além da unidade.
        </p>
      </div>
    </div>

    <div class="acs-duo-fig" data-rv-img style="--d:160ms">
      <Picture
        src={predioCutout}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 860px) 92vw, 48vw"
        alt="Fachada do WindyCity em recorte, com o logotipo aplicado na parede de entrada"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <!-- Abertura em sangria total -->
  <figure class="bleed ac-open" data-px="70" data-rv-img>
    <Picture
      src={rooftop}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[760, 1100, 1500, 1920]}
      sizes="100vw"
      alt="Rooftop do WindyCity com espaço gourmet, lareira central sobre deck de madeira e vista para a cidade"
      loading="lazy"
      decoding="async"
    />
    <figcaption class="ac-cap ac-cap--over">
      <span class="ac-ix">01</span>
      <span class="ac-nome">Rooftop</span>
    </figcaption>
  </figure>

  <div class="wrap">
    <!-- Grade desalinhada: escalas e alturas diferentes, sem moldura -->
    <div class="ac-grid">
      <figure class="ac-it ac-it--a" data-px="46" data-rv-img>
        <div class="ac-media">
          <Picture
            src={lavanderia}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[520, 780, 1100]}
            sizes="(max-width: 860px) 100vw, 52vw"
            alt="Lavanderia coletiva do WindyCity com máquinas, bancada e painel ripado de madeira"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="ac-cap">
          <span class="ac-ix">02</span>
          <span class="ac-nome">Lavanderia</span>
        </figcaption>
      </figure>

      <figure class="ac-it ac-it--b" data-px="72" data-rv-img style="--d:110ms">
        <div class="ac-media">
          <Picture
            src={bicicletario}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[420, 640, 900]}
            sizes="(max-width: 860px) 100vw, 40vw"
            alt="Bicicletário do WindyCity com bicicletas em suportes de parede sob cobertura"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="ac-cap">
          <span class="ac-ix">03</span>
          <span class="ac-nome">Bicicletário</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- Fecho sangrando pela direita -->
  <div class="wrap">
    <figure class="ac-close bleed-r" data-px="55" data-rv-img>
      <div class="ac-media">
        <Picture
          src={salaReuniao}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[760, 1100, 1500]}
          sizes="(max-width: 860px) 100vw, 78vw"
          alt="Sala de reunião do WindyCity com mesa de madeira, televisão e painel ripado com plantas"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="ac-cap">
        <span class="ac-ix">04</span>
        <span class="ac-nome">Sala de reunião</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  /*
    Prefixo da seção é "acs" (Áreas ComunS), de propósito diferente de "ac" —
    ".ac" já é a classe global de acento em Times Italic (ver global.css).
    Usar ".ac" aqui SERIA um bug: como font-family/font-style são herdados,
    a seção inteira herdaria Times Italic por baixo do capô. Foi exatamente
    o que aconteceu antes de virar ".acs".
  */
  .acs {
    padding-bottom: clamp(70px, 9vw, 130px);
  }

  /* ---------- Bloco duplo: texto preto + foto dissolvendo ---------- */
  .acs-duo {
    position: relative;
    overflow: hidden;
    height: clamp(560px, 80vh, 900px);
    display: flex;
    align-items: center;
    margin-bottom: clamp(64px, 9vw, 120px);
    /* Sem tema próprio — herda o bege do <section> pai (nada de fundo preto). */
  }
  .acs-duo-in {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  .acs-duo-txt {
    /* piso de 590px calculado pra caber exatamente as 4 linhas manuais
       do título abaixo, sem quebra extra por falta de espaço */
    max-width: clamp(590px, 42vw, 640px);
  }
  .acs-duo-h2 {
    margin-block: 18px 22px;
  }
  /* Quebra manual em 4 linhas — mesma escala de fonte, só mais estreita.
     text-wrap:balance (herdado de .h2-xl) reagia pouco a ajustes de
     max-width porque já escolhe o menor nº de linhas que cabe; com quebra
     manual o controle é exato. Só vale no desktop — no mobile o texto
     flui livre na largura cheia. */
  .acs-duo-h2 .brk {
    display: none;
  }
  @media (min-width: 861px) {
    .acs-duo-h2 .brk {
      display: block;
    }
  }

  /* A foto ocupa a metade direita, base encostada no rodapé da seção.
     O degradê de máscara dissolve a borda esquerda dela no bege do fundo —
     em vez de um corte reto entre bloco de texto e bloco de imagem. */
  .acs-duo-fig {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    height: 100%;
    width: min(58vw, 860px);
    mask-image: linear-gradient(to right, transparent 0%, black 26%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 26%);
  }
  .acs-duo-fig :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
    display: block;
  }

  .ac-body {
    max-width: 50ch;
  }

  .ac-open {
    height: clamp(360px, 84vh, 860px);
    overflow: hidden;
    position: relative;
  }
  .ac-open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ac-media {
    overflow: hidden;
    height: 100%;
  }
  .ac-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Legenda editorial: índice + nome, fora da imagem */
  .ac-cap {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 16px;
  }
  .ac-ix {
    font-family: 'TimesWC', 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--verde);
  }
  .ac-nome {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .ac-cap--over {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(20px, 3vw, 40px);
    padding-top: 0;
    color: var(--bege);
    text-shadow: 0 1px 18px rgba(1, 8, 17, 0.55);
  }
  .ac-cap--over .ac-ix {
    color: var(--bege);
  }

  /* Duas peças em escalas e alturas diferentes */
  .ac-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.84fr);
    gap: clamp(16px, 3vw, 56px);
    align-items: start;
    padding-top: clamp(48px, 7vw, 110px);
  }
  .ac-it--a .ac-media {
    height: clamp(280px, 52vh, 540px);
  }
  /* Desalinhamento vertical — tira a leitura de "duas caixas lado a lado" */
  .ac-it--b {
    margin-top: clamp(40px, 9vw, 150px);
  }
  .ac-it--b .ac-media {
    height: clamp(300px, 58vh, 620px);
  }

  .ac-close {
    padding-top: clamp(48px, 7vw, 110px);
  }
  .ac-close .ac-media {
    height: clamp(320px, 66vh, 680px);
  }

  @media (max-width: 860px) {
    /* Empilha: texto em cima, foto embaixo em largura total. O degradê
       muda de eixo (esquerda→direita vira cima→baixo) pra continuar
       dissolvendo na direção certa da nova composição. */
    .acs-duo {
      height: auto;
      flex-direction: column;
      align-items: stretch;
      padding-block: clamp(48px, 10vw, 76px) 0;
      margin-bottom: clamp(48px, 7vw, 80px);
    }
    .acs-duo-txt {
      max-width: none;
    }
    .acs-duo-h2 {
      max-width: none;
    }
    .acs-duo-fig {
      position: relative;
      inset: auto;
      width: 100%;
      height: clamp(300px, 78vw, 460px);
      margin-top: clamp(28px, 6vw, 44px);
      mask-image: linear-gradient(to top, transparent 0%, black 20%);
      -webkit-mask-image: linear-gradient(to top, transparent 0%, black 20%);
    }
    .acs-duo-fig :global(img) {
      object-position: bottom center;
    }

    .ac-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .ac-it--b {
      margin-top: 0;
    }
    .ac-it--a .ac-media,
    .ac-it--b .ac-media,
    .ac-close .ac-media {
      height: clamp(260px, 52vh, 420px);
    }
    .ac-close {
      margin-right: calc(50% - 50vw);
    }
  }
</style>
