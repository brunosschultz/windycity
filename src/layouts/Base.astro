---
import { SITE, CONTATO, EMPREENDIMENTO } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL('/og-windycity.jpg', Astro.site ?? SITE.url).href;

/* ---------------------------------------------------------------------------
   Dados estruturados (SEO + GEO).
   Apenas fatos presentes no wireframe aprovado e no material da marca.
   Telefone, CNPJ e endereço entraram quando o cliente confirmou os valores.
   Preço segue fora: continua sendo faixa, não valor de oferta — schema com
   dado falso é pior que schema ausente.
--------------------------------------------------------------------------- */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organizacao`,
      name: SITE.incorporadora,
      url: SITE.url,
      slogan: 'Voltados para o sol',
      sameAs: [CONTATO.instagramUrl],
      areaServed: { '@type': 'City', name: SITE.cidade },
      ...(CONTATO.whatsapp ? { telephone: `+${CONTATO.whatsapp}` } : {}),
      taxID: CONTATO.cnpj,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#site`,
      url: SITE.url,
      name: SITE.title,
      inLanguage: 'pt-BR',
      publisher: { '@id': `${SITE.url}/#organizacao` },
    },
    {
      '@type': 'ApartmentComplex',
      '@id': `${SITE.url}/#empreendimento`,
      name: SITE.nome,
      url: SITE.url,
      description: SITE.description,
      image: ogImage,
      numberOfAccommodationUnits: EMPREENDIMENTO.unidades,
      address: {
        '@type': 'PostalAddress',
        streetAddress: CONTATO.endereco,
        addressLocality: SITE.cidade,
        addressRegion: SITE.estado,
        addressCountry: 'BR',
      },
      developer: { '@id': `${SITE.url}/#organizacao` },
      amenityFeature: [
        'Rooftop com espaço gourmet',
        'Lavanderia',
        'Coworking',
        'Bicicletário',
      ].map((n) => ({ '@type': 'LocationFeatureSpecification', name: n, value: true })),
      accommodationCategory: ['Studio', 'Garden'],
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Fontes críticas: preload evita FOIT no LCP (headline do hero) -->
    <link rel="preload" href="/fonts/Sora-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Sora-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Times-Italic.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#010811" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Render da fachada do WindyCity, empreendimento de Studios em Curitiba"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={SITE.incorporadora} />
    <meta name="geo.region" content="BR-PR" />
    <meta name="geo.placename" content={SITE.cidade} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />


    <script>
      /* --------------------------------------------------------------
         Runtime completo da página. Sem dependências, ~1.4KB.
         Tudo com transform/opacity para não sair do compositor.
      -------------------------------------------------------------- */
      import { criarRaspador, raspadores } from '../scripts/ilha';

      const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* 1 · Revelação ao entrar na viewport */

      /* Títulos por palavra. O corte acontece SÓ aqui, em JS: sem JS (ou se
         este script falhar) o h2 fica inteiro e visível — nada escondido por
         CSS estático. Percorre os nós de texto em vez de trocar textContent,
         senão o <em class="ac"> do acento seria destruído.
         Custo: 6 títulos, feito uma vez, antes do observer. */
      const partirPalavras = (el: HTMLElement) => {
        const passeio = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
        const nos: Text[] = [];
        for (let n = passeio.nextNode(); n; n = passeio.nextNode()) nos.push(n as Text);
        let i = 0;
        for (const no of nos) {
          const frag = document.createDocumentFragment();
          for (const parte of (no.textContent ?? '').split(/(\s+)/)) {
            if (!parte) continue;
            if (/^\s+$/.test(parte)) {
              frag.append(' ');
              continue;
            }
            const fora = document.createElement('span');
            fora.className = 'pal';
            const dentro = document.createElement('span');
            dentro.textContent = parte;
            dentro.style.transitionDelay = `${i++ * 42}ms`;
            fora.append(dentro);
            frag.append(fora);
          }
          no.replaceWith(frag);
        }
        el.classList.add('is-pal');
      };
      if (!reduz) {
        document
          .querySelectorAll<HTMLElement>('[data-rv-pal]')
          .forEach((el) => partirPalavras(el));
      }

      const alvos = document.querySelectorAll<HTMLElement>(
        '[data-rv], [data-rv-img], [data-rv-line], [data-rv-esc], [data-rv-pal]'
      );
      if (reduz) {
        alvos.forEach((el) => el.classList.add('is-in'));
      } else {
        /* Uma imagem só é revelada depois de estar decodificada. Sem isso a
           máscara abre sobre um espaço vazio e a foto "pipoca" depois — era
           essa a sensação de travamento. Ao entrar no raio, o download também
           é forçado (loading=eager) para não depender do gatilho do navegador. */
        const revelar = (el: HTMLElement) => {
          const img = el.querySelector('img');
          if (!img) {
            el.classList.add('is-in');
            return;
          }
          if (img.complete && img.naturalWidth > 0) {
            el.classList.add('is-in');
            return;
          }
          img.loading = 'eager';
          const pronto = () => el.classList.add('is-in');
          img.addEventListener('load', pronto, { once: true });
          img.addEventListener('error', pronto, { once: true });
        };

        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              revelar(e.target as HTMLElement);
            }
          },
          /* margem POSITIVA: dispara antes de entrar na tela, dando tempo de
             carregar. threshold baixo porque imagens de sangria são altas. */
          { rootMargin: '0px 0px 35% 0px', threshold: 0.01 }
        );
        alvos.forEach((el) => io.observe(el));
      }

      /* 1c · Leitura no próprio aparelho: ?debug=video mostra, para CADA cena
         que raspa, a mediana de seek e o modo atual. Bug que só aparece no
         celular se resolve com medida, não com chute. */
      if (new URLSearchParams(location.search).get('debug') === 'video') {
        const painel = document.createElement('div');
        painel.setAttribute(
          'style',
          'position:fixed;left:8px;bottom:8px;z-index:9999;background:#000d;' +
            'color:#0f0;font:11px/1.5 monospace;padding:6px 8px;border-radius:4px;' +
            'max-width:calc(100vw - 16px)'
        );
        document.body.append(painel);
        setInterval(() => {
          painel.textContent = raspadores.length
            ? `dpr ${devicePixelRatio} · ` +
              raspadores
                .map(
                  (r) =>
                    `${r.nome} ${r.video.videoWidth}x${r.video.videoHeight} ` +
                    `${r.ampliacao().toFixed(1)}x · seek ${r.mediana().toFixed(0)}ms (${r.amostras()})`
                )
                .join(' | ')
            : 'nenhuma cena de vídeo iniciada ainda';
        }, 400);
      }

      /* 2 · Header: some ao descer, volta ao subir, ganha fundo após o hero */
      const header = document.querySelector<HTMLElement>('[data-header]');
      if (header) {
        let ultimo = window.scrollY;
        let travado = false;
        const aoRolar = () => {
          const y = window.scrollY;
          header.classList.toggle('is-solid', y > 80);
          if (Math.abs(y - ultimo) > 6) {
            header.classList.toggle('is-hidden', y > ultimo && y > 340);
            ultimo = y;
          }
          travado = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (travado) return;
            travado = true;
            requestAnimationFrame(aoRolar);
          },
          { passive: true }
        );
      }

      /* 3 · Contagem dos números-chave (só uma vez, ao aparecer) */
      const contadores = document.querySelectorAll<HTMLElement>('[data-count]');
      if (contadores.length) {
        const ioNum = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              ioNum.unobserve(el);
              const alvo = Number(el.dataset.count || '0');
              if (reduz) {
                el.textContent = String(alvo);
                continue;
              }
              const dur = 1100;
              const t0 = performance.now();
              const passo = (agora: number) => {
                const p = Math.min((agora - t0) / dur, 1);
                // easeOutExpo
                const eased = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
                el.textContent = String(Math.round(alvo * eased));
                if (p < 1) requestAnimationFrame(passo);
              };
              requestAnimationFrame(passo);
            }
          },
          { threshold: 0.5 }
        );
        contadores.forEach((el) => ioNum.observe(el));
      }

      /* 3 · Palco de abertura: progresso do scroll vira --p (0→1).
         Só custom property → clip-path / opacity / transform. Sem layout.
         O vídeo do hero (sem autoplay) tem o currentTime "puxado" pelo mesmo
         progresso — é o scrubbing: o scroll troca de página vira o vídeo. */
      const palco = document.querySelector<HTMLElement>('[data-stage]');
      const pino = document.querySelector<HTMLElement>('[data-pin]');
      const video = document.querySelector<HTMLVideoElement>('[data-stage-video]');
      /* Sem animação de palco (movimento reduzido), o header precisa nascer
         visível — senão ficaria oculto para sempre, já que --hp começa em 1. */
      if (reduz) document.documentElement.style.setProperty('--hp', '0');
      if (palco && pino && !reduz) {
        let duracao = 0;
        const lerDuracao = () => {
          if (video && isFinite(video.duration) && video.duration > 0) {
            duracao = video.duration;
            medir();
          }
        };
        video?.addEventListener('loadedmetadata', lerDuracao);

        /* No mobile (Safari/iOS em especial), um vídeo que nunca entrou em
           "playing" não repinta a tela quando o currentTime é alterado por
           script — o primeiro frame aparece (poster) e depois some ao rolar,
           porque nenhum frame novo é decodificado. Dar play/pause uma vez
           (mudo, então permitido sem gesto do usuário) "liga" o decodificador
           e destrava o scrubbing programático. */
        let ligado = false;
        const ligarVideo = () => {
          if (ligado || !video) return;
          ligado = true;
          const p = video.play();
          if (p && typeof p.then === 'function') {
            p.then(() => video.pause()).catch(() => {
              ligado = false;
            });
          } else {
            video.pause();
          }
        };
        video?.addEventListener('loadedmetadata', ligarVideo);
        if (video && video.readyState >= 1) ligarVideo();

        /* A hero raspa serializada, igual à cena de proximidades — este
           driver tinha o mesmo defeito escrito à parte, e por isso ficou de
           fora da correção anterior.
           SEM `aoDegradar`: aqui a raspagem É a composição de abertura (o
           vídeo anda junto com a saída do título), então trocar por
           reprodução automática mudaria o desenho da hero. Se a medição
           mostrar que o aparelho não dá conta, isso vira decisão a tomar,
           não efeito colateral. */
        const raspador = video ? criarRaspador(video, 'hero') : null;

        /* Recorta um trecho de --p e devolve 0→1 dentro dele, com suavização
           (smoothstep) — é o que dá a sensação de "sair/entrar fluido" em vez
           de linear e mecânico. */
        const faixa = (v: number, a: number, b: number) => {
          const t = Math.min(Math.max((v - a) / (b - a), 0), 1);
          return t * t * (3 - 2 * t);
        };

        const raiz = document.documentElement;
        let pedido = false;
        const medir = () => {
          const curso = palco.offsetHeight - window.innerHeight;
          const andado = -palco.getBoundingClientRect().top;
          const p = curso > 0 ? Math.min(Math.max(andado / curso, 0), 1) : 0;

          palco.style.setProperty('--p', p.toFixed(4));
          // saída do título e do degradê lateral
          palco.style.setProperty('--po', faixa(p, 0, 0.3).toFixed(4));
          // migração de logo, lede e botão para as posições finais
          palco.style.setProperty('--pm', faixa(p, 0.12, 0.72).toFixed(4));
          /* Entrada de "luz natural": começa em 0.33, logo depois de o H1
             terminar de sair (--po fecha em 0.3), para não ficar um vazio
             no meio do percurso. */
          palco.style.setProperty('--pi', faixa(p, 0.33, 0.66).toFixed(4));
          /* Header fixo: fica OCULTO durante toda a abertura (o Figma não tem
             menu no topo da hero) e só entra ao fim do palco, para a navegação
             ficar disponível nas seções seguintes. */
          const fim = faixa(p, 0.94, 1);
          raiz.style.setProperty('--hp', (1 - fim).toFixed(4));
          raiz.style.setProperty('--hdl', fim.toFixed(4));

          if (video && duracao > 0) {
            // -0.02 evita travar 1 frame antes do fim em navegadores que
            // arredondam currentTime pra cima do duration e ignoram o seek
            const alvo = Math.min(p * duracao, duracao - 0.02);
            /* Zona morta de ~1 quadro (24fps = 0,042s): abaixo disso o seek
               não muda nada na tela e só gasta decodificador. */
            if (Math.abs(video.currentTime - alvo) > 0.04) raspador?.irPara(alvo);
          }
          pedido = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (pedido) return;
            pedido = true;
            requestAnimationFrame(medir);
          },
          { passive: true }
        );
        addEventListener('resize', medir, { passive: true });
        medir();
        /* Com o vídeo em cache, `loadedmetadata` dispara ANTES deste script
           rodar e o listener acima nunca chega a ser chamado — a duração
           ficaria em 0 e o scrubbing nunca aconteceria. Por isso lê também
           de imediato, agora que `medir` já existe. */
        if (video && video.readyState >= 1) lerDuracao();
      }

      /* 3a · Driver único de cena: parallax (--py) + progresso (--prog).
         UM listener de scroll e UM rAF para a página inteira, em vez de cada
         seção trazer o seu. Só escreve custom property; quem anima é o CSS,
         sempre em transform/opacity (compositor).

         [data-px]   → --py em px (parallax). Só desktop: no mobile o ganho
                       visual não paga o custo de scroll.
         [data-prog] → --prog de 0 a 1, para scrollytelling. Duas medidas:
                       padrão  = travessia do elemento pela viewport
                                 (0 ao encostar embaixo, 1 ao sair em cima);
                       ="pin"  = avanço dentro de uma cena alta com filho
                                 sticky (0 no topo da cena, 1 no fim dela).
         Os dois são simétricos: valem igual descendo e subindo o scroll. */
      const temParallax = !reduz && matchMedia('(min-width: 761px)').matches;
      const camadas = [
        ...document.querySelectorAll<HTMLElement>(temParallax ? '[data-px], [data-prog]' : '[data-prog]'),
      ];

      if (camadas.length) {
        if (reduz) {
          /* Sem movimento: entrega o estado final para o conteúdo aparecer
             inteiro, sem depender de scroll. */
          camadas.forEach((el) => {
            el.style.setProperty('--prog', '1');
            el.style.setProperty('--py', '0px');
          });
        } else {
          let visiveis: HTMLElement[] = [];
          const ioCena = new IntersectionObserver(
            (es) => {
              for (const e of es) {
                const el = e.target as HTMLElement;
                if (e.isIntersecting) {
                  if (!visiveis.includes(el)) visiveis.push(el);
                } else {
                  visiveis = visiveis.filter((v) => v !== el);
                }
              }
              if (visiveis.length) agendar();
            },
            { rootMargin: '15% 0px' }
          );
          camadas.forEach((el) => ioCena.observe(el));

          const trava = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
          let pendente = false;

          const desenhar = () => {
            const vh = window.innerHeight;
            for (const el of visiveis) {
              const r = el.getBoundingClientRect();

              if (el.dataset.px !== undefined && temParallax) {
                // -1 (abaixo da tela) → 1 (acima da tela)
                const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
                const forca = Number(el.dataset.px) || 60;
                el.style.setProperty('--py', `${(p * forca).toFixed(1)}px`);
              }

              if (el.dataset.prog !== undefined) {
                const curso =
                  el.dataset.prog === 'pin'
                    ? trava(-r.top / Math.max(r.height - vh, 1))
                    : trava((vh - r.top) / (vh + r.height));
                el.style.setProperty('--prog', curso.toFixed(4));
              }
            }
            pendente = false;
          };

          function agendar() {
            if (pendente) return;
            pendente = true;
            requestAnimationFrame(desenhar);
          }

          addEventListener('scroll', agendar, { passive: true });
          addEventListener('resize', agendar, { passive: true });
          desenhar();
        }
      }

      /* 3b · CTA flutuante recolhe na hero (já tem botão próprio na primeira
         dobra) e também ao chegar no formulário — volta normalmente entre
         as duas. */
      const flutuante = document.querySelector<HTMLElement>('[data-wa-float]');
      const secContato = document.querySelector('#contato');
      const secHero = document.querySelector('#hero');
      if (flutuante && (secContato || secHero)) {
        const escondendo = new Set<Element>();
        const ioCta = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (e.isIntersecting) escondendo.add(e.target);
              else escondendo.delete(e.target);
            }
            flutuante.classList.toggle('is-off', escondendo.size > 0);
          },
          { threshold: 0.18 }
        );
        if (secContato) ioCta.observe(secContato);
        if (secHero) ioCta.observe(secHero);
      }

      /* 4 · Formulário → handoff para WhatsApp (ou aviso enquanto não há número) */
      const form = document.querySelector<HTMLFormElement>('[data-lead]');
      form?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const dados = new FormData(form);
        const nome = String(dados.get('nome') || '').trim();
        const tel = String(dados.get('whatsapp') || '').trim();
        const tipo = String(dados.get('tipologia') || '');
        const base = form.dataset.wa; // vazio enquanto o número não for confirmado
        const aviso = form.querySelector<HTMLElement>('[data-form-msg]');

        if (!nome || !tel) {
          if (aviso) aviso.textContent = 'Preencha nome e WhatsApp para continuar.';
          return;
        }
        if (!base) {
          if (aviso) {
            aviso.textContent =
              'Formulário pronto — falta apenas o número de WhatsApp da Girassol para ativar o envio.';
          }
          return;
        }
        const msg = `Olá! Sou ${nome} (${tel}) e tenho interesse em ${tipo} no WindyCity.`;
        window.open(`${base}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
      });

      /* 5 · Máscara simples de telefone brasileiro */
      const tel = document.querySelector<HTMLInputElement>('[data-tel]');
      tel?.addEventListener('input', () => {
        const d = tel.value.replace(/\D/g, '').slice(0, 11);
        tel.value =
          d.length <= 2
            ? d
            : d.length <= 6
              ? `(${d.slice(0, 2)}) ${d.slice(2)}`
              : d.length <= 10
                ? `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`
                : `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
      });
    </script>
  </body>
</html>
